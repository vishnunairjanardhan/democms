---
import BaseHead1 from "../components/BaseHead1.astro";
import Navigation from "../components/global/Navigation.astro";
import FooterAdd from "../components/global/FooterAdd.astro";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth selection:bg-indigo-500 selection:text-white">
  <head>
    <BaseHead1 />
  </head>

  <body class="bg-white">
    <!-- ===============================
      Google Tag Manager (PAGEVIEW)
    =============================== -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      window.addEventListener("load", () => {
        window.dataLayer.push({
          event: "pageview",
          page_path: window.location.pathname,
        });
      });
    </script>

    <!-- ===============================
      Google Tag Manager (noscript)
      MUST be immediately after <body>
    =============================== -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WWJJGX6"
        height="0"
        width="0"
        style="display:none;visibility:hidden">
      </iframe>
    </noscript>

    <!-- ===============================
      App Layout
    =============================== -->
    <Navigation />
    <slot />
    <FooterAdd />

    <!-- ===============================
      Background Snow Effect (DEFERRED)
    =============================== -->
    <div
      id="tsparticles"
      style="position: fixed; inset: 0; z-index: -1;">
    </div>

    <script type="module">
      import { tsParticles } from "tsparticles-engine";
      import { loadSnowPreset } from "tsparticles-preset-snow";

      window.addEventListener("load", async () => {
        await loadSnowPreset(tsParticles);
        tsParticles.load("tsparticles", {
          preset: "snow",
          fullScreen: { zIndex: -1 },
        });
      });
    </script>

    <!-- ===============================
      Intercom (LOAD AFTER PAGE)
    =============================== -->
    <script is:inline>
      window.intercomSettings = { app_id: "usxp4hif" };

      window.addEventListener("load", function () {
        (function () {
          var w = window;
          var ic = w.Intercom;
          if (typeof ic === "function") {
            ic("reattach_activator");
            ic("update", intercomSettings);
          } else {
            var d = document;
            var i = function () {
              i.c(arguments);
            };
            i.q = [];
            i.c = function (args) {
              i.q.push(args);
            };
            w.Intercom = i;
            var s = d.createElement("script");
            s.type = "text/javascript";
            s.async = true;
            s.src = "https://widget.intercom.io/widget/usxp4hif";
            d.body.appendChild(s);
          }
        })();
      });
    </script>

    <!-- ===============================
      Vanilla Tilt
    =============================== -->
    <script
      defer
      src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"
      crossorigin="anonymous"
      referrerpolicy="no-referrer">
    </script>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (window.VanillaTilt) {
          VanillaTilt.init(document.querySelectorAll(".tilt-card"), {
            max: 35,
            speed: 2500,
            transition: true,
          });
        }
      });
    </script>
  </body>
</html>
