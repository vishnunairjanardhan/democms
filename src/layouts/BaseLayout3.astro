
---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import ContactWidget from "../components/forms/ContactWidget.astro";
import FooterAdd from "../components/global/FooterAdd.astro";
import HeroSection from "../components/shadcn-studio/blocks/hero-section-38/hero-section-38.tsx";
---

<html lang="en" class="scroll-smooth selection:bg-indigo-500 selection:text-white">
  <head>
    <BaseHead />
  </head>
  <body class="bg-white">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WWJJGX6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <Navigation />
    <!-- <ContactWidget /> -->
    <slot />
    <FooterAdd />

    <!-- Intercom Widget-->
    <script>
        window.intercomSettings = {
          app_id: "usxp4hif"
        };

        let intercomLoaded = false;

        function loadIntercom() {
          if (intercomLoaded) return;
          intercomLoaded = true;

          (function(){
            var w=window;var ic=w.Intercom;
            if(typeof ic==="function"){
              ic('reattach_activator');
              ic('update',window.intercomSettings);
            } else {
              var d=document;var i=function(){i.c(arguments)};
              i.q=[];i.c=function(args){i.q.push(args)};
              w.Intercom=i;

              var s=d.createElement('script');
              s.type='text/javascript';
              s.async=true;
              s.src='https://widget.intercom.io/widget/usxp4hif';
              d.body.appendChild(s);
            }
          })();
        }

        // Load after 5 seconds of idle
        setTimeout(loadIntercom, 5000);

        // OR load on first user interaction (scroll / click)
        ["scroll", "mousemove", "touchstart"].forEach(event => {
          window.addEventListener(event, loadIntercom, { once: true, passive: true });
        });
      </script>
  </body>
</html>
