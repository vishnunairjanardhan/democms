
---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import ContactWidget from "../components/forms/ContactWidget.astro";
import FooterAdd from "../components/global/FooterAdd.astro";
import HeroSection from "../components/shadcn-studio/blocks/hero-section-38/hero-section-38.tsx";
---

<html lang="en" class="scroll-smooth selection:bg-indigo-500 selection:text-white">
  <head>
    <BaseHead />
  </head>
  <body class="bg-white">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WWJJGX6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <Navigation />
    <!-- <ContactWidget /> -->
    <slot />
    <FooterAdd />

    <!-- Intercom Widget-->
    <script>
        window.intercomSettings = {
        app_id: "usxp4hif"
      };
    </script>
    <script>
      (function(){var w=window;var ic=w.Intercom;
      if(typeof ic==="function"){ic('reattach_activator');ic('update',intercomSettings);}
      else{var d=document;var i=function(){i.c(arguments)};
      i.q=[];i.c=function(args){i.q.push(args)};
      w.Intercom=i;var l=function(){var s=d.createElement('script');
      s.type='text/javascript';s.async=true;
      s.src='https://widget.intercom.io/widget/usxp4hif';
      var x=d.getElementsByTagName('script')[0];
      x.parentNode.insertBefore(s,x);};
      if(w.attachEvent){w.attachEvent('onload',l);}
      else{w.addEventListener('load',l,false);}}})();
    </script>
  </body>
</html>
