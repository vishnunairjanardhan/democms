---
import BaseLayout3 from "./BaseLayout3.astro";
import { AstroSeo } from "@astrolib/seo";

const { frontmatter } = Astro.props;

const clean = (obj) =>
  JSON.parse(JSON.stringify(obj, (k, v) => (v === null || v === undefined ? undefined : v)));

const blogPostSchema = clean({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": frontmatter.url || "https://www.99minds.io/blog",
  },
  headline: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.image ? `https://www.99minds.io${frontmatter.image.url}` : undefined,
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  publisher: {
    "@type": "Organization",
    name: "99minds",
    logo: {
      "@type": "ImageObject",
      url: "https://www.99minds.io/assets/logo.png",
    },
  },
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  dateModified: new Date(frontmatter.pubDate).toISOString(),
});

const blogPostSchemaString = JSON.stringify(blogPostSchema, null, 2);

// --- Build breadcrumb JSON-LD safely ---
const breadcrumbSchema = clean({
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.99minds.io/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://www.99minds.io/blog/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: frontmatter.title || frontmatter.heading || "",
      item: frontmatter.url || `https://www.99minds.io/blog/${frontmatter.slug || ""}`,
    },
  ],
});

const breadcrumbSchemaString = JSON.stringify(breadcrumbSchema, null, 2);

const articleSchema = clean({
  "@context": "https://schema.org",
  "@type": "Article",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": frontmatter.url || "https://www.99minds.io/",
  },
  headline: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.image ? `https://www.99minds.io${frontmatter.image.url}` : undefined,
  author: {
    "@type": "Person",
    name: frontmatter.author,
    url:
      frontmatter.authorUrl ||
      `https://www.99minds.io/assets/testimonial/${frontmatter.authorImg || ""}`,
  },
  publisher: {
    "@type": "Organization",
    name: "99minds",
    logo: {
      "@type": "ImageObject",
      url: "https://www.99minds.io/logos/99minds-logo-b.svg",
    },
  },
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  dateModified: new Date(frontmatter.pubDate).toISOString(),
});

const articleSchemaString = JSON.stringify(articleSchema, null, 2);
---

<BaseLayout3>
  <Fragment slot="head">
    <!-- JSON-LD -->
    <meta name="keywords" content={frontmatter.keywords} />
    <script type="application/ld+json" set:html={blogPostSchemaString}></script>
    <script type="application/ld+json" set:html={breadcrumbSchemaString}></script>
    <script type="application/ld+json" set:html={articleSchemaString}></script>

    <!-- Astro SEO -->
    <AstroSeo
      title={frontmatter.title || ""}
      description={frontmatter.description || ""}
      canonical={frontmatter?.url || ""}
      openGraph={{
        url: frontmatter?.url || "",
        title: frontmatter.openGraphTitle || frontmatter.title || "",
        description:
          frontmatter.openGraphDescription || frontmatter.description || "",
        images: frontmatter.image?.url
          ? [
              {
                url: `https://www.99minds.io${frontmatter.image.url}`,
                width: 1200,
                height: 630,
                alt: frontmatter.image.alt || "Blog Image",
              },
            ]
          : [],
        site_name: "99minds",
      }}
      twitter={{
        site: "@99minds_io",
        cardType: "summary_large_image",
      }}
    />

    {
      frontmatter.image?.url && (
        <meta
          property="og:image"
          content={`https://www.99minds.io${frontmatter.image.url}`}
        />
      )
    }
  </Fragment>
 
  <!-- ✅ Blog Header Section -->
  <section class="relative overflow-x-hidden bg-[#E0DCFC] px-6">
    <div class="max-w-7xl md:px-12 lg:px-16 mx-auto pt-32 pb-24 lg:pt-48 relative">
      <div class="max-w-6xl">
        <!-- Breadcrumb Navigation -->
        <div class="hidden lg:block">
          <div class="flex items-center">
            <div
              class="border h-10 w-10 inline-flex items-center justify-center rounded-lg border-vulcan-800 group hover:border-white duration-300"
            >
              <a
                href="/"
                class="text-sm text-vulcan-300 duration-300 mx-auto"
                aria-label="home"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
                  <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path>
                  <path d="M10 12h4v4h-4z"></path>
                </svg>
              </a>
            </div>
            <div class="pt-2 flex">
              <p class="px-2">></p>
              <a href="/blog" class="text-vulcan-700 hover:text-vulcan-900">Blog</a>
              <p class="px-2">></p>
              <a class="text-vulcan-800">{frontmatter.heading}</a>
            </div>
          </div>
        </div>

        <!-- Post Title -->
        <h1 class="text-4xl mt-4 font-normal tracking-tighter">
          {frontmatter.heading}
        </h1>

        <!-- Author & Tags -->
        <section class="relative overflow-x-hidden">
          <div class="mt-4 max-w-6xl">
            <a class="flex gap-x-4" href={`/blog/author/${frontmatter.author}`}>
              <img
                src={`/assets/testimonial/${frontmatter.authorImg}`}
                alt="Author Image"
                class="w-auto h-12 rounded-full"
              />
              <div class="w-full">
                <p class="font-medium text-sm">{frontmatter.author}</p>
                <time
                  class="flex text-vulcan-700 text-sm"
                  datetime={new Date(frontmatter.pubDate).toISOString()}
                >
                  {new Date(frontmatter.pubDate).toLocaleDateString(undefined, {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>
            </a>

            <!-- Tags -->
            <ul class="flex flex-wrap gap-2 mt-12">
              {frontmatter.tags.map((tag) => (
                <li
                  key={tag}
                  class="flex items-center justify-center h-8 text-xs px-6 py-2 font-semibold transition-all border rounded-lg hover:text-vulcan-700 border-vulcan-700"
                >
                  <a href={`/tags/${tag}`}>{tag}</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- ✅ Blog Content Section -->
  <section class="relative px-6">
    <div class="max-w-7xl md:px-12 lg:px-16 mx-auto py-10 lg:pt-10">
      <div class="max-w-7xl prose prose-headings:text-black prose-a:text-black hover:prose-a:text-indigo-400 prose-li:marker:text-black/70 prose-code:text-[18px] prose-blockquote:border-l-black/70">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout3>
