---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
import { AstroSeo } from "@astrolib/seo";

---
<AstroSeo
  title={frontmatter.title || ""}
  description={frontmatter.description || ""}
  canonical={frontmatter?.url || ""}
  openGraph={{
    url: frontmatter?.url || "",
    title: frontmatter.openGraphTitle || frontmatter.title || "",
    description: frontmatter.openGraphDescription || frontmatter.description || "",
    images: [
      {
        url: frontmatter.image ? "https://www.99minds.io" + frontmatter.image.url : "",
        width: 1200,
        height: 630,
        alt: frontmatter.image ? frontmatter.image.alt : "",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>

<BaseLayout>
  <section class="relative overflow-x-hidden">
    <svg
      class="absolute blur-3xl right-0 top-0 opacity-80"
      width="50%"
      height="100%"
      viewBox="0 0 400 400"
      fill="none"
      xmlns="http://www.w3.org/2000/svg">
      <g clip-path="url(#clip0_17_60)">
        <g filter="url(#filter0_f_17_60)">
          <path d="M128.6 0H0V322.2L332.5 211.5L128.6 0Z" fill="#4D07E3"></path>
          <path d="M0 322.2V400H240H320L332.5 211.5L0 322.2Z" fill="#4C00FF"
          ></path>
          <path d="M320 400H400V78.75L332.5 211.5L320 400Z" fill="#B5BFF1"
          ></path>
          <path d="M400 0H128.6L332.5 211.5L400 78.75V0Z" fill="#7fcef3"></path>
        </g>
      </g>
      <defs>
        <filter
          id="filter0_f_17_60"
          x="-159.933"
          y="-159.933"
          width="719.867"
          height="719.867"
          filterUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
          <feBlend
            mode="normal"
            in="SourceGraphic"
            in2="BackgroundImageFix"
            result="shape"></feBlend>
          <feGaussianBlur
            stdDeviation="79.9667"
            result="effect1_foregroundBlur_17_60"></feGaussianBlur>
        </filter>
      </defs>
    </svg>
    <div
      class="max-w-7xl px-8 md:px-12 relative lg:px-32 mx-auto lg:pt-56">
      <div class="max-w-6xl">
        <div class="text-white flex">
          <div class="border h-10 w-10 inline-flex items-center rounded-lg border-vulcan-800 group hover:border-white duration-300">
            <a href="/" class="text-sm text-vulcan-300 duration-300 group-hover:text-white mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-#-2 w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"> 
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path> <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
            <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path> <path d="M10 12h4v4h-4z"></path>
            </svg>
           </a>
        </div>
          <div class="pt-2 flex">
          <p class="font-bold px-2">></p>
          <a href="/blog">Blog</a>
          <p class="font-bold px-2">></p>
          <a class="text-indigo-400">{frontmatter.heading}</a>
          </div>
        </div>
        <h1 class="text-4xl mt-4 font-normal tracking-tighter text-white">
          {frontmatter.heading}
        </h1>
        <!-- <p class="mt-2 text-base text-vulcan-300">{frontmatter.description}</p>  -->
        <section class="relative overflow-x-hidden">
          <svg
            class="absolute blur-3xl right-0 top-0 opacity-80"
            width="50%"
            height="100%"
            viewBox="0 0 400 400"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_17_60)">
              <g filter="url(#filter0_f_17_60)">
                <path d="M128.6 0H0V322.2L332.5 211.5L128.6 0Z" fill="#4D07E3"></path>
                <path d="M0 322.2V400H240H320L332.5 211.5L0 322.2Z" fill="#4C00FF"
                ></path>
                <path d="M320 400H400V78.75L332.5 211.5L320 400Z" fill="#B5BFF1"
                ></path>
                <path d="M400 0H128.6L332.5 211.5L400 78.75V0Z" fill="#7fcef3"></path>
              </g>
            </g>
            <defs>
              <filter
                id="filter0_f_17_60"
                x="-159.933"
                y="-159.933"
                width="719.867"
                height="719.867"
                filterUnits="userSpaceOnUse"
                color-interpolation-filters="sRGB">
                <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
                <feBlend
                  mode="normal"
                  in="SourceGraphic"
                  in2="BackgroundImageFix"
                  result="shape"></feBlend>
                <feGaussianBlur
                  stdDeviation="79.9667"
                  result="effect1_foregroundBlur_17_60"></feGaussianBlur>
              </filter>
            </defs>
          </svg>
          <div>
            <div class="mt-4 max-w-6xl">
            <div class="flex gap-4">
              <div>
                <img src={`/assets/testimonial/${frontmatter.authorImg}`} alt="Author Image" class="w-auto h-12 rounded-full">
              </div>
              <div class="w-full">
                <div> 
                  <p class="font-medium text-white text-sm">
                  {frontmatter.author}
                </p>
                
                </div>
                <div>
                  <time
                     class="flex text-vulcan-300 text-sm"
                     datetime={new Date(frontmatter.pubDate).toISOString()}
                     >
                     {new Date(frontmatter.pubDate).toLocaleDateString(undefined, {
                     year: 'numeric',
                     month: 'long',
                     day: 'numeric',
                    })}
                  </time>
                </div>
              </div>
            </div>              
              <ul class="flex flex-wrap gap-2 mt-12" role="list">
                {
                  frontmatter.tags.map((tag) => (
                    <a href={`/tags/${tag}`}>
                      {" "}
                      <li class=" flex items-center justify-center h-8 text-xs px-4 py-2 font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">
                        {tag}
                      </li>
                    </a>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
  <section class="relative">
    <div class="max-w-7xl px-8 md:px-12 relative lg:px-32 mx-auto py-10 lg:pt-10">
      <div>
        <div>
          <div class="max-w-7xl prose prose-blockquote:border-l-white prose-a:text-indigo-500 hover:prose-a:text-white prose-headings:font-normal prose-headings:text-white prose-li:marker:text-indigo-500 text-vulcan-300 prose-code:text-white prose-blockquote:text-white/70">
          <!--<div class="max-w-7xl prose prose-blockquote:border-l-white prose-a:text-violet-400	 hover:prose-a:text-white prose-headings:font-normal prose-headings:text-white prose-li:marker:text-indigo-500 text-white/70 text-lg prose-code:text-white prose-blockquote:text-white/70">-->
            <slot />
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
