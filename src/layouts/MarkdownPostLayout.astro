---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
import { AstroSeo } from "@astrolib/seo";

---


<head>
  <meta name="keywords" content={frontmatter.keywords}>
</head>

<BaseLayout>
  <AstroSeo
    title={frontmatter.title || ""}
    description={frontmatter.description || ""}
    canonical={frontmatter?.url || ""}
    openGraph={{
      url: frontmatter?.url || "",
      title: frontmatter.openGraphTitle || frontmatter.title || "",
      description: frontmatter.openGraphDescription || frontmatter.description || "",
      images: [
        {
          url: frontmatter.image ? "https://www.99minds.io" + frontmatter.image.url : "",
          width: 1200,
          height: 630,
          alt: frontmatter.image ? frontmatter.image.alt : "",
          type: "image/webp",
        }
      ],
      site_name: "99minds",
    }}
    twitter={{
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
    linkedin={{
        title: frontmatter.openGraphTitle || frontmatter.title || "",
        description: frontmatter.openGraphDescription || frontmatter.description || "",
        image: frontmatter.image ? "https://www.99minds.io" + frontmatter.image.url : "",
        url: frontmatter?.url || "",
    }}
  />
  <section class="relative overflow-x-hidden bg-[#E0DCFC] px-6">
    <div
      class="max-w-7xl md:px-12 relative lg:px-16 mx-auto lg:pt-48 md:pb-24">
      <div class="max-w-6xl">
        <div class="lg:block hidden">
          <div class="flex">
          <div class="border h-10 w-10 inline-flex items-center rounded-lg border-vulcan-800 group hover:border-white duration-300">
            <a href="/" class="text-sm text-vulcan-300 duration-300 group-hover: mx-auto" role="link" aria-label="home">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-#-2 w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"> 
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path> <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
            <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path> <path d="M10 12h4v4h-4z"></path>
            </svg>
           </a>
          </div>
            <div class="pt-2 flex">
              <p class=" px-2">></p>
              <a href="/blog">Blog</a>
              <p class="px-2">></p>
              <a class="text-vulcan-800">{frontmatter.heading}</a>
            </div>
          </div>
        </div>
        <h1 rel="preload" class="text-4xl mt-4 font-normal tracking-tighter ">
          {frontmatter.heading}
        </h1>
        <section class="relative overflow-x-hidden">
          <div>
            <div class="mt-4 max-w-6xl">
            <div class="flex gap-x-4">
              <div>
                <img rel="preload" src={`/assets/testimonial/${frontmatter.authorImg}`} alt="Author Image" class="w-auto h-12 rounded-full">
              </div>
              <div class="w-full">
                <div> 
                  <p rel="preload" class="font-medium  text-sm">
                  {frontmatter.author}
                </p>
                
                </div>
                <div>
                  <time
                     class="flex text-vulcan-700 text-sm"
                     datetime={new Date(frontmatter.pubDate).toISOString()}
                     >
                     {new Date(frontmatter.pubDate).toLocaleDateString(undefined, {
                     year: 'numeric',
                     month: 'long',
                     day: 'numeric',
                    })}
                  </time>
                </div>
              </div>
            </div>              
              <ul rel="preload" class="flex flex-wrap gap-2 mt-12">
              {frontmatter.tags.map((tag) => (
                <li key={tag} class="flex items-center justify-center h-8 text-xs px-6 py-2 font-semibold  transition-all border rounded-lg hover:text-vulcan-700 border-vulcan-700">
                  <a href={`/tags/${tag}`}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
  <section class="relative px-6">
    <div class="max-w-7xl md:px-12 relative lg:px-16 mx-auto py-10 lg:pt-10">
      <div>
        <div>
          <div class="max-w-7xl prose prose-blockquote:border-l-white prose-a:text-black hover:prose-a:text-indigo-400 prose-headings:font-normal prose-headings:text-black prose-li:marker:text-black /70 prose-code: text-[18px] prose-blockquote:/70">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
