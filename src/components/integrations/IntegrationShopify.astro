---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <div
    class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]">
    <div class="max-w-4xl text-center lg:mx-auto">
      <div>
        <h2
          class="">
          Integrations for your Shopify account
        </h2>
        <p class="max-w-4xl mt-4">
          Enhance your 99minds experience with a wide variety of add-ons and integrations. From everyday essentials to powerful pro workflows.
        </p>
      </div>
    </div>
    <div
        class="relative items-center lg:w-9/12 pb-0 mx-auto lg:mt-0 overflow-hidden max-w-7xl lg:p-0"
        style="">
        <img
          class="object-cover" width="1080" height="855"
          loading="lazy"
          src="/assets/shopify/99minds-Shopify2.webp"
          alt="Shopify integrations"
        />
        <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto mt-12 sm:flex-row pb-2">
        <a href="/integrations" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                <span class="w-full h-full bg-black absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                <span class="relative text-white">View all integrations</span>
                </span>
          </a>
          </div>
      </div>
  </div>
</section>
