---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-white/5">
<Verticalgrid />
  <div class="hidden pt-12 lg:block">
  
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-6">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="mt-8 lg:text-4xl text-3xl font-normal tracking-tight text-balance text-white">Easy Omnichannel Experience for Bigcommerce and POS
      </h2>
        <p class="max-w-4xl mt-4 text-base text-vulcan-300">
          99minds is perfect for omnichannel Bigcommerce users. You can roll out your marketing strategy smoothly across all your locations by syncing up with both your Point-of-Sale and eCommerce systems. It’s all about making your operations easier and boosting your sales, while saving you a lot of time.
        </p>
    </div>
    <div class="relative lg:mt-8 items-center lg:w-2/3 pb-0 mx-auto overflow-hidden max-w-7xl" style="">
        <img
          class="object-cover w-full"
          src="/assets/BigC-int.svg"
          alt="99minds integrations for Bigcommerce"
        />
      </div>
  </div>
</section>