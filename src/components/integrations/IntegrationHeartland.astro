---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-y border-white/5">
  <Verticalgrid />
  <div
    class="relative px-8 py-2 mx-auto space-y-12 max-w-7xl md:px-12 lg:px-16 lg:py-12">
    <div class="max-w-4xl text-center lg:mx-auto">
      <div>
        <p
          class="mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">
          Integrations for your Heartland Retail
        </p>
        <p class="max-w-4xl mt-4 text-base text-vulcan-300">
          Connect your 99minds account with the Point of Sale, payment, marketing, gift card processors, and fraud prevention tools you employ
        </p>
      </div>
    </div>
    <div
        class="relative items-center lg:w-9/12 pb-0 mx-auto overflow-hidden max-w-7xl lg:pb-14">
        <img
          class="object-cover w-full"
          src="/assets/99minds-Heartland.png"
          alt="Heartland integrations"
        />
        <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto mt-12 sm:flex-row">
        <a href="/integrations" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">View all integrations</span>
                </span>
          </a>
          </div>
      </div>
    <!--<div class="flex flex-col gap-12 pt-12 mt-12 border-t not-prose border-white/10 md:flex-row">
            <p>
              <a
                class="text-indigo-400 duration-200 hover:text-white"
                href="/integrations">View all integrations &nbsp; &rarr;</a
              >
            </p>
          </div>-->
  </div>
</section>
