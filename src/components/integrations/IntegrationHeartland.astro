---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-y border-white/5">
  <Verticalgrid />
  <div
    class="relative px-8 py-2 mx-auto space-y-12 max-w-7xl md:px-12 lg:px-16 lg:py-12">
    <div class="max-w-2xl lg:text-center lg:mx-auto">
      <div>
        <p
          class="mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">
          Integration
        </p>
        <p class="max-w-2xl mt-4 text-base text-vulcan-300">
          Enhance your 99minds experience with Shopify.
        </p>
      </div>
    </div>
    <div
        class="relative items-center lg:w-2/3 pb-0 mx-auto overflow-hidden max-w-7xl" style="">
        <img
          class="object-cover w-full"
          src="/assets/Heartland-Int.svg"
          alt=""
        />
      </div>
