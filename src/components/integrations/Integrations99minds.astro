---
import Verticalgrid from "../assets/Verticalgrid.astro";
import { Integrations } from "../../config/Integration.jsx"
---

<section class="relative">
  <Verticalgrid />
  <div class="relative px-8 py-32 mx-auto space-y-24 max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="max-w-4xl">
      <div>
        <h2 class="mt-8">Integrations</h2>
        <p class="max-w-4xl mt-4 text-xl">Empower Your Brick & Mortar Store With Powerful Integrations</p>
      </div>
    </div>
    <ul class="grid grid-cols-2 gap-6 mt-12 list-none lg:grid-cols-4 lg:gap-x-12 lg:gap-y-32 lg:mt-24" role="list">
      {Integrations.map((item, index) => (
        <li key={index}>
          <div>
            <a href={item.url}><img class='w-1/4' src={item.image} alt={item.title} /></a>
            <p class="mt-4 text-lg font-medium text-white lg:text-xl">{item.title}</p>
          </div>
          <div class="mt-2 ">
            <p class="text-base">{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-12 pt-12 mt-12 border-t not-prose border-white/10 md:flex-row">
      <p>
        <a class="text-white/70 duration-200 hover:text-white" href="/integrations">View all integrations &nbsp; &rarr;</a>
      </p>
    </div>
  </div>
</section>
