---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div
    class="relative px-8 py-32 mx-auto space-y-24 max-w-7xl md:px-12 lg:px-32 lg:py-24">
    <div class="max-w-2xl">
      <div>
        <p
          class="mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">
          Integrations
        </p>
        <p class="max-w-xl mt-4 text-base text-vulcan-300">
          Empower Your Brick & Click Store With Powerful Integrations
        </p>
      </div>
    </div>
    <ul
      class="grid grid-cols-2 gap-6 mt-12 list-none lg:grid-cols-4 lg:gap-x-12 lg:gap-y-32 lg:mt-24"
      role="list">
      <li>
        <div>
          <img src="/integrations/stripe.svg" alt="" />
          <p class="mt-4 text-lg font-medium text-white lg:text-xl">Klaviyo</p>
        </div>
        <div class="mt-2 text-sm text-vulcan-300">
          A payment processing platform for online businesses.
          <p class="mt-4">
            <a
              href="/integrations/integrations-details"
              class="text-sm leading-6 text-indigo-300 hover:text-white"
              >Read more <span aria-hidden="true">&rarr;</span></a
            >
          </p>
        </div>
      </li>
      <li>
        <div>
          <img src="/integrations/shopify.svg" alt="" />
          <p class="mt-4 text-lg font-medium text-white lg:text-xl">Omnisend</p>
        </div>
        <div class="mt-2 text-sm text-vulcan-300">
          An e-commerce platform for online stores.
          <p class="mt-4">
            <a
              href="/integrations/integrations-details"
              class="text-sm leading-6 text-indigo-300 hover:text-white"
              >Read more <span aria-hidden="true">&rarr;</span></a
            >
          </p>
        </div>
      </li>
      <li>
        <div>
          <img src="/integrations/paypal.svg" alt="" />
          <p class="mt-4 text-lg font-medium text-white lg:text-xl">Vend</p>
        </div>
        <div class="mt-2 text-sm text-vulcan-300">
          An online payment system for sending and receiving money.
          <p class="mt-4">
            <a
              href="/integrations/integrations-details"
              class="text-sm leading-6 text-indigo-300 hover:text-white"
              >Read more <span aria-hidden="true">&rarr;</span></a
            >
          </p>
        </div>
      </li>
      <li>
        <div>
          <img src="/integrations/yandex_kassa.svg" alt="" />
          <p class="mt-4 text-lg font-medium text-white lg:text-xl">
            Heartland
          </p>
        </div>
        <div class="mt-2 text-sm text-vulcan-300">
          A payment gateway service for online transactions in Russia.
          <p class="mt-4">
            <a
              href="/integrations/integrations-details"
              class="text-sm leading-6 text-indigo-300 hover:text-white"
              >Read more <span aria-hidden="true">&rarr;</span></a
            >
          </p>
        </div>
      </li>
      <li>
        <div>
          <img src="/integrations/alfa_bank.svg" alt="" />
          <p class="mt-4 text-lg font-medium text-white lg:text-xl">
          Hike            </p
        </div>
        <div class="mt-2 text-sm text-vulcan-300">
