---
import Verticalgrid from "../assets/Verticalgrid.astro";
import { Integrations } from "../../config/Integration.jsx"
---

<section class="relative border-t border-white/5">
  <Verticalgrid />
  <div class="relative px-8 py-32 mx-auto space-y-24 max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="mx-auto text-center max-w-4xl">
      <div data-aos="fade-down" data-aos-duration="2000">
        <h2 class=" mt-8">Powerful Integrations for Powerful Businesses</h2>
        <p class="max-w-4xl mt-4 text-xl">Integrations for e-commerce and retail eco-system</p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div data-aos="fade-right" data-aos-duration="2000" class=" ">
        <p class="text-white">
           Link your gift card program with your e-commerce and retail store and other tools you are using. Set up seamless integrations with your:
        </p>
        <ul class="mt-4">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6">E-Commerce store 
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2  leading-6 ">Point of sale 
              </p></div>
           </li>
            <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2  leading-6 ">Marketing and email tool
              </p></div>
            </li>
            <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6 ">Payment processors
              </p></div>
            </li>
             <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6 ">Gift card processors 
              </p></div>
            </li>
             <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6 ">Fraud Prevention tools
              </p></div>
            </li>
             
        </ul>
          <!---<div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div>--->
      </div>
      
      <div data-aos="zoom-in" data-aos-duration="2000" class="h-full">
        <img
          alt=" integrations for 99minds gift cards"
          loading="lazy"
          class="rounded-2xl <!---shadow-2xl---> shadow-vulcan-950/50" width="528" height="430"
          src="/assets/homepage/Int1.webp"
        />
      </div>
    </div>
    <div data-aos="fade-right" data-aos-duration="2000" class="flex flex-col gap-12 pt-12 mt-12 border-t not-prose border-white/10 md:flex-row">
      <p>
        <a class="text-white/70 duration-200 hover:text-white" href="/integrations">View all integrations &nbsp; &rarr;</a>
      </p>
    </div>
  </div>
</section>
