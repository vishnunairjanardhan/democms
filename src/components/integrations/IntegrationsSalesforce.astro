---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-y border-white/5">
  <Verticalgrid />
  <div
    class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]">
    <div class="max-w-4xl text-center lg:mx-auto">
      <div>
        <h2
          class="">
          Integrations for your Salesforce store
        </h2>
        <p class="max-w-4xl mt-4">
Enhance your 99minds experience with a broad selection of add-ons and integrations, ranging from essential tools to sophisticated professional workflows.
        </p>
      </div>
    </div>
    <div
        class="relative items-center lg:w-9/12 pb-0 mx-auto lg:mt-0 overflow-hidden max-w-7xl lg:mt-10 lg:pb-0 "
        style="">
        <img
          class="object-cover w-full"
          loading="lazy"
          src="/assets/salesforce/SF-int.webp" width="683" height="556"
          alt="Salesforce integrations"
        />
        <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto mt-12 sm:flex-row">
        <a href="/integrations" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                <span class="w-full h-full bg-black absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                <span class="relative text-white">View all integrations</span>
                </span>
          </a>
          </div>
      </div>
      <!--<div class="flex flex-col gap-12 pt-12 mt-12 border-t not-prose border-white/10 md:flex-row">
            <p>
              <a
                class="text-indigo-400 duration-200 hover:text-white"
                href="/integrations">View all integrations &nbsp; &rarr;</a
              >
            </p>
          </div>-->
  </div>
</section>
