---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-white/5">
<Verticalgrid />
  <div class="hidden pt-12 lg:block">
  
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-6">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="mt-8 text-4xl font-normal tracking-tight text-balance text-white">Seamless in-store and online integration
      </h2>
        <p class="max-w-4xl mt-4 text-base text-vulcan-300">
        99minds is made for omnichannel Lightspeed Retail users. Execute your complete marketing plan across all your outlets by effortlessly integrating with both your Lightspeed Point-of-Sale and eCommerce systems. Streamline your process and boost sales with tools that work in harmony, saving you valuable time
        </p>
    </div>
    <div class="relative lg:mt-8 items-center lg:w-2/3 pb-0 mx-auto overflow-hidden max-w-7xl" style="">
        <img
          class="object-cover w-full"
          src="/assets/Square-int.svg"
          alt=""
        />
      </div>
  </div>
</section>