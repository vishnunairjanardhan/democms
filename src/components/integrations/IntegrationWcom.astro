---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-white/5">
<Verticalgrid />
  <div class="hidden pt-12 lg:block">
  
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-6">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="mt-8 text-balance">Set up Omnichannel Experience for Woocommerce and POS
      </h2>
        <p class="max-w-4xl mt-4 text-balance">
        Implement your comprehensive marketing strategy across all your outlets by seamlessly connecting your Woocommerce store  with your Point-of-Sale and eCommerce systems. Simplify your operations and increase sales with tools that synchronize effectively, saving you crucial time.
        </p>
    </div>
    <div class="relative lg:mt-8 items-center lg:w-2/3 pb-0 mx-auto overflow-hidden max-w-7xl" style="">
        <img
          class="object-cover" width="683" height="557"
          src="/assets/woocommerce/Wcom-Int.svg"
          alt="99minds integrations for Woocommerce"
        />
      </div>
  </div>
</section>