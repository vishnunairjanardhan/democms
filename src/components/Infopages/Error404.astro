---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <section>
    <div
      class="relative items-center w-full px-5 py-24 mx-auto md:px-12 lg:px-16 max-w-7xl lg:pb-32 lg:pt-56">
      <div class="text-left sm:text-center">

        <div class="flex items-center justify-center">
          <iframe class="w-full h-xl border-0" src="https://lottie.host/embed/59c07617-073d-4f36-a4d3-e0ccad79127b/TeVyCHBGMX.lottie"></iframe>
        </div>
        <h1
          class="mt-12 text-vulcan-800">
          Oops, page not found
        </h1>
        <p class="max-w-2xl mx-auto mt-4 text-vulcan-800">
          This page does not exist or it was removed.
          <span class="block"
            >We suggest you go back home</span
          >
        </p>

        <div class="flex flex-col justify-center max-w-xl gap-2 mx-auto mt-12 sm:flex-row">
          <a href="/" class="mx-3 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
            <span class="w-full h-full bg-white border border-solid border-black rounded-md absolute">
              </span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400 font-medium">
                <span class="relative text-black">
                  Go Back Home
                </span> </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</section>
