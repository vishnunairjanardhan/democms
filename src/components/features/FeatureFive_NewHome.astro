---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#E0DCFC]">
  <Verticalgrid />
  
  <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px] relative space-y-24">
    <div class="grid grid-cols-1 gap-4 list-none lg:grid-cols-2 lg:gap-24">
      <div>
        <h2 role="heading" class="lg:mt-32 font-medium">
          Full Stack Digital Wallet for your Store
        </h2>
        <p role="emphasis" class="mt-4 ">
            Complete stack of features to implement all types of acquisition and retention programs. Reward, incentive, cashback, coupon or store credit programs all rolled into one.
        </p>
      </div>
      <div class="lg:mt-0 mt-12 h-full">
        <img
          role="img"
          loading="lazy"
          alt="Wallet pass image"
          class="rounded-2xl shadow-vulcan-950/50" width="550" height="550"
          src="/assets/homepage/D-wallet.svg"
        />
      </div>
    </div>
    <div>
      <ul
       
        class="grid lg:grid-cols-4 gap-8 mt-6 list-none md:grid-cols-4 lg:gap-12 lg:mt-24"
        role="list">
        <li>
          <div>
            <div class="text-indigo-400">
            <img role="img" alt="gift card logo" class="" width="38" height="24" src="/assets/homepage/GC-b.svg"/>
            </div>
            <p role="term" class="mt-3 font-medium text-black pr-8 text-xl">
              Gift cards
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Allow users to add and redeem gift cards using the Google & Apple Wallet app, and send them a reminder whenever they’re nearby a physical store.
          </p>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
             <img role="img" alt="Loyalty card logo" class="" width="38" height="24" py-4 src="/assets/homepage/LC-b.svg"/>
            </div>
            <p role="term" class="mt-3 font-medium text-black pr-8 text-xl">
              Loyalty cards
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
           Create digital loyalty cards your customers can add to Google & Apple Wallet for convenient access to rewards and purchase history. Leverage Google’s enhanced location-based notifications, updates, and messaging for greater customer engagement.
          </p>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <img role='img' alt="In-store payments logo" class="" width="38" height="24" py-4 src="/assets/homepage/Instore-Pay-b.svg"/>
            </div>
            <p role="term" class="mt-3 font-medium text-black lg:text-xl">
            In-store payments
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Give your customers a fast, simple way to pay in millions of places – online, in stores, and more. Bring together everything they need at checkout for a frictionless payment experience.
          </p>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <img role="img" alt="offers logo" class="" width="38" height="24" py-4 src="/assets/homepage/offer-b.svg"/>
            </div>
            <p role="term" class="mt-3 text-lg font-medium text-black lg:text-xl">
            Offers
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Enable users to add offers from your webpage or app directly to Google & Apple Wallet. Implement enhanced features, like offer expiration notification and geofenced notifications to drive engagement with users.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
