---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div
    class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-24 relative space-y-24">
    <div class="grid grid-cols-1 gap-4 mt-6 list-none lg:grid-cols-2 lg:gap-24">
      <div>
        <h2 class="mt-8 text-white text-2xl xl:text-3xl 2xl:text-5xl font-normal tracking-tight text-white">
          Full Stack Digital Wallet for your Store
        </h2>
        <p class=" text-xl xl:text-xl mt-4 text-vulcan-300 ">
            Complete stack of features to implement all types of acquisition and retention programs. Reward, incentive, cashback, coupon or store credit programs all rolled into one.
        </p>
      </div>
      <div class="lg:mt-0 mt-12 h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50 w-full"
          src="/assets/card2.svg"
        />
      </div>
    </div>
    <div>
      <ul
        class="grid grid-cols-2 gap-8 mt-6 list-none md:grid-cols-3 lg:gap-12 lg:mt-24"
        role="list">
        <li>
          <div>
            <div class="text-indigo-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
                ></path>
              </svg>
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
              Build Loyalty Programs
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
            Manage and scale loyalty programs to retain customers and build lifelong relationships
          </div>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
              Customer Advocacy Programs
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
           You customers are your best ambassadors. Build scalable referral programs.
          </div>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8.25V18a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18V8.25m-18 0V6a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 6v2.25m-18 0h18M5.25 6h.008v.008H5.25V6zM7.5 6h.008v.008H7.5V6zm2.25 0h.008v.008H9.75V6z"
                ></path>
              </svg>
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
            Promotion Engine for Scale
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
            Build all types of promotion campaigns for accelerated growth
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
