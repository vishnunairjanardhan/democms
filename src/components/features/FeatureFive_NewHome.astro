---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  
  <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-12 relative space-y-24">
    <div class="grid grid-cols-1 gap-4 mt-6 list-none lg:grid-cols-2 lg:gap-24">
      <div data-aos="fade-right" data-aos-duration="3000">
        <h2 role="heading" class="lg:mt-40">
          Full Stack Digital Wallet for your Store
        </h2>
        <p role="emphasis" class="mt-4 ">
            Complete stack of features to implement all types of acquisition and retention programs. Reward, incentive, cashback, coupon or store credit programs all rolled into one.
        </p>
      </div>
      <div data-aos="zoom-in" data-aos-duration="3000" class="lg:mt-0 mt-12 h-full">
        <img
          role="img"
          loading="lazy"
          alt="Wallet pass image"
          class="rounded-2xl shadow-vulcan-950/50" width="788" height="789"
          src="/assets/homepage/WP.webp"
        />
      </div>
    </div>
    <div>
      <ul
       
        class="grid grid-cols-2 gap-8 mt-6 list-none md:grid-cols-4 lg:gap-12 lg:mt-24"
        role="list">
        <li data-aos="fade-down" data-aos-duration="1000">
          <div>
            <div data-aos="fade-down" data-aos-duration="3000" class="text-indigo-400">
            <img role="img" alt="gift card logo" class="" width="32" height="24" src="/assets/homepage/GC.svg"/>
            </div>
            <p role="term" class="mt-5 font-medium text-white pr-8 text-xl">
              Gift cards
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Allow users to add and redeem gift cards using the Google & Apple Wallet app, and send them a reminder whenever they’re nearby a physical store.
          </p>
        </li>
        <li data-aos="fade-up" data-aos-duration="1500">
          <div>
            <div data-aos="fade-up" data-aos-duration="3000" class="text-indigo-400">
             <img role="img" alt="Loyalty card logo" class="" width="32" height="24" py-4 src="/assets/homepage/LC.svg"/>
            </div>
            <p role="term" class="mt-5 font-medium text-white pr-8 text-xl">
              Loyalty cards
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
           Create digital loyalty cards your customers can add to Google & Apple Wallet for convenient access to rewards and purchase history. Leverage Google’s enhanced location-based notifications, updates, and messaging for greater customer engagement.
          </p>
        </li>
        <li data-aos="fade-down" data-aos-duration="2000">
          <div>
            <div data-aos="fade-down" data-aos-duration="3000" class="text-indigo-400">
              <img role='img' alt="In-store payments logo" class="" width="32" height="24" py-4 src="/assets/homepage/Instore-Pay.svg"/>
            </div>
            <p role="term" class="mt-3 font-medium text-white lg:text-xl">
            In-store payments
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Give your customers a fast, simple way to pay in millions of places – online, in stores, and more. Bring together everything they need at checkout for a frictionless payment experience.
          </p>
        </li>
        <li data-aos="fade-up" data-aos-duration="2500">
          <div>
            <div data-aos="fade-up" data-aos-duration="3000" class="text-indigo-400">
              <img role="img" alt="offers logo" class="" width="32" height="24" py-4 src="/assets/homepage/offer.svg"/>
            </div>
            <p role="term" class="mt-3 text-lg font-medium text-white lg:text-xl">
            Offers
            </p>
          </div>
          <p role="emphasis" class="mt-2 text-base">
            Enable users to add offers from your webpage or app directly to Google & Apple Wallet. Implement enhanced features, like offer expiration notification and geofenced notifications to drive engagement with users.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
