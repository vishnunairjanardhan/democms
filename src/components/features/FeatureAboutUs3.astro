---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-black/5">
  <Verticalgrid />
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px]">
        
          <div class="lg:flex gap-2" role="button">
              <div x-data="{ open: false }" class="flex justify-center"> 
             
    <div
      class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        
        <h2 class="mt-8">
            Go-to Platform for Omnichannel <br/> Gift Cards and Loyalty Programs.
        </h2>
        <p class="mt-4">
            Established in 2019 in the USA as a leading B2B SaaS company that helps 1000+ businesses across the world. <br> <br>

            99minds is a gift card and loyalty platform for omnichannel ecommerce that enables you to create and manage gift card programs, reward customers for their engagement and purchases, and gather valuable insights into customer behavior.  <br> <br>
            
            The coolest thing about 99minds? It’s a breeze to use! Our plug-and-play, wallet-friendly marketing platform lets your team whip up personalized campaigns and craft seamless omnichannel customer experiences like pros.
            
        </p>
        <div class="lg:flex gap-2 mt-10" role="button">
              <div x-data="{ open: false }" class="flex justify-center">
               <a type="button" href="/Get-Started" target="_blank" role="button" aria-label="Get Started for Free" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium"> <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400"> <span class="relative text-white">Get Started for free</span> </span> </a>
                
              </div>
            </div>
      </div>
      <div class="h-full">
        <h2 class="mt-4">More About 99minds</h2>
         <img
          role='img'
          loading="lazy"
          alt="Loyalty Points image"
          class="rounded-2xl shadow-vulcan-950/50 " width="760" height="700"
          src="/assets/homepage/GC-experience.webp"
        />
      </div>
    </div>
    </div>
  </div>
</section>
