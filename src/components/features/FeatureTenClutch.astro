---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#91C8FA]">
  <Verticalgrid />
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px]" role="none">
    <div class="grid grid-cols-1 gap-4 mt-6 list-none lg:grid-cols-2 lg:gap-24 ">
      <div>
        <p role="heading" class="lg:mt-24 text-5xl">
          Smart Workflows with Proven Outcomes with Clutch
        </p>
        <p role="emphasis" class="mt-4 ">
           Develop custom workflows to improve user engagement, retention and acquisition. Scale your business and increase revenue through automated loyalty marketing strategies.
        </p>
      </div>
      <div class="lg:mt-0 mt-12 h-full">
        <img
          role="img"
          loading="lazy"
          alt="Wallet pass image"
          class="rounded-2xl shadow-vulcan-950/50" width="550" height="550"
          src="/assets/homepage/workflow1.svg"
        />
      </div>
    </div>
  </div> 
  </section>
  <section class="relative bg-black">
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-10 mx-auto py-12 lg:py-[72px] bg-black" role="none"> 
      <ul class="grid grid-cols-1 lg:gap-16 lg:px-6 mt-2 lg:text-left lg:grid-cols-3 lg:gap-12"
        role="list">
         <li class="">
          <div>
            <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Integrate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Integrate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Seamlessly integrate your POS and build a custom program within minutes. Effortlessly craft smooth and effective customer experiences in just a few clicks.
          </p>
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Automate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Automate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Develop tailored workflows to initiate advanced, data-driven marketing campaigns. Seamlessly incorporate features such as coupons, gift cards, and digital wallets into comprehensive workflows aimed at attracting, converting, and retaining customers.
          </p>
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Personalize.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Personalize</h3>           
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Craft fully automated, data-driven marketing campaigns customised for your customers. Provide personalised incentives based on each customer’s behaviour and profile, including rewards, cashbacks, loyalty points, coupons, gift cards, and store credits, to boost engagement and nurture loyalty.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
