---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-y border-white/5">
  <div class="hidden pt-2 lg:block">
    <!-- Vertical grid (optional background or decorative) -->
  </div>

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="text-3xl font-normal tracking-tight text-balance text-black">
        99minds vs Yotpo
      </h2>
     <p class="max-w-4xl mx-auto mt-4">99minds’ all-in-one loyalty, referrals, and gift card platform makes it the best alternative to Yotpo, offering greater flexibility, better omnichannel support.</p>
     
    </div>

<div class="max-w-6xl mx-auto mt-8">
<table class="w-full table-auto border-separate border border-gray-300 border-spacing-0 rounded-lg overflow-hidden shadow-lg">
  <thead class="bg-gray-100">
    <tr>
      <th class="px-6 py-3 text-left border-r border-gray-300 text-md font-semibold text-gray-800">Feature/Criteria</th>
      <th class="px-6 py-3 text-left border-r border-gray-300 text-md font-semibold text-gray-800">99minds</th>
      <th class="px-6 py-3 text-left border-gray-300 text-md font-semibold text-gray-800">Yotpo</th>
    </tr>
  </thead>
  <tbody>
    <tr class="bg-white text-black">
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Core Focus</td>
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Loyalty, gift cards, rewards, referrals</td>
      <td class="border-t border-b border-gray-300 px-6 py-4 text-sm">Reviews/UGC, loyalty, referrals, SMS marketing</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Ease of Use</td>
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Highly rated, simple setup, user-friendly</td>
      <td class="border-t border-b border-gray-300 px-6 py-4 text-sm">Comprehensive but can be complex.</td>
    </tr>
    <tr class="bg-white text-black">
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Integration</td>
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Shopify, BigCommerce, POS, Email.</td>
      <td class="border-t border-b border-gray-300 px-6 py-4 text-sm">Shopify, Magento, BigCommerce, others</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Gift Card System</td>
      <td class="border-t border-b border-r border-gray-300 px-6 py-4 text-sm">Advanced, digital & physical, multi-channel</td>
      <td class="border-t border-b border-gray-300 px-6 py-4 text-sm">Basic (focus is on UGC and loyalty)</td>
    </tr>
    <tr class="bg-white text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Store Credit</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Does not support</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">99minds supports Store Credit uses on loyalty widget and page.</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Loyalty Programs</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Points, VIP tiers, cashback, punch cards, etc.</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">Points, referrals, VIP tiers</td>
    </tr>
    <tr class="bg-white text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Pricing</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Affordable, budget-friendly, free plan available</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">Can be expensive, especially for SMBs</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Customization</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Highly customizable loyalty & rewards programs</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">Limited customization for some tools</td>
    </tr>
    <tr class="bg-white text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Social Media Rewards</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Does not support</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">99minds support points earning for below actions, Youtube subscribe, pinterest like, linked in follow, acebook share</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Customer Support</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">24/7, highly praised by users</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">Good, but mixed reviews</td>
    </tr>
    <tr class="bg-white text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Cart Item Filter</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Does not support</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">99minds support for workflow cart item filter.</td>
    </tr>
    <tr class="bg-gray-50 text-black">
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Best For</td>
      <td class="border-t border-r border-gray-300 px-6 py-4 text-sm">Retailers, DTC brands, all sizes</td>
      <td class="border-t border-gray-300 px-6 py-4 text-sm">eCommerce, brands focused on UGC</td>
    </tr>
  </tbody>
</table>
</div>

 </div>
    <div class="text-center max-w-4xl mx-auto mt-2">
<button type="button" class="raise1 relative p-0.5 inline-flex items-center justify-center ml-4 overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });"> <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-10 duration-400 inline-flex items-center gap-2">
                  <svg role="img" alt="customer support logo" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-headset text-white" viewBox="0 0 16 16">
                    <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"/>
                  </svg>
                  <span class="relative text-white">Book a Demo</span> </span>
							</button>
                            </div>
</section>
