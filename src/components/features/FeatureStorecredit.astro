---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#FEFCF5]">
  <Verticalgrid />
  <div class="mx-auto px-8 lg:text-center lg:py-12">
        <h2 class="mt-8 2xl:text-5xl">
          Key features.
        </h2>
         <p class="font-body text-xl  mt-4">
           All your store credit needs, covered</br>
        </p>
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div class=" ">
        <h2 class="2xl:text-5xl mt-8">
          Manage Returns and Refunds
        </h2>
        <p class="mt-4 leading-6">
           Automate store credit for merchandise returns and refunds. Add all store credits to the customer wallet to easily manage purchase and checkouts.
        </p>
      </div>
      
      <div class="h-full">
        <img
          alt="use store credit to manage returns"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/return_refund.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-24 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="2xl:text-5xl mt-8">
          Simplify Customer Support
        </h2>
        <p class="mt-4 leading-6">
          Save time for your customer support team by automating refunds with 99minds store credit and gift certificates.
        </p>
      </div>
      <div class="h-full">
        <img
          alt="Time Cost"
          loading="lazy"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50" width="503" height="300"
          src="/assets/storecredit/time_cost.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="2xl:text-5xl mt-8 ">
          Reward Loyal Customers
        </h2>
       <p class="mt-4 leading-6">
          Save time for your customer support team by automating refunds with 99minds store credit and gift certificates.
        </p>
      </div>
      <div class="h-full">
        <img
          alt="Rewards" width="528" height="266"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50"
          src="/assets/storecredit/rewards.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="2xl:text-5xl mt-8">
          Run Promotional Campaigns
        </h2>
        <p class="mt-4 leading-6">
          Use store credits as rewards for time sensitive promotional campaigns. Entice visitors to purchase, take membership, or revisit your store.
        </p>
      </div>
      <div class="h-full">
        <img
          alt="Promotional Store Credit"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50" width="528" height="442"
          src="/assets/storecredit/promotional.webp"
        />
      </div>
    </div>
  </div>
</section>
