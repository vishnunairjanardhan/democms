---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div class="mx-auto px-8 lg:text-center lg:py-12">
        <h2 class="mt-8 2xl:text-5xl">
          Key features.
        </h2>
         <p class="font-body text-xl  mt-4">
           All your store credit needs, covered</br>
        </p>
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div class=" ">
        <h2 class=" 2xl:text-5xl mt-8">
           Returns & Refunds 
        </h2>
        <div class="gap-3 mt-10">
        <ul class=" mt-4 list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Automate store credit for merchandise return using return tools like Novaro etc.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Add store credit directly in customer wallet.
                </p>
              </div>
            </li>
            </ul>
            </div>
        
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/return_refund.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-24 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="2xl:text-5xl mt-8">
          Save Time and Cost
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Save time of your customer support team by automating refunds with 99minds store credit and gift certificates.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Consolidates system data with better Returns & Refunds Reports
                </p>
              </div>
            </li>
            </ul>
            </div>
        
      </div>
      <div class="h-full">
        <img
          alt="Time Cost"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50" width="503" height="300"
          src="/assets/storecredit/time_cost.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="2xl:text-5xl mt-8 ">
          Rewards
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Reward your customers with Store Credit.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Convert loyalty points to Store credit and Gift vouchers.
                </p>
              </div>
            </li>
            </ul>
            </div>
      </div>
      <div class="h-full">
        <img
          alt="Rewards" width="528" height="266"
          class="rounded-2xl shadow-vulcan-950/50"
          src="/assets/storecredit/rewards.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="2xl:text-5xl mt-8">
          Promotional Store Credit
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Entice customer by assigning time sensitive promotional Store Credit to their Account.
                </p>
              </div>
            </li>
            </ul>
            </div>
      </div>
      <div class="h-full">
        <img
          alt="Promotional Store Credit"
          class="rounded-2xl shadow-vulcan-950/50" width="528" height="442"
          src="/assets/storecredit/promotional.webp"
        />
      </div>
    </div>
  </div>
</section>
