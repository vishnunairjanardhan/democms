---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div class="mx-auto lg:text-center lg:py-12">
        <h2 class="mt-8 text-white text-2xl xl:text-3xl 2xl:text-5xl font-normal tracking-tight text-white">
          Key features.
        </h2>
         <p class="font-body text-xl xl:text-2xl mt-4 text-vulcan-300 ">
           All your store credit needs, covered</br>
        </p>
        </div>
  <div class="relative max-w-8xl px-8 md:px-12 lg:px-32 mx-auto py-12 lg:py-12  space-y-24">
    <div class="grid grid-cols-1 gap-6 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="2xl:px-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
           Returns & Refunds 
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Automate store credit for merchandise return using return tools like Novaro etc.</strong
                  >
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Add store credit directly in customer wallet.</strong
                  >
                </p>
              </div>
            </li>
            </ul>
            </div>
        
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/return-Refund.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last 2xl:px-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Save Time and Cost
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Save time of your customer support team by automating refunds with 99minds store credit and gift certificates.</strong
                  >
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Consolidates system data with better Returns & Refunds Reports</strong
                  >
                </p>
              </div>
            </li>
            </ul>
            </div>
        
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/time-cost.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="2xl:px-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Rewards
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Reward your customers with Store Credit.</strong
                  >
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Convert loyalty points to Store credit and Gift vouchers.</strong
                  >
                </p>
              </div>
            </li>
            </ul>
            </div>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/rewards.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last 2xl:px-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Promotional Store Credit
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-sm leading-6 text-vulcan-300">
                  <strong class="font-semibold text-vulcan-100"
                    >Entice customer by assigning time sensitive promotional Store Credit to their Account.</strong
                  >
                </p>
              </div>
            </li>
            </ul>
            </div>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/storecredit/promotional.png"
        />
      </div>
    </div>
  </div>
</section>
