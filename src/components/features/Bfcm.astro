			<div class="mt-4 pt-0 max-w-2xl mx-auto w-full">
				<!-- Starts compoent -->
				<div
				class="w-full justify-center border border-vulcan-700 bg-vulcan-20 p-2 lg:px-12 rounded-xl"
				x-data="{
					endDate: new Date('2024-11-29T23:59:59').getTime(),
					remainingTime: 0,
					formatTime(time) {
						const days = Math.floor(time / (1000 * 60 * 60 * 24));
						const hours = Math.floor((time % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
						const minutes = Math.floor((time % (1000 * 60 * 60)) / (1000 * 60));
						const seconds = Math.floor((time % (1000 * 60)) / 1000);
						return { days, hours, minutes, seconds };
					}
					}"
							x-init="() => {
					setInterval(() => {
						const now = new Date().getTime();
						const remainingTime = endDate - now;
						$data.remainingTime = remainingTime > 0 ? remainingTime : 0;
					}, 1000);
					}">
				<template x-if="remainingTime > 0">
					<div class="lg:gap-4 text-center w-full max-w-2xl flex mx-auto justify-center justify-between">
					<div class=" items-center">
						<div
						class="lg:text-4xl text-3xl font-medium text-white"
						x-text="formatTime(remainingTime).days">
						</div>
						<div class="ml-2 lg:text-2xl text-lg text-[#AA8FFF]">Days</div>
					</div>
					<div class=" items-center">
						<div
						class="lg:text-4xl text-3xl font-medium text-white"
						x-text="formatTime(remainingTime).hours">
						</div>
						<div class="ml-2 lg:text-2xl text-lg text-[#AA8FFF]">Hours</div>
					</div>
					<div class=" items-center">
						<div
						class="lg:text-4xl text-3xl font-medium text-white"
						x-text="formatTime(remainingTime).minutes">
						</div>
						<div class="lg:text-2xl text-lg ml-2 text-[#AA8FFF]">Minutes</div>
					</div>
					<div class=" items-center">
						<div
						class="lg:text-4xl text-3xl font-medium text-white"
						x-text="formatTime(remainingTime).seconds">
						</div>
						<div class="lg:text-2xl text-lg ml-2 text-[#AA8FFF]">Seconds</div>
					</div>
					</div>
				</template>
				<!--<template x-if="remainingTime <= 0">
