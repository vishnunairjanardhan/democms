---
import TESTIMONIAL from "../../config/Testimonial.json";
---

<section class="relative">
  <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-7xl lg:px-0 mx-auto px-6 right-0">
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
  </div>

  <div class="relative items-center w-full px-5 pt-24 mx-auto md:px-12 lg:px-12 max-w-7xl lg:pt-36">
    <div class="grid grid-cols-1 gap-6 p-8 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-24 lg:p-4 lg:pt-8">
      <div class="relative items-center gap-12 pb-12 m-auto lg:inline-flex md:order-first lg:pb-32 xl:pt-0">
        <div class="max-w-xl text-center lg:text-left">
          <h1 class="mt-8">Be the marketer you can be with 99minds Platform</h1>
          <p class="max-w-2xl mt-4">Turn one-time shoppers into customers for life and maximize customer value with 99mind’s Retention Marketing Platform.</p>
          <div class="mt-8">
            <button type="button" role="button" label="book a demo" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });">
              <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
              <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400 font-medium">
                <span class="relative text-white">Book a Demo</span>
              </span>
            </button>
          </div>
        </div>
      </div>
      <div class="rounded-3xl relative h-[430px] video-container overflow-hidden" style="background-color: #c2ddff;">
        <div class="flex flex-col w-full" x-data="{
            images: [], // Array for holding images
            interval: null,
            currentIndex: 0,
            imageCount: TESTIMONIAL.length, // Total number of images
            next() {
                this.currentIndex = (this.currentIndex + 1) % this.imageCount; // Loop to first image
                this.scrollToCurrent();
            },
            scrollToCurrent() {
                const slider = this.$refs.slider;
                const offset = slider.firstElementChild.getBoundingClientRect().width;
                slider.scrollTo({ left: offset * this.currentIndex, behavior: 'smooth' });
            },
            startAutoScroll() {
                this.interval = setInterval(() => {
                    this.next();
                }, 3000); // Adjust scroll interval as needed
            },
            stopAutoScroll() {
                clearInterval(this.interval);
            },
            init() {
                this.images = TESTIMONIAL; // Load the testimonials into the images array
                this.images = this.images.concat(this.images); // Duplicate images for infinite effect
                this.startAutoScroll(); // Start auto scrolling
            }
          }" x-init="init" x-on:mouseenter="stopAutoScroll" x-on:mouseleave="startAutoScroll">
          
          <ul class="flex gap-3 overflow-x-scroll pb-24 pt-12 scrollbar-hide snap-mandatory snap-x w-full" x-ref="slider" aria-labelledby="carousel-content-label" role="listbox">
            <template x-for="data in images">
              <li class="flex-shrink-0 w-80 h-80 snap-start">
                <img class="w-full h-full object-cover rounded-xl" :src="data.hero_image" alt="Client image">
              </li>
            </template>
          </ul>
        </div>
      </div>    
    </div>
  </div>
</section>
