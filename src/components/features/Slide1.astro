---
import TESTIMONIAL from "../../config/Testimonial.json";
---

<section class="relative">
  <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-7xl lg:px-0 mx-auto px-6 right-0">
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
  </div>

  <div class="relative items-center w-full px-5 pt-24 mx-auto md:px-12 lg:px-16 max-w-7xl lg:py-16">
    <div class="grid grid-cols-1 gap-6 p-0 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-24 lg:p-0 lg:pt-8">
      <div class="relative items-center gap-8 pb-12 m-auto lg:inline-flex md:order-first lg:pb-32 xl:pt-0">
        <div class="max-w-xl text-center lg:text-left">
          <h1 class="mt-8">Be the marketer you can be with 99minds Platform</h1>
          <p class="max-w-2xl mt-4">Turn one-time shoppers into customers for life and maximize customer value with 99mind’s Retention Marketing Platform.</p>
          <div class="mt-8">
            <button type="button" role="button" label="book a demo" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });">
              <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
              <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400 font-medium">
                <span class="relative text-white">Book a Demo</span>
              </span>
            </button>
          </div>
        </div>
      </div>
      <div class="rounded-3xl relative h-auto video-container overflow-hidden">
        <section>
          <div class="mx-auto lg:px-4 md:px-2 items-center w-full">
            <div class="flex flex-col w-full" x-data="{
              skip: 1,
              next() {
                  this.to((current, offset) => current + (offset * this.skip));
              },
              to(strategy) {
                  let slider = this.$refs.slider;
                  let current = slider.scrollLeft;
                  let offset = slider.firstElementChild.getBoundingClientRect().width;

                  // Calculate new scroll position based on strategy
                  let newScrollLeft = strategy(current, offset);

                  // Scroll to new position smoothly
                  slider.scrollTo({ left: newScrollLeft, behavior: 'smooth' });

                  // Check if we've reached the duplicate section and reset to the original
                  if (newScrollLeft >= slider.scrollWidth / 2) {
                      slider.scrollTo({ left: 0 });
                  }
              },
              startAutoSlide() {
                  this.interval = setInterval(() => {
                      this.next();
                  }, 2500);
              },
              stopAutoSlide() {
                  clearInterval(this.interval);
              },
            }" x-init="startAutoSlide" role="button">
              <div class="flex flex-col w-full" aria-labelledby="carousel-label" role="region" tabindex="0">
                <ul class="flex gap-3 overflow-x-scroll pb-6 pt-4 scrollbar-hide snap-mandatory snap-x w-full" role="listbox" aria-labelledby="carousel-content-label" tabindex="0" x-ref="slider">
                  
                  <!-- Original Slides -->
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                    <figure>
                      <ul class="h-full">
                        <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                          <div>
                            <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                              <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/cashback.png" alt="">
                            </div>
                          </div>
                        </li>
                      </ul>
                    </figure>
                  </li>
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                      <figure>
                        <ul class="h-full">
                          <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                            <div>
                              <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                                <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/Gift-Card.jpg" alt="">
                              </div>
                            </div>
                          </li>
                        </ul>
                      </figure>
                  </li>
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                      <figure>
                        <ul class="h-full">
                          <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                            <div>
                              <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                                <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/giftcard2.webp" alt="">
                              </div>
                            </div>
                          </li>
                        </ul>
                      </figure>
                  </li>

                  <!-- Duplicated Slides for Infinite Scroll Effect--> 
                 <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                    <figure>
                      <ul class="h-full">
                        <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                          <div>
                            <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                              <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/cashback1.webp" alt="">
                            </div>
                          </div>
                        </li>
                      </ul>
                    </figure>
                  </li>
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                      <figure>
                        <ul class="h-full">
                          <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                            <div>
                              <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                                <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/giftcard2.webp" alt="">
                              </div>
                            </div>
                          </li>
                        </ul>
                      </figure>
                  </li>
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                      <figure>
                        <ul class="h-full">
                          <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                            <div>
                              <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                                <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/shopifycheckout/Rebates.webp" alt="">
                              </div>
                            </div>
                          </li>
                        </ul>
                      </figure>
                  </li>
                  
                </ul>
              </div>
            </div>
          </div>
        </section>
      </div>    
    </div>
  </div>
</section>
