---
import RoundedGrid from "../assets/RoundedGrid.astro";
---

<section class="relative overflow-hidden border-t border-white/5">
  <RoundedGrid />

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-24">
    <div class="relative items-center">
      <div
        class="flex flex-col justify-between w-full lg:flex-row lg:items-start">
        <div class="max-w-xl px-8 ">
         
          <!---<p class="mt-8 text-3xl font-normal tracking-tight text-white">
            Try 99minds now
          </p>--->
          <p class="italic mt-4 text-xl text-vulcan-300">
"In summary, “99minds” provided 100% of our requirements and offered much more to manage our program. The team has been a great partner, and we highly recommend them to other customers."<br />
<span class="not-italic text-white">- Thomas Narkiewicz, CTO, FlynnOhara</span>
          </p>
        </div>

        
        <div class="lg:ml-auto">
          <img alt="Lexington thumbnail" class="rounded-2xl shadow-2xl shadow-vulcan-950/50 w-9/12" src="/assets/FlynnOHara mod.png">
        </div>
      </div>
    </div>
  </div>
  
</section>


