---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-y border-white/5">
  
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="text-center max-w-2xl  lg:mt-0 mx-auto">
      <h2 class="text-3xl font-normal tracking-tight text-balance text-black">Go Global with Multi-Currency Gift Cards</h2>
    </div>
    <div class="grid grid-cols-1 mt-16 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-3 gap-x-10 lg:mx-8">
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
            <div class="text-indigo-400 w-10 h-10">
              <img class="" alt="use gift card software for easy redemption" loading="lazy" src="/assets/multicurrency/Currency-icon.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Local Currency, Global Reach
            </h3>
            <p class="mt-2 text-base">Offer gift cards in local currencies to remove confusion and enhance the international shopping and gifting experience.</p>
          </div>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-10 h-10">
              <img class="" alt="create gift cards to improve cash flow" loading="lazy" src="/assets/multicurrency/checkout.svg">
            </div>
          <h3 class="mt-5 text-xl text-black">
            Eliminate Checkout Friction
          </h3>
          <p class="mt-2 text-base">Avoid cart abandonment by supporting gift cards in local currencies, creating a smooth and trusted global checkout process.</p>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
          <div class="text-indigo-400 w-10 h-10">
              <img class="" alt="Retain users with gift card software" loading="lazy" src="/assets/multicurrency/open-box.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Unlock Global Gifting Potential
            </h3>
            <p class="mt-2 text-base">Tap into global demand during peak seasons with localized gift cards that boost international sales and gifting opportunities.</p>
          </div>
        </div>
      </div>
    </div>

</section>



