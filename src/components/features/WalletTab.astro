<section class="flex items-end justify-center border-y border-white/5" 
         x-data="{ openTab: 1, tabs: [1, 2, 3], interval: null }" 
         x-init="interval = setInterval(() => { 
            openTab = openTab === 3 ? 1 : openTab + 1 
         }, 5000)">
  <div class="px-8 mx-auto md:px-12 lg:px-16 max-w-7xl lg:py-24">
    <div class="text-center">
      <h2 class="font-medium">Design Stunning Passes with Our Intuitive Builder.<br/>Three simple steps</h2>
      <p class="mt-5">Get your mobile wallet passes up and running in minutes, not days.</p>
    </div>

    <div class="flex items-start mt-20 -mb-px gap-8">
      <!-- Tabs -->
      <div class="border-l border-vulcan-700 lg:w-2/5 w-full">

        <!-- TAB 1 -->
        <div :class="{ 'border-l-2 border-indigo-500': openTab === 1 }" 
             class="relative flex flex-col w-full select-none transition-all">
          <button 
            @click="openTab = 1" 
            type="button" 
            class="relative z-20 py-1 my-2 inline-flex items-center text-sm font-medium cursor-pointer px-3 text-white text-left">
            <h3 class="ml-1">Design your pass</h3>
          </button>
          <div x-show="openTab === 1" 
               x-transition:enter="transition duration-500" 
               x-transition:enter-start="opacity-0 transform -translate-y-2" 
               x-transition:enter-end="opacity-100 transform translate-y-0" 
               x-transition:leave="transition duration-500" 
               x-transition:leave-start="opacity-100 transform translate-y-0" 
               x-transition:leave-end="opacity-0 transform -translate-y-2">
            <p class="px-4">Choose a template and customize it with your branding, colors, and content using our intuitive visual editor. No coding required.</p>
          </div>
        </div>

        <!-- TAB 2 -->
        <div :class="{ 'border-l-2 border-indigo-500': openTab === 2 }" 
             class="relative flex flex-col w-full select-none transition-all">
          <button 
            @click="openTab = 2" 
            type="button" 
            class="relative z-20 py-1 my-2 inline-flex items-center text-sm font-medium cursor-pointer px-3 text-white text-left">
            <h3 class="ml-1">Configure settings</h3>
          </button>
          <div x-show="openTab === 2" 
               x-transition:enter="transition duration-500" 
               x-transition:enter-start="opacity-0 transform -translate-y-2" 
               x-transition:enter-end="opacity-100 transform translate-y-0" 
               x-transition:leave="transition duration-500" 
               x-transition:leave-start="opacity-100 transform translate-y-0" 
               x-transition:leave-end="opacity-0 transform -translate-y-2">
            <p class="px-4">Set up pass behavior, expiration dates, locations, and notifications to create a dynamic experience.</p>
          </div>
        </div>

        <!-- TAB 3 -->
        <div :class="{ 'border-l-2 border-indigo-500': openTab === 3 }" 
             class="relative flex flex-col w-full select-none transition-all">
          <button 
            @click="openTab = 3" 
            type="button" 
            class="relative z-20 py-1 my-2 inline-flex items-center text-sm font-medium cursor-pointer px-3 text-white text-left">
            <h3 class="ml-1">Distribute & analyze</h3>
          </button>
          <div x-show="openTab === 3" 
               x-transition:enter="transition duration-500" 
               x-transition:enter-start="opacity-0 transform -translate-y-2" 
               x-transition:enter-end="opacity-100 transform translate-y-0" 
               x-transition:leave="transition duration-500" 
               x-transition:leave-start="opacity-100 transform translate-y-0" 
               x-transition:leave-end="opacity-0 transform -translate-y-2">
            <p class="px-4">Share passes via email, SMS, QR codes, or direct links, then track performance with detailed analytics.</p>
          </div>
        </div>
      </div>

      <!-- Images -->
      <div class="w-3/5 hidden md:inline">
        <template x-if="openTab === 1">
          <img src="../assets/wallet/design_your_pass.webp" alt="Design your pass" class="rounded-2xl mx-auto shadow-vulcan-950/50 w-full" loading="lazy">
        </template>
        <template x-if="openTab === 2">
          <img src="../assets/wallet/config.webp" alt="Configure settings" class="rounded-2xl mx-auto shadow-vulcan-950/50 w-full" loading="lazy">
        </template>
        <template x-if="openTab === 3">
          <img src="../assets/wallet/distribute.webp" alt="Distribute & analyze" class="rounded-2xl mx-auto shadow-vulcan-950/50 w-full" loading="lazy">
        </template>
      </div>
    </div>
  </div>
</section>
