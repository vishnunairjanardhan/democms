---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-y border-white/5">
  <div class="hidden pt-2 lg:block">
 
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="text-center max-w-2xl  lg:mt-0 mx-auto">
      <h2 class="text-3xl font-normal tracking-tight text-balance ">What makes us unique</h2>
    </div>
    <div class="grid grid-cols-1 mt-16 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-3 gap-x-10 lg:mx-8">
      <div   class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-950/9 bg-gradient-to-b from-slate-800/5 via-indigo-500/5">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
            <div class="text-indigo-400 w-12 h-12">
              <img class="" alt="use gift card software for easy redemption" loading="lazy" src="/assets/about-us/Complete-solution.svg">
            </div>
            <h3 class="mt-5 text-xl ">
                Complete Solution
            </h3>
            <p class="mt-2 text-base">Maximize customer engagement with effortless reward and gift management.</p>
          </div>
        </div>
      </div>
      <div   class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-950/9 bg-gradient-to-b from-slate-800/5 via-indigo-500/5">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-12 h-12">
              <img class="" alt="create gift cards to improve cash flow" loading="lazy" src="/assets/about-us/Omnichannel.svg">
            </div>
          <h3 class="mt-5 text-xl ">
            Omnichannel Experience
          </h3>
          <p class="mt-2 text-base">Reach your customers wherever they are with seamless integration across multiple channels.</p>
        </div>
      </div>
      <div   class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-950/9 bg-gradient-to-b from-slate-800/5 via-indigo-500/5">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
          <div class="text-indigo-400 w-12 h-12">
              <img class="" alt="Retain users with gift card software" loading="lazy" src="/assets/about-us/Personalized-promotion.svg">
            </div>
            <h3 class="mt-5 text-xl ">
                Personalized Promotions
            </h3>
            <p class="mt-2 text-base">Create personalized campaigns with automated data-driven incentives for customers.</p>
          </div>
        </div>
      </div>
    </div>
<div class="lg:flex gap-2 mt-20 justify-center">
             <div x-data="{ open: false }" class="flex">
              <!-- Trigger -->
              <a type="button" href="/Get-Started" role="button" aria-label="Get Started for Free" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                  <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                  <span class="relative text-white">Sign Up for Free</span> </span>
              </a>
            </div>


  </div>
</section>



