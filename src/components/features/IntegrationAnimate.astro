   <style>
   
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }
  
 
  .main-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  gap: 180px; 
}
  
    
    .text-container {
      max-width: 400px;
    }
  
    .text-container h2 {
      font-size: 28px;
      margin-bottom: 15px;
      font-weight: bold;
      color: white;
    }
  
    .text-container p {
      font-size: 16px;
      line-height: 1.6;
      color: gray;
    }
  
    
  .container {
  width: 350px;
  height: 350px;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40px; 
  margin-bottom: 40px; 
}
  
    .circle {
      list-style: none;
      margin: 0;
      padding: 0;
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  
    .circle li {
      position: absolute;
      width: 80px;
      height: 80px;
      padding: 10px;
      background-color: gray;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      transform-origin: center 150px;
      animation: moveToPosition 1s ease-in-out forwards;
    }
  
    .circle li img {
      width: auto;
      height: 35px;
    }
  
    .center-logo {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100px;
      height: 100px;
      background-color: gray;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
  
    .center-logo img {
      width: auto;
      height: 40px;
    }
  
    @keyframes moveToPosition {
      0% {
        transform: rotate(0deg) translate(0px) rotate(0deg);
      }
      100% {
        transform: rotate(var(--final-rotation)) translate(150px) rotate(calc(-1 * var(--final-rotation)));
      }
    }
  
    .circle li:nth-child(1) {
      --final-rotation: 0deg;
      animation-delay: 0s;
    }
    .circle li:nth-child(2) {
      --final-rotation: 45deg;
      animation-delay: 0.1s;
    }
    .circle li:nth-child(3) {
      --final-rotation: 90deg;
      animation-delay: 0.2s;
    }
    .circle li:nth-child(4) {
      --final-rotation: 135deg;
      animation-delay: 0.3s;
    }
    .circle li:nth-child(5) {
      --final-rotation: 180deg;
      animation-delay: 0.4s;
    }
    .circle li:nth-child(6) {
      --final-rotation: 225deg;
      animation-delay: 0.5s;
    }
    .circle li:nth-child(7) {
      --final-rotation: 270deg;
      animation-delay: 0.6s;
    }
    .circle li:nth-child(8) {
      --final-rotation: 315deg;
      animation-delay: 0.7s;
    }
  
    .circle li img {
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
  
    .circle li:hover img {
      transform: scale(1.2);
      opacity: 0.9;
    }
  
   
    @media (max-width: 768px) {
  .main-container {
    flex-direction: column;
    gap: 40px;
  }

  .text-container {
    text-align: center;
  }

  .container {
    width: 300px;
    height: 300px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .circle li {
    width: 60px;
    height: 60px;
  }

  .center-logo {
    width: 80px;
    height: 80px;
  }

  .center-logo img {
    height: 30px;
  }
}

@media (max-width: 480px) {
  .text-container h2 {
    font-size: 18px;
  }

  .text-container p {
    font-size: 12px;
  }

  .container {
    width: 250px;
    height: 250px;
    margin-top: 40px;
    margin-bottom: 40px;
  }

  .circle li {
    width: 50px;
    height: 50px;
  }

  .center-logo {
    width: 60px;
    height: 60px;
  }

  .center-logo img {
    height: 20px;
  }

  .main-container {
    gap: 50px;
  }
}
