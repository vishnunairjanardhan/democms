    x-data="{
      activeTab: 1,    
      activeSlide: 1,   
      totalSlides: 3,
      totalTabs: 5,   
      interval: null,
      autoSlideEnabled: false,
      nextTab() {
        this.activeTab++;
        if (this.activeTab > this.totalTabs) {
          this.activeTab = 1; 
        }
        this.slideIndex = 1; 
        this.stopAutoSlide(); 
      },
      prevTab() {
        this.activeTab--;
        if (this.activeTab < 1) {
          this.activeTab = this.totalTabs; 
        }
        this.slideIndex = 1; 
        this.stopAutoSlide(); 
      },
      nextSlide() {
        this.slideIndex++;
        if (this.slideIndex > this.totalSlides) {
          this.slideIndex = 1; 
        }
      },
      prevSlide() {
        this.slideIndex--;
        if (this.slideIndex < 1) {
          this.slideIndex = this.totalSlides; 
        }
      },
      startAutoSlide() {
        this.interval = setInterval(() => {
          this.nextSlide();
        }, 3000); 
      },
      stopAutoSlide() {
        clearInterval(this.interval);
        this.interval = null; 
      },
      checkScreenSize() {
        const isMobileView = window.innerWidth < 640;
        if (isMobileView && !this.autoSlideEnabled) {
          this.autoSlideEnabled = true;
          this.startAutoSlide();
        } else if (!isMobileView && this.autoSlideEnabled) {
          this.autoSlideEnabled = false;
          this.stopAutoSlide(); 
        }
      },
      init() {
        this.checkScreenSize(); 
        window.addEventListener('resize', this.checkScreenSize.bind(this)); 
      }
    }"
    x-init="init()"
