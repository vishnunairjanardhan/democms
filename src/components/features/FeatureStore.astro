---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-y border-white/5">
  <div class="hidden pt-2 lg:block">
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-8 lg:py-16">
    <!--<div  data-aos="fade-down" data-aos-duration="3000" class="text-center max-w-2xl  lg:mt-0 mx-auto">
      <h2 class="text-3xl font-normal tracking-tight text-balance text-white">Drive Revenue with Gift Card Program</h2>
    </div>-->
    <div class="grid grid-cols-1 mt-16 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-1 lg:grid-cols-1 gap-x-10 lg:mx-8">
      <div data-aos="fade-up" data-aos-duration="1500" class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5">
        <div class="h-full p-8 bg-vulcan-900 rounded-3xl flex flex-col justify-between">
          <div class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-8 items-center">
            <div data-aos="fade-right" data-aos-duration="3000" class="">
        <h2 class="">
           99minds platform
        </h2>
        <p class="mt-4">Drive trial and encourage repeat purchases through cashback incentives, built entirely within your users' text messages.</p>
         <ul class="mt-4">
            <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">Create and manage your promotions on our platform</p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2  leading-6 ">Build a custom-branded experience for your customers</p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2  leading-6 ">Integrate offers into your existing marketing channels</p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6 ">Instantly drive trial and access real-time data</p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6 ">Foster customer loyalty by encouraging repeat purchases</p>
              </div>
            </li>
          </ul>
          <div class="lg:flex gap-2 mt-10 lg:ml-6">
             <div x-data="{ open: false }" class="flex">
              <!-- Trigger -->
              <span x-on:click="open = true">
                 <button type="button" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium raise">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                <span class="relative text-white">Sign up for free</span>
                </span></button>
                                <!---<button type="button" class="flex items-center justify-center w-full h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700"> Subscribe </button>--->
              </span>
              <!-- Modal -->
              <div x-show="open" x-on:keydown.escape.prevent.stop="open = false" role="dialog" aria-modal="true" x-id="['modal-title']" :aria-labelledby="$id('modal-title')" class="fixed inset-0 z-50 w-screen overflow-y-auto " aria-labelledby="modal-title-5">
                <!-- Overlay -->
                <div x-show="open" x-transition.opacity="" class="fixed inset-0 bg-vulcan-950 bg-opacity-50" style="display: none;"></div>
                <!-- Panel -->
                <div x-show="open" x-transition="" x-on:click="open = false" class="relative flex min-h-screen items-center justify-center p-4" style="display: none;">
                  <div x-on:click.stop="" x-trap.noscroll.inert="open" class="relative w-full max-w-3xl overflow-y-auto bg-gradient-to-b from-indigo-500 via-indigo-500/5 shadow-2xl rounded-3xl p-[0.060rem]">
                    <div class="bg-vulcan-900 rounded-3xl p-10 text-center">
                      
                    <iframe
                      src="../GetStarted"
                      width="100%"
                      height="600"
                      frameBorder="0"
                      allowFullScreen
                      title="Calendly"
                    ></iframe>

                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
      </div>
      
      <div data-aos="zoom-in" data-aos-duration="3000" class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl <!---shadow-2xl---> shadow-vulcan-950/50 w-full"
          src="/assets/giftcard_1.png"
        />
      </div>
    </div>
    
        </div>
      </div>
    </div>



  </div>
</section>



