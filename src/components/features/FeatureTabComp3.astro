<section class="relative overflow-x-hidden border-y border-white/5">
    <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 shadow-2xl rounded-3xl">
	
	<div x-data="{
        tabSelected: 1,
        tabId: $id('tabs'),
        totalTabs: 3, 
        intervalId: null,
        
        tabButtonClicked(tabButton) {
            clearInterval(this.intervalId); 
            this.tabSelected = tabButton.id.replace(this.tabId + '-', '');
            this.tabRepositionMarker(tabButton);
            this.startAutoScroll();
        },
        
        tabRepositionMarker(tabButton) {
            this.$refs.tabMarker.style.width = tabButton.offsetWidth + 'px';
            this.$refs.tabMarker.style.height = tabButton.offsetHeight + 'px';
            this.$refs.tabMarker.style.left = tabButton.offsetLeft + 'px';
        },

        tabContentActive(tabContent) {
            return this.tabSelected == tabContent.id.replace(this.tabId + '-content-', '');
        },
        
        startAutoScroll() {
            this.intervalId = setInterval(() => {
                this.tabSelected = (this.tabSelected % this.totalTabs) + 1;
                let tabButton = document.getElementById(this.tabId + '-' + this.tabSelected);
                this.tabRepositionMarker(tabButton);
            }, 4000);
        },

        stopAutoScroll() {
            clearInterval(this.intervalId);
        }
    }" 
    x-init="tabRepositionMarker($refs.tabButtons.firstElementChild); startAutoScroll();" 
    class="relative mt-10">
		
		<div class="relative lg:flex lg:flex-row lg:border lg:border-gray-700 rounded-xl items-center justify-center lg:gap-5 lg:w-[50rem] w-16 h-16 mx-auto text-black select-none hidden" x-ref="tabButtons">
            <button class="relative z-20 inline-flex items-center gap-2 w-auto lg:h-10 text-sm p-2 font-medium cursor-pointer transition-all whitespace-nowrap" type="button" :class="{ 'border-b-2 border-indigo-500': tabButtonActive($el) }" :id="$id(tabId)" @click="tabButtonClicked($el);" >
                Design your pass
            </button>
            <button class="relative z-20 inline-flex p-2 w-auto h-10 gap-2 text-sm font-medium transition-all cursor-pointer items-center whitespace-nowrap" type="button" :class="{ 'border-b-2 border-indigo-500': tabButtonActive($el) }" :id="$id(tabId)" @click="tabButtonClicked($el);">
                Configure push notification
            </button>
            <button class="relative z-20 inline-flex p-2 w-auto h-10 gap-2 text-sm font-medium transition-all cursor-pointer items-center whitespace-nowrap" type="button" :class="{ 'border-b-2 border-indigo-500': tabButtonActive($el) }" :id="$id(tabId)" @click="tabButtonClicked($el);">
               Distribute & analyze
            </button>
            <div class="absolute left-0 z-10 w-full h-full duration-300 ease-out" x-ref="tabMarker" style="width: 76px; height: 32px; left: 0px;">
                <div class="w-full h-full rounded-lg bg-white border-2 border-gray-800"></div>
            </div>
        </div>

		<div class="relative w-full pt-8 content overflow-x-auto lg:overflow-visible">
            <div :id="$id(tabId + '-content')" x-show="tabContentActive($el)" class="relative flex-shrink-0 lg:flex-shrink" id="tabs-3-content-1" style="display: none;">
            <section class="w-full max-w-4xl mx-auto overflow-hidden rounded-2xl flex flex-col lg:flex-row gap-6">
            <div class="lg:w-1/2 text-center lg:text-left">
                <h3 class="font-medium">Design your pass</h3>
            <p class="text-xl max-w-xl mx-auto">
             Choose a template and customize it with your branding, colors, and content using our intuitive visual editor. No coding required
           </p>
         </div>
          <div class="lg:w-1/2">
           <img src="../assets/wallet/design_your_pass.webp" alt="Background Image" class="w-full h-auto object-cover rounded-xl">
          </div>
        </section>

            </div>
            <div :id="$id(tabId + '-content')" x-show="tabContentActive($el)" class="relative flex-shrink-0 lg:flex-shrink" id="tabs-3-content-2" style="display: none;">
            <section class="w-full max-w-4xl mx-auto overflow-hidden rounded-2xl flex flex-col lg:flex-row gap-6">
             <div class="lg:w-1/2 text-center lg:text-left">
                <h3 class="font-medium">Configure push notification</h3>
              <p class="text-xl max-w-xl mx-auto">
               Set up pass behavior, expiration dates, locations, and notifications to create a dynamic experience.
              </p>
             </div>
              <div class="lg:w-1/2">
               <img src="../assets/wallet/config.webp" alt="Background Image" class="w-full h-auto object-cover rounded-xl">
            </div>
          </section>

            </div>
            <div :id="$id(tabId + '-content')" x-show="tabContentActive($el)" class="relative flex-shrink-0 lg:flex-shrink" id="tabs-3-content-3" style="display: none;">
            <section class="w-full max-w-4xl mx-auto overflow-hidden rounded-2xl flex flex-col lg:flex-row gap-6">
             <div class="lg:w-1/2 text-center lg:text-left">
                <h3 class="font-medium"> Distribute & analyze</h3>
             <p class="text-xl max-w-xl mx-auto">
              Share passes via email, SMS, QR codes, or direct links, then track performance with detailed analytics.
            </p>
           </div>
           <div class="lg:w-1/2">
           <img src="../assets/wallet/distribute.webp" alt="Background Image" class="w-full h-auto object-cover rounded-xl">
          </div>
         </section>
       </div>
     </div>
    </div>
  </div>
</section>
