---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative bg-[#f9f9f9]">
  
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]">
    <div class="text-center max-w-2xl  lg:mt-0 mx-auto">
      <h2 class="font-medium">How its work</h2>
    </div>
    <div class="grid grid-cols-1 mt-8 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-4 gap-x-10 lg:px-0 px-4">
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="use gift card software for easy redemption" loading="lazy" src="/assets/partners-program/Verified.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Apply & get Verified
            </h3>
            <p class="mt-2 text-base">Complete a quick application in partner network.</p>
          </div>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="create gift cards to improve cash flow" loading="lazy" src="/assets/partners-program/Onboard.svg">
            </div>
          <h3 class="mt-5 text-xl text-black">
            Onboard and Certify
          </h3>
          <p class="mt-2 text-base">Access to trambling ans certification resources.</p>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="create gift cards to improve cash flow" loading="lazy" src="/assets/partners-program/refer.svg">
            </div>
          <h3 class="mt-5 text-xl text-black">
            Refer or Integrate
          </h3>
          <p class="mt-2 text-base">Refer new merchants constnunce our solutions.</p>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
          <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="Retain users with gift card software" loading="lazy" src="/assets/partners-program/scale.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Earn & Scale
            </h3>
            <p class="mt-2 text-base">Recieve commisions start your business.</p>
          </div>
        </div>
      </div>
    </div>

</section>



