---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-white/5">
<Verticalgrid />
  <div class="hidden pt-12 lg:block">
  
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-6">
    <div class="text-center max-w-6xl mx-auto">
      <h2 class="mt-8">Seamless In-store and Online Integration for Lightspeed
        <p class="mt-4 text-base">
        99minds is perfectly suited for omnichannel lightspeed users. Effortlessly implement your marketing strategy across all your locations by integrating with both your Point-of-Sale and eCommerce systems. It is crafted to streamline your operations, boost your sales, and significantly save time.
        </p>
    </div>
     <div class="flex mx-auto mt-6 justify-center col-span-full max-w-7xl">
        <img
          class="text-center" width="768" height="626"
          src="/assets/lightspeed/lightspeed-Int.svg"
          alt="99minds integrations for Lightspeed"
          loading="lazy"
        />
      </div>
  </div>
</section>