---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-white/5">
<Verticalgrid />
  <div class="hidden pt-12 lg:block">
  
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-6">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="mt-8 lg:text-4xl text-3xl font-normal tracking-tight text-balance text-white">Seamless in-store and online integration for Lightspeed
        <p class="max-w-4xl mt-4 text-base text-vulcan-300">
        99minds is perfectly suited for omnichannel lightspeed users. Effortlessly implement your marketing strategy across all your locations by integrating with both your Point-of-Sale and eCommerce systems. It is crafted to streamline your operations, boost your sales, and significantly save time.
        </p>
    </div>
    <div class="relative lg:mt-8 items-center lg:w-2/3 pb-0 mx-auto overflow-hidden max-w-7xl" style="">
        <img
          class="object-cover w-full"
          src="/assets/lightspeed-Int.svg"
          alt="99minds integrations for Lightspeed"
        />
      </div>
  </div>
</section>