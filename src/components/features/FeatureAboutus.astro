---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-black/5">
 
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-16">
  <div class="text-center max-w-2xl mx-auto">
      <h2>Crafted by Merchants for Merchants</h2>
    </div>
        <div class="mt-8 max-w-7xl" >
            <p class="mt-4">"Happy customers are loyal customers, and that's what 99minds and HubSpot aim to achieve. Imagine keeping your best customers delighted and engaged consistently. By integrating 99minds with HubSpot, you can effortlessly sync customer data, create targeted segments, and launch hyper-personalized marketing campaigns." <b class="text-indigo-500">- Pravin, CEO at 99minds</b></p>
        </div>
    
   <div class="grid grid-cols-1 mt-16 gap-y-10 md:grid-cols-2 gap-x-10 max-w-6xl mx-auto px-4 lg:px-8">
    
  <div   class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl bg-gradient-to-b from-slate-800/5 via-indigo-500/5">
    <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
      <div class="flex flex-col items-center text-center">
        <img src="/assets/testimonial/Pravin.png" alt="Pravin" class="h-24 w-24 rounded-full object-cover shadow-md" />
        <h3 class="mt-4 text-xl font-semibold text-gray-800">Pravin</h3>
        <p class="text-sm text-gray-500">Co-Founder & CEO</p>
        <p class="mt-3 text-base text-gray-700">
           Pravin is the driving force behind the vision and strategy of the company, combining leadership and innovation to build impactful products.
        </p>
        <a
          href="https://www.linkedin.com/in/pravinkamble/"
          target="_blank"
          class="mt-4 inline-block text-indigo-600 hover:underline font-medium"
        >
          LinkedIn Profile →
        </a>
      </div>
    </div>
  </div>


  <div   class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl bg-gradient-to-b from-slate-800/5 via-indigo-500/5">
    <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
      <div class="flex flex-col items-center text-center">
        <img src="/assets/testimonial/Mrudul.png" alt="Mrudul" class="h-24 w-24 rounded-full object-cover shadow-md" />
        <h3 class="mt-4 text-xl font-semibold text-gray-800">Mrudul</h3>
        <p class="text-sm text-gray-500">Chief Technology Officer (CTO)</p>
        <p class="mt-3 text-base text-gray-700">
         Mrudul leads the technology strategy, ensuring scalable architecture and robust engineering practices across all products.
        </p>
        <a
          href="https://www.linkedin.com/in/mrudult/"
          target="_blank"
          class="mt-4 inline-block text-indigo-600 hover:underline font-medium"
        >
          LinkedIn Profile →
        </a>
      </div>
    </div>
  </div>
</div>


    
      </div>
</div>
  </div>
  
</section>



