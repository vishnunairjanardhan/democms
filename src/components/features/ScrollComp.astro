                                            <div class="lg:flex lg:h-full lg:items-center">
                                                <div class="w-full lg:w-[38rem] mb-6 lg:mb-0 px-4">
                                                    <div class="ml-4 h-9">
                                                        <img class="h-12" alt="Group" src="/assets/testimonial/MudAustralia-logo.svg" />
                                                    </div>
                                                    <div class="grid grid-cols-2 w-full mt-10 gap-4">
                                                        <div class="flex flex-col w-full">
                                                            <div class="p-4 rounded-3xl text-white">
                                                                <h3 class="font-semibold text-2xl md:text-3xl lg:text-4xl">$1</h3>
