        class="px-2 py-6 md:px-4 md:py-6 w-full">
        <span class="text-2xl">Viva Raw</span>
    </button>
      </div>
  
        
        <!-- Tab contents on the right -->
        <div class="relative w-full lg:h-full overflow-y-hidden" x-ref="tabsContainer">
            <div class="flex flex-col space-y-6 pl-4 transition-transform duration-500">
