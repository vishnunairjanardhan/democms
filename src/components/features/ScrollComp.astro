          <span class="text-2xl">Real stories</span><br /> 
          See it to believe it.
        </h2>
      </div>
      <div x-data="{ 
        activeTab: 1, 
        observeTabs() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const tabNumber = parseInt(entry.target.dataset.tab, 10);
                        this.activeTab = tabNumber;
                    }
                });
            }, { threshold: 0.5 });
    
            document.querySelectorAll('.tab-content').forEach(tab => observer.observe(tab));
        },
        scrollToTab(tabNumber) {
            this.activeTab = tabNumber;
            const selectedContent = this.$refs[`tab${tabNumber}`];
            const container = this.$refs.tabsContainer;
    
            if (selectedContent && container) {
                // Calculate the top position of the selected tab content relative to the container
                const containerScrollTop = container.scrollTop;
                const containerTop = container.getBoundingClientRect().top;
                const contentTop = selectedContent.getBoundingClientRect().top;
    
                // Calculate the new scroll position to align selected content to the top of the container
                const scrollPosition = containerScrollTop + contentTop - containerTop;
    
                // Scroll container smoothly to the calculated position
                container.scrollTo({ top: scrollPosition, behavior: 'smooth' });
    
                // Optional: Ensure that the selected content is fully visible by adding the height of the container
                const containerHeight = container.clientHeight;
                const selectedContentHeight = selectedContent.clientHeight;
                
                // Ensure the previous tab is completely scrolled into view
                const ensureFullyVisiblePosition = scrollPosition + selectedContentHeight > containerScrollTop + containerHeight
                    ? scrollPosition - (selectedContentHeight - containerHeight)
                    : scrollPosition;
    
                container.scrollTo({ top: ensureFullyVisiblePosition, behavior: 'smooth' });
            } else {
                console.error('Selected content or container not found for tab:', tabNumber);
            }
        }
    }" 
