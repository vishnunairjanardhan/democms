---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="lg:p-8 border-t border-y border-white/5">
    <div class="mx-auto 2xl:max-w-7xl py-12 lg:px-24 md:px-12 px-6 sm:px-4 items-center w-full">
      <div class="mx-auto text-center lg:py-8">
        <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-white">
          <span class="text-2xl">Real stories</span><br /> 
          See it to believe it.
        </h2>
      </div>
      <div class="flex flex-row w-full lg:px-2" x-data="{ 
        activeTab: 1, 
        scrollToTab() { 
            this.$nextTick(() => {
                const content = this.$refs[`tab${this.activeTab}`];
                if (content) content.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        } 
  }">
      <!-- Buttons on the left -->
      <div class="flex flex-col items-start mr-4 mt-6">
        <button @click="activeTab = 1; scrollToTab();" 
        :class="{ 'text-black bg-green-200 border-2 border-gray-500 font-bold rounded-3xl mt-6': activeTab === 1, 'text-gray-400 border border-gray-500 rounded-3xl mt-6': activeTab !== 1 }" 
        class="px-2 py-6 md:px-4 md:py-6 w-full">
        <span class="text-2xl">Dr. Squatch</span>
    </button>
    <button @click="activeTab = 2; scrollToTab();" 
        :class="{ 'text-black bg-green-200 border-2 border-gray-500 font-bold rounded-3xl mt-6': activeTab === 2, 'text-gray-400 border border-gray-500 rounded-3xl mt-6': activeTab !== 2 }" 
        class="px-2 py-6 md:px-4 md:py-6 w-full">
        <span class="text-2xl">Cozy Earth</span>
    </button>
    <button @click="activeTab = 3; scrollToTab();" 
        :class="{ 'text-black bg-green-200 border-2 border-gray-500 font-bold rounded-3xl mt-6': activeTab === 3, 'text-gray-400 border border-gray-500 rounded-3xl mt-6': activeTab !== 3 }" 
        class="px-2 py-6 md:px-4 md:py-6 w-full">
        <span class="text-2xl">Chamberlain</br>Coffee</span>
    </button>
    <button @click="activeTab = 4; scrollToTab();" 
        :class="{ 'text-black bg-green-200 border-2 border-gray-500 font-bold rounded-3xl mt-6': activeTab === 4, 'text-gray-400 border border-gray-500 rounded-3xl mt-6': activeTab !== 4 }" 
        class="px-2 py-6 md:px-4 md:py-6 w-full">
        <span class="text-2xl">Hiya</span>
    </button>
