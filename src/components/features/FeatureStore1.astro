---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
        <div data-aos="fade-down" data-aos-duration="3000" class="mx-auto lg:text-center px-8 lg:py-2">
          <!--<h2 class="mt-24">
            Gift Card & Platform features.
          </h2>
          <p class="font-body text-xl xl:text-2xl mt-4">
              All your gift card needs, covered</br>
          </p>-->
        </div>
       
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-8">
   <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-right" data-aos-duration="3000" class="">
        <h2 class="">
           Omnichannel attribution
        </h2>
        <p class="mt-4">Utilize real-time retail data to link offline purchases to any marketing channel, providing clear ~omnichannel~ attribution and customer-level reporting.</p>
          <!---<div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div>--->
          <div class="flex flex-wrap">
  <button type="button" class="flex flex-col items-center justify-center w-auto mt-4 h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">Outlined button</button>
  <button type="button" class="flex flex-col items-center justify-center w-auto lg:ml-2 mt-4 h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">Outlined button</button>
  <button type="button" class="flex flex-col items-center justify-center w-auto lg:ml-2 mt-4 h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">Outlined button</button>
</div>
      </div>
      
      <div data-aos="zoom-in" data-aos-duration="3000" class="h-full" style="width:800px;height:auto;">
        <img role="img" loading="lazy" class="object-cover -mb-12  rounded-xl border-white/5 lg:rounded-3xl shadow-vulcan-950" width="1280" height="739" src="/assets/homepage/Workflow1.webp" alt="Workflows for Shopify gift cards and loyalty program">
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-left" data-aos-duration="3000" class="sm:order-last">
        <h2 class="">
          Integrate with your favourite POS
        </h2>
        <p class="mt-4">Issue and track gift cards with any popular POS (Point of Sale) like Square, Lightspeed, Heartland Retail, and more. Having gift card software will help you sell, redeem, reload, and check the balance of your customer's physical or digital gift cards.
        </p>
      </div>
      <div data-aos="zoom-in" data-aos-duration="3000" class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/Pos.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-right" data-aos-duration="3000" class=" ">
        <h2>
          Analyse Gift Card Data
        </h2>
         <p class="mt-4">Keep an eye on customer data and gift card usage. Track and analyse the entire gift card life cycle, from issuance to order-level redemption. Use this data to break down user behaviour and set up engaging campaigns.</p> 
      </div>
      <div data-aos="zoom-in" data-aos-duration="3000" class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/report.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-left" data-aos-duration="3000" class="sm:order-last  ">
        <h2>
          Schedule Delivery & Gift card for Out of Stock inventory
        </h2>
        <ul class="mt-4">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6">Out of stock gift card to retain customer
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 leading-6 ">Gift card balance reminder email to customer
              </p></div>
           </li>
        </ul>
      </div>
      <div  data-aos="zoom-in" data-aos-duration="3000" class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/schedule.png"
        />
      </div>
    </div>
  </div>
</section>
