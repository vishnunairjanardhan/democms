<section class="bg-white border-y border-white/5 py-20">
  <div class="px-8 mx-auto md:px-12 lg:px-16 max-w-7xl">
    <!-- Heading -->
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="font-medium text-2xl md:text-3xl">The Ultimate Gift Card Software</h2>
      <p class="mt-5 text-gray-600">Create gift card programs that consider all the nitty-gritty of your business.</p>
    </div>

    <!-- Flip Card Grid -->
    <div class="grid gap-8 mt-16 sm:grid-cols-2 lg:grid-cols-3"
         x-data="{
           features: [
             {
               title: 'Create Gift Cards In Bulk',
               text: 'Need thousands of gift cards? Create 1000 gift cards at once with 99minds.',
               image: '/assets/giftcard/bulk-giftcard1.webp'
             },
             {
               title: 'Seamless Migration and Import',
               text: 'Migrate from any existing gift card software and import balances with ease.',
               image: '/assets/giftcard/import-migration1.webp'
             },
             {
               title: 'Multiple Currency Support',
               text: 'Support for 100+ currencies including USD, CAD, EUR, GBP, KRW, JPY, and CNY.',
               image: '/assets/giftcard/multi-currency1.webp'
             },
             {
               title: 'Multi-store',
               text: 'Gift cards usable across multiple stores with valuable analytics insights.',
               image: '/assets/giftcard/multi-store1.webp'
             },
             {
               title: 'Manage Returns with Gift Cards',
               text: 'Issue cards on returns or update balances in existing gift cards.',
               image: '/assets/giftcard/refund-giftcard.png'
             },
             {
               title: 'Delivery for Special Occasions',
               text: 'Schedule delivery for birthdays, anniversaries, Christmas, or any celebration.',
               image: '/assets/giftcard/schedule-delivery1.webp'
             }
           ]
         }">
      
      <template x-for="(feature, i) in features" :key="i">
        <div class="relative group [perspective:1000px]" x-data="{ flipped: false }">
          <!-- Card wrapper -->
          <div class="relative w-full h-72 transition-transform duration-700 [transform-style:preserve-3d]" 
               :class="flipped ? '[transform:rotateY(180deg)]' : ''"
               @click="flipped = !flipped">
            
            <!-- Front Side -->
            <div class="absolute inset-0 flex flex-col justify-center items-center rounded-2xl shadow-lg bg-indigo-600 text-white p-6 [backface-visibility:hidden]">
              <div class="text-4xl mb-4">🎁</div>
              <h3 class="text-lg font-semibold text-center" x-text="feature.title"></h3>
              <p class="mt-3 text-sm opacity-80 text-center">Click to flip</p>
            </div>

            <!-- Back Side -->
            <div class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl shadow-lg bg-white p-6 [transform:rotateY(180deg)] [backface-visibility:hidden]">
              <img :src="feature.image" :alt="feature.title" class="w-full h-32 object-cover rounded-lg mb-4">
              <p class="text-gray-700 text-sm text-center" x-text="feature.text"></p>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</section>
