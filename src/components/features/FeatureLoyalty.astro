      <div class="2xl:p-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Select activities for earning Points
        </h2>
        <p class="font-semibold mt-4 text-base text-vulcan-300">
              Earning Points for more than just purchases
        </p>
