---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative border-t border-y border-black/5 bg-[#FEFCF5]">
  <Verticalgrid />
  <div class="justify-center text-center px-8 mx-auto max-w-7xl md:px-12 lg:px-24 lg:pt-12">
        <h2 class="mt-8 font-medium">
          Build an effective Customer loyalty programs right for your brand 
        </h2>
         <p class="font-body text-xl mt-4">
            All your required key features under one roof</br>
        </p>
        </div>
 <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24  md:space-y-24 space-y-5">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
           Custom Loyalty Program
        </h2>
        <p class="mt-4 font-semibold">Design Loyalty program right for your brand</p>
        <div class="gap-3 mt-10">
         <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
