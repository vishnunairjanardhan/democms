---
import Verticalgrid from "../assets/Verticalgrid.astro";
import CaseStudyTab from "../../components/features/CaseStudyTab.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
---
<section class="relative bg-white">
  <Verticalgrid />
  <div class="relative px-8 py-[72px] mx-auto max-w-7xl md:px-12 lg:px-16 lg:pt-36">
    <div class="flex justify-center items-center">
      <div class="max-w-2xl text-center mt-4">
        <span class="text-xs font-medium tracking-widest text-transparent uppercase bg-clip-text bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700">
          CASE STUDIES
        </span>
        <h1 class="lg:mt-8 text-4xl font-semibold tracking-tighter text-gray-900 sm:text-5xl">
          <span class="block">Customer Success Stories</span>
        </h1>
        <p class="max-w-xl mt-4 text-base text-gray-700">
          See how brands like yours built strong growth with 99minds.
        </p>
      </div>
    </div>
    
    <CaseStudyTab />
  </div>
</section>
