<section class="flex items-end justify-center bg-white border-y border-white/5" 
         x-data="{ openTab: 1, totalTabs: 6 }"
         x-init="setInterval(() => { openTab = openTab >= totalTabs ? 1 : openTab + 1 }, 5000)">
  <div class="px-8 mx-auto md:px-12 lg:px-16 max-w-7xl lg:py-24">
    <div class="text-center">
      <h2 class="font-medium">The Ultimate Gift Card Software</h2>
      <p class="mt-5">The devil is in the details. Create gift card programs that consider all the nitty-gritty of your business.</p>
    </div>

    <!-- Tabs Container -->
    <div class="flex items-start mt-20 -mb-px">
      <div class="border-l w-full">

        <!-- START: Loop through all 6 tabs -->
        <template x-for="tab in totalTabs" :key="tab">
          <div 
            :class="{ 'border-l-2 border-indigo-500': openTab === tab }"
            class="relative flex flex-col w-full select-none lg:flex-col lg:inline-grid md:flex-row"
          >
            <!-- Button -->
            <button 
              @click="openTab = openTab === tab ? null : tab"
              type="button"
              class="relative z-20 py-1 my-2 inline-flex items-center w-auto text-sm font-medium transition-all cursor-pointer px-3 text-white text-left"
              :id="`tabs-7-${tab}`"
            >
              <h3 class="ml-1" x-text="[
                'Create Gift Cards In Bulk',
                'Seamless Migration and Import',
                'Multiple Currency Support',
                'Multi-store',
                'Manage Returns with Gift Cards',
                'Gift Cards Delivery For Special Occasions'
              ][tab - 1]"></h3>
            </button>

            <!-- Text Content -->
            <div 
              x-show="openTab === tab"
              x-transition:enter="transition duration-500"
              x-transition:enter-start="opacity-0 transform -translate-y-2"
              x-transition:enter-end="opacity-100 transform translate-y-0"
              x-transition:leave="transition duration-500"
              x-transition:leave-start="opacity-100 transform translate-y-0"
              x-transition:leave-end="opacity-0 transform -translate-y-2"
            >
              <div class="relative items-center w-full">
                <div class="sm:order-1">
                  <p class="px-4" x-html="[
                    'Need thousands of gift cards? Create 1000 gift cards at once with 99minds.',
                    'We help you migrate from any existing gift card software to <br /> 99minds and even import existing gift card balances.',
                    'Get support for 100+ currencies, including USD, CAD, EUR, GBP, KRW, JPY, CNY and more.',
                    'Gift card can be used at multiple stores and provide valuable customer spending insights through analytics.',
                    'Issue gift cards on merchandise returns or update the balance in an existing gift card.',
                    'Schedule gift card delivery on special occasions like birthdays, anniversaries, Christmas, Hanukkah or any other.'
                  ][tab - 1]"></p>
                </div>
              </div>
            </div>
          </div>
        </template>
        <!-- END: Loop -->

      </div>

      <!-- Images -->
      <div class="w-3/4 hidden md:inline">
        <template x-for="tab in totalTabs" :key="tab">
          <div 
            x-show="openTab === tab"
            x-transition:enter="transition duration-500"
            x-transition:enter-start="opacity-0 transform -translate-y-2"
            x-transition:enter-end="opacity-100 transform translate-y-0"
            x-transition:leave-start="opacity-100 transform translate-y-0"
            x-transition:leave-end="opacity-0 transform -translate-y-2"
          >
            <div class="relative items-center w-full">
              <div class="sm:order-2">
                <img 
                  class="rounded-2xl shadow-vulcan-950/50 w-full"
                  loading="lazy"
                  :src="[
                    '/assets/giftcard/bulk-giftcard1.webp',
                    '/assets/giftcard/import-migration1.webp',
                    '/assets/giftcard/multi-currency1.webp',
                    '/assets/giftcard/multi-store1.webp',
                    '/assets/giftcard/refund-giftcard.png',
                    '/assets/giftcard/schedule-delivery1.webp'
                  ][tab - 1]"
                  :alt="'Tab image ' + tab"
                />
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>
</section>
