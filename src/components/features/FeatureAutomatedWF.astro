---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#FEFCF5]">
  <!--<div class="mx-auto lg:text-center lg:py-12">
        
        </div>-->
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px] md:space-y-24 space-y-5">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
           Centralize Data Platform
        </h2>
       <p class="mt-4">DConnect with Centralize Customer data from across customer touchpoints and the dozens of apps in your Brick & Mortar, eCommerce stack. Create workflow utilizing following key eCommerce customer attributes</p>
        <div class="gap-3 mt-10">
         <ul class="list-none" role="list">
            
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 ">
                  Average order value (AOV)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 ">
                  Customer lifetime value (CLV)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2  ">
                  Shopping Cart Abandonment Rate (CAR)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 ">
                  Net Promoter Score (NPS)
                </p>
              </div>
            </li>
          </ul>
          </div>
         
      </div>
      
      <div class="h-full">
        <img
          alt="Centralize Data Platform"
          loading="lazy"
          class="rounded-2xl w-full"
          src="/assets/automation/centralize1.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium mt-8 ">
          Pre-built Workflow Template
        </h2>
        <!---<p class="font-semibold mt-4 text-base text-vulcan-300">Set up landmarks to accomplish VIP status</p>--->
        <p class="mt-4">Utilize Average order value (AOV) boost, First Purchase reward, Out of Stock, Punch Card and Refund templates to run your program</p>
      </div>
      <div class="h-full">
        <img
          alt="Workflow"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/automation/prebuilt_workflow.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
          Boost Loyalty
        </h2>
          <div class="gap-3 mt-10">
         <ul class="list-none" role="list">        
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2  ">
                  Integrate rewards logic with data from your marketing & communication app.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-black icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2  ">
                  Connect your store to automate and run more personalized loyalty & reward programs.
                </p>
              </div>
            </li>
            </ul>
            </div> 
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/automation/automationloyalty1.webp"
        />
      </div>
    </div>
    
  </div>
</section>
