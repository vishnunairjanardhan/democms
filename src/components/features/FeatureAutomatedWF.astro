---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div class="mx-auto lg:text-center lg:py-12">
        <!---<h2 class="mt-8 text-white text-2xl xl:text-3xl 2xl:text-5xl font-normal tracking-tight text-white">
          Key Features
        </h2>
         <p class="font-body text-xl xl:text-2xl mt-4 text-vulcan-300 ">
            All your required key features under one roof</br>
        </p>--->
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-6">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div class=" ">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
           Centralize Data Platform
        </h2>
       <p class="mt-4 text-base text-vulcan-300">DConnect with Centralize Customer data from across customer touchpoints and the dozens of apps in your Brick & Mortar, eCommerce stack. Create workflow utilizing following key eCommerce customer attributes</p>
        <div class="gap-3 mt-10">
         <ul class="list-none" role="list">
            
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Average order value (AOV)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Customer lifetime value (CLV)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Shopping Cart Abandonment Rate (CAR)
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Net Promoter Score (NPS)
                </p>
              </div>
            </li>
          </ul>
          </div>
          <!--- <div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div> --->
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl w-full"
          src="/assets/automation/centralize.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Pre-built Workflow Template
        </h2>
        <!---<p class="font-semibold mt-4 text-base text-vulcan-300">Set up landmarks to accomplish VIP status</p>--->
        <p class="mt-4 text-base text-vulcan-300">Utilize Average order value (AOV) boost, First Purchase reward, Out of Stock, Punch Card and Refund templates to run your program</p>
        
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50 w-full"
          src="/assets/automation/automationBanner-1.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
          Boost Loyalty
        </h2>
          <div class="gap-3 mt-10">
         <ul class="list-none" role="list">        
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Integrate rewards logic with data from your marketing & communication app.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 text-base leading-6 text-vulcan-300">
                  Connect your store to automate and run more personalized loyalty & reward programs.
                </p>
              </div>
            </li>
            </ul>
            </div> 
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/automation/automationloyalty.png"
        />
      </div>
    </div>
    
  </div>
</section>
