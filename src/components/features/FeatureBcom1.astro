---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative scroll-mt-24">
  <Verticalgrid />
  <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-12 relative">
    <div class="mx-auto text-center">
      <p class="mt-8 text-3xl font-normal tracking-tight text-white">The tools you need to grow repeat sales</p>
      <p class="max-w-2xl mx-auto mt-4 text-base text-vulcan-300">Points, VIP, referrals, gift cards, store credit work seamlessly together to create the ultimate rewards program for your business.</p>
    </div>
    <div>
      <ul
        class="grid grid-cols-2 gap-8 mt-6 list-none md:grid-cols-3 lg:gap-12 lg:mt-24"
        role="list">
        <li>
          <div>
            <div class="text-indigo-400">
              <img alt="" class="w-8" src="/assets/homepage/GC.svg">
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
              Gift Card
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
            Launch a complete gifting program with Physical & eGift cards.
          </div>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <img alt="" class="w-8" src="/assets/homepage/LC.svg">
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
              Loyalty
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
            Motivate customers to make repear purchases by rewarding them with points and exclusive vip tears, perks.
          </div>
        </li>
        <li>
          <div>
            <div class="text-indigo-400">
              <img alt="" class="w-8" src="/assets/store-credit.svg">
            </div>
            <p class="mt-5 text-lg font-medium text-white lg:text-xl">
              Store Credit
            </p>
          </div>
          <div class="mt-2 text-base text-vulcan-300">
            Convert refund to revenue by offering store credit directly into customer's wallet.
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
