<section class="relative overflow-x-hidden border-y border-white/5">
    <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-7xl lg:px-0 mx-auto px-6 right-0">
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
        <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    </div>
    <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:pt-24">
        
        <ul class="grid grid-cols-1 gap-4 mt-4 sm:grid-cols-2 lg:grid-cols-3 lg:mt-24">
            <li class="p-[0.060rem] rounded-3xl shadow-2xl shadow-vulcan-950  lg:col-span-2">
                <div class="flex flex-col justify-between lg:h-[36rem] lg:p-8 p-5 border shadow-2xl border-vulcan-700 rounded-3xl bg-white group " x-data="{ count: 1 }">
                    <div>
                        <p class="font-semibold lg:text-xl text-black">Reward management</p>
                        <p class="mt-4 text-base text-gray-800">
                            Offer your customers flat rate or percentage-based commission structure on all their referrals. Set rules for qualifying purchases like minimum cart value, net new customers only, and more!
                        </p>
                        <ul class="grid grid-cols-1 gap-4 mt-4 sm:grid-cols-2 lg:grid-cols-3 lg:mt-10">
                            <li class="p-[0.010rem] rounded-t-3xl shadow-vulcan-950 lg:col-span-2">
                                <div class="flex flex-col lg:h-[24.35rem] justify-between pt-8 border shadow-2xl px-3 lg:px-10 border-vulcan-700 rounded-t-3xl bg-white group-hover:bg-[#D9CDFF]">
                                    <div class="flex">
                                        <div class="flex-auto">
                                            <p class="font-semibold lg:text-xl text-black group-hover:text-black">Your Cart</p>
                                        </div>
                                        <div class="flex-auto">
                                            <button type="button" class="flex items-center float-right w-auto mt-0 h-10 px-2 lg:py-2 py-4 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">Continue Shopping</button>
                                        </div>
                                    </div>
                                    <div class="mt-6">
                                        <div class="flex lg:space-x-6 bg-vulcan-900/5 border border-vulcan-700 pt-4 lg:p-4 rounded-xl group-hover:bg-white">
                                            <img src="/assets/bag.png" alt="Product image" class="h-20 w-20 p-2 lg:p-0 flex-none rounded-lg object-cover object-center">
                                            <div class="flex flex-col justify-between space-y-4 w-full">
                                                <div class="space-y-1 text-sm font-medium">
                                                    <p class="text-base font-semibold text-black group-hover:text-black">Bag</p>
                                                    <div class="flex items-center">
                                                        <p class="text-gray-500 text-sm mt-0 flex-auto group-hover:text-black">$100.00</p>
                                                        <form class="max-w-xs flex-auto">
                                                            <div class="relative lg:ml-24 flex items-center">
                                                                <button type="button" @click="count > 1 ? count-- : count" class="flex-shrink-0 bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:border-gray-600 hover:bg-gray-200 inline-flex items-center justify-center border border-gray-300 rounded-md h-5 w-5 focus:ring-gray-100 dark:focus:ring-gray-700 focus:ring-2 focus:outline-none">
                                                                    <svg class="w-2.5 h-2.5 text-gray-900 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 2">
                                                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h16"/>
                                                                    </svg>
                                                                </button>
                                                                <input type="text" x-model="count" class="group-hover:text-black flex-shrink-0 text-black border-0 bg-transparent text-sm font-normal focus:outline-none focus:ring-0 max-w-[2.5rem] text-center" readonly />
                                                                <button type="button" @click="count++" class="flex-shrink-0 bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:border-gray-600 hover:bg-gray-200 inline-flex items-center justify-center border border-gray-300 rounded-md h-5 w-5 focus:ring-gray-100 dark:focus:ring-gray-700 focus:ring-2 focus:outline-none">
                                                                    <svg class="w-2.5 h-2.5 text-gray-900 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18">
                                                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 1v16M1 9h16"/>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-span-full mt-5">
                                        <p class="text-black text-base group-hover:text-black">Discount code</p>
                                    </div>
                                    <div class="col-span-full mt-2 sm:col-span-4 ">
                                        <div class="mt-1 mb-10 flex w-full space-x-2">
                                            <input id="discount-code" type="text" name="discount-code" placeholder="50OFF" aria-label="Discount code" class="flex-auto w-full rounded-lg border border-vulcan-700 bg-white group-hover:bg-white px-3.5 py-3 text-white focus:ring-inset focus:ring-vulcun-900 focus:ring-1 sm:text-sm sm:leading-6 placeholder:text-white/9 group-hover:text-black">
                                            <button type="submit" aria-label="Apply discount code" class="items-center text-sm group active:bg-gray-100 active:text-gray-500/60 active:transition-none border border-vulcan-700 font-medium gap-2 inline-flex justify-center outline-offset-2 px-6 py-3 transition w-40 bg-vulcan-900 hover:text-indigo-400 text-white rounded-lg">Apply</button>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="p-[0.060rem] lg:h-64 rounded-t-3xl shadow-vulcan-950">
                                <div class="flex flex-col justify-between p-8 border shadow-2xl lg:p-5 border-vulcan-700 rounded-3xl bg-white group-hover:bg-[#D9CDFF]">
                                    <div>
                                        <p class="mt-2 text-base text-black group-hover:text-black">
                                            Reward value per referred subscriptions
                                        </p>
                                        <div class="mt-4 text-black group-hover:text-black">
                                            <fieldset>
                                                <input id="draft" class="peer/draft" type="radio" name="status" checked />
                                                <label for="draft" class="peer-checked/draft:text-indigo-500 text-xl font-semibold ml-2">$</label>
                                                <input id="published" class="peer/published ml-6" type="radio" name="status" />
                                                <label for="published" class="peer-checked/published:text-indigo-500 text-xl font-semibold ml-2">%</label>
                                                <div class="hidden peer-checked/draft:block py-4 bg-vulcan-900 border border-vulcan-700 group-hover:bg-vulcan-900 text-white  group-hover:text-white rounded-lg mt-4 justify-center text-center font-semibold">$ 10.00</div>
                                                <div class="hidden peer-checked/published:block py-4 bg-vulcan-900 border border-vulcan-700 group-hover:bg-vulcan-900 text-white group-hover:text-white rounded-lg mt-4 justify-center text-center font-semibold">% 10.00</div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </li>
            <li class="p-[0.060rem] rounded-3xl shadow-2xl shadow-vulcan-950 ">
                <div class="flex flex-col justify-between lg:h-[36rem] p-8 border shadow-2xl lg:p-10 border-vulcan-700 rounded-3xl bg-white group hover:bg-opacity-50" 
                    x-data="{ isChecked: false, count: 0, target: 10, counter() { 
                        this.count = 0; // Reset count
                        let interval = setInterval(() => { 
                            if (this.count < this.target) { 
                                this.count += 1; 
                            } else { 
                                clearInterval(interval); 
                            } 
                        }, 50); 
                    } }">
                    <div>
                        <div class="flex gap-x-1"></div>
                        <p class="font-semibold lg:text-xl text-black">Cashback</p>
                        <p class="mt-4 text-base">
                            Customers can earn store credit on all their orders to increase repeat purchases.
                        </p>
                        
                        <!-- This div changes background color when parent div is hovered -->
                        <div class="flex space-x-6 border mt-2 lg:mt-10 lg:p-4 rounded-xl border-vulcan-700 bg-white group-hover:bg-[#D9CDFF] transition-colors duration-200">
                            <div class="flex flex-col justify-between space-y-4 w-full">
                                <div class="space-y-1 text-sm font-medium p-2 lg:p-0">
                                    <label class="inline-flex items-center cursor-pointer">
                                        <input type="checkbox" x-model="isChecked" @change="isChecked && counter()" class="sr-only peer">
                                        <span class="ms-3 text-base font-semibold text-black group-hover:text-black">Cashback</span>
                                        <div class="relative w-11 h-6 ml-24 lg:ml-40 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
                                    </label>
                                </div>
                            </div>
                        </div> 
                        
                        <!-- This div changes background color when parent div is hovered -->
                        <div class=" mt-7 rounded-3xl shadow-2xl shadow-vulcan-950 group-hover:bg-white transition-colors duration-200"> 
                            <div class="h-56 flex flex-col justify-between pt-4 border lg:px-6 border-vulcan-700 rounded-3xl bg-white group-hover:bg-[#D9CDFF] transition-colors duration-200">
                                <div class="flex pt-4 px-4 lg:px-0">
                                    <div class="flex-auto "><p class="text-base font-semibold group-hover:text-black">Jayne</p></div>
                                    <div class="flex-auto "><p class="text-base font-semibold float-right group-hover:text-black">VIP Program</p></div>
                                </div>
                                <div class="mt-10 mb-10 px-4 lg:px-0">
                                    <!-- Show animated counter if checkbox is checked, otherwise show $0.00 -->
                                    <template x-if="isChecked">
                                        <div x-init="counter()">
                                            <p class="text-3xl font-regular text-black group-hover:text-black" x-text="'$' + count +'.90'"></p>
                                            <p class="text-base text-black group-hover:text-black">My reward</p>
                                        </div>
                                    </template>
                                    <template x-if="!isChecked">
                                        <div>
                                            <p class="text-3xl font-regular text-black group-hover:text-black">$0.00</p>
                                            <p class="text-base text-black group-hover:text-black">My reward</p>
                                        </div>
                                    </template>
                                </div>
                            </div> 
                        </div>             
                    </div>
                </div>
            </li>
        </ul>
    </div>
</section>