---
import RoundedGrid from "../assets/RoundedGrid.astro";
---

<section class="relative overflow-hidden border-t border-white/5">
  <RoundedGrid />

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-20">
    <div class="relative flex flex-col lg:flex-row items-center justify-between">
      <div data-aos="fade-right" data-aos-duration="2000" class="max-w-xl lg:w-1/2">
        <p class="text-sm text-transparent uppercase bg-gradient-to-r from-indigo-300 to-indigo-400 bg-clip-text">
          Customer Stories
        </p>
        <div class="flex flex-col">
          <h3 class="mt-8 text-3xl font-normal tracking-tight text-white">
            The retention platform behind the world's fastest growing brands on Shopify
          </h3>
          <p class="mt-6 text-base text-white">
            Marketers from all kinds of brands trust 99minds to run their loyalty and referrals motion. Learn how fastest growing brands on Shopify like HexClad, Ridge, Kitsch and Aloha are using 99minds.
          </p>
          <div data-aos="fade-right" data-aos-duration="2000" class="flex flex-col pt-5 mt-5 md:flex-row">
            <p>
              <a class="text-white/70 duration-200 hover:text-white" href="/case-study1">View all case studies &nbsp; &rarr;</a>
            </p>
          </div>
        </div>
      </div>

      <div class="lg:w-1/2 border-t lg:border-none border-y border-white/5 lg:pl-14">
        <div class="p-4" data-aos="zoom-in" data-aos-duration="2000">
          <img class="object-cover object-center mt-0 rounded-3xl drop-shadow-xl h-96" loading="lazy" src="/assets/testimonial/Testimonial2.jpg" width="720" height="auto" alt=""/>
        </div>
      </div>
    </div>
  </div>
</section>
