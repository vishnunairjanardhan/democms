---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative bg-[#f9f9f9]">
  <div class="hidden pt-2 lg:block">
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]">
    <div class="text-center max-w-4xl  lg:mt-0 mx-auto">
      <h2 class="font-medium">Engage Customers Better with Store Credit</h2>
    </div>
    <div class="grid grid-cols-1 mt-12 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-3 gap-x-10 lg:px-0 px-4">
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="retain customers with store credit" loading="lazy" src="../assets/storecredit/retain-customer.svg">
            </div>
           <h3 class="mt-5 text-xl text-black">
              Retain Customers
            </h3>
            <p class="mt-2 text-base">Using store credits helps build loyal customers and reduce churn. Store credits can be used to reward returning users, manage refunds and returns in the same wallet, and even reward loyal users.</p>
          </div>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="manage returns with store credit" loading="lazy" src="../assets/storecredit/Manage-order.svg">
            </div>
         <h3 class="mt-5 text-xl text-black">
            Manage Returns
          </h3>
          <p class="mt-2 text-base">In case of returns give store credits and retain the revenue. This also encourages the buyer to come back to the store later when an item of their choice is available.</p>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
          <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="create campaigns with store credits" loading="lazy" src="../assets/storecredit/create-campaign.svg">
            </div>
           <h3 class="mt-5 text-xl text-black">
              Create Campaigns
            </h3>
            <p class="mt-2 text-base">Store credits can be used as a giveaway for different campaigns focused on signing up, purchasing, giving a review, referring a friend, or for driving any other engagement campaign.</p>
          </div>
        </div>
      </div>
    </div>
<div class="lg:flex gap-2 mt-10 justify-center">
      <div x-data="{ open: false }" class="flex">
              <!-- Trigger -->
              <a type="button" href="/Get-Started" role="button" aria-label="Get Started for Free" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                  <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                  <span class="relative text-white">Sign Up for Free</span> </span>
              </a>
      </div>
  </div>
</section>



