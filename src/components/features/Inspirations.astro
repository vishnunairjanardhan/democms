                                <img class="object-cover loading="lazy" object-center w-[32rem] h-[18rem] rounded-lg shadow-xl" src="/assets/loyalty-showcase/Les-jumelles-ss.webp" alt="Les-jumelles Loyalty Program">
                              </div>
                            </div>
                          </li>
