---
import TESTIMONIAL from "../../config/Testimonial.json";
---

<section class="relative">
 
  <div class="relative items-center w-full px-5 pt-12 mx-auto md:px-12 lg:px-12 max-w-7xl lg:py-16">
    <div class="grid grid-cols-1 gap-6 p-0 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-36 lg:p-0">
      <div class="relative items-center gap-8 pb-6 m-auto lg:inline-flex md:order-first lg:pb-12 xl:pt-0">
        <div class="max-w-xl text-center lg:text-left">
          <p role="term" class="text-base font-medium text-[#6820EE] uppercase bg-clip-text">INSPIRATIONS</p>
          <h2 class="mt-8">Feeling Stuck? Get Some Ideas from Our Customers</h2>
          <p class="max-w-2xl mt-4">Explore our showcase of loyalty program pages and get inspired by some of the most successful programs created by our existing customers.</p>
          <div class="mt-8">
            <a type="button" href="/loyalty-page-examples" role="button" aria-label="Loyalty-page-examples" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium"> <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400"> <span class="relative text-white">Explore the Showcase</span> </span> </a>
          </div>
        </div>
      </div>
      <div class="rounded-3xl relative h-auto video-container overflow-hidden">
        <section>
          <div class="mx-auto lg:px-4 md:px-2 items-center w-full">
            <div class="flex flex-col w-full" x-data="{
              skip: 1,
              next() {
                  this.to((current, offset) => current + (offset * this.skip));
              },
              to(strategy) {
                  let slider = this.$refs.slider;
                  let current = slider.scrollLeft;
                  let offset = slider.firstElementChild.getBoundingClientRect().width;

                  // Calculate new scroll position based on strategy
                  let newScrollLeft = strategy(current, offset);

                  // Scroll to new position smoothly
                  slider.scrollTo({ left: newScrollLeft, behavior: 'smooth' });

                  // Check if we've reached the duplicate section and reset to the original
                  if (newScrollLeft >= slider.scrollWidth / 2) {
                      slider.scrollTo({ left: 0 });
                  }
              },
              startAutoSlide() {
                  this.interval = setInterval(() => {
                      this.next();
                  }, 2500);
              },
              stopAutoSlide() {
                  clearInterval(this.interval);
              },
            }" x-init="startAutoSlide" role="button">
              <div class="flex flex-col w-full" aria-labelledby="carousel-label" role="region" tabindex="0">
                <ul class="flex gap-3 overflow-x-scroll pb-4 pt-4 scrollbar-hide snap-mandatory snap-x w-full" role="listbox" aria-labelledby="carousel-content-label" tabindex="0" x-ref="slider">
                  
                  <!-- Original Slides -->
                  <li class="w-full flex flex-col shrink-0 snap-start" role="option">
                    <figure>
                      <ul class="h-full">
                        <li class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] snap-start w-full ">
                          <div>
                            <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center  mx-auto justify-center">
                              <img class="object-cover loading="lazy" object-center w-[32rem] h-[18rem] rounded-lg shadow-xl" src="/assets/loyalty-showcase/Lovable-ss.webp" alt="Lovable Loyalty Program">
                            </div>
                          </div>
                        </li>
                      </ul>
                    </figure>
                  </li>
                  <li class="w-full flex flex-col shrink-0 snap-start " role="option">
