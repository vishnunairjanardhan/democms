        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt="Shopify gift cards" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopify/GC.webp">
