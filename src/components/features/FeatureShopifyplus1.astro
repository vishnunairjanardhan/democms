---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="">
<Verticalgrid />
  <div class="mx-auto max-w-7xl py-24 lg:px-16 md:px-12 px-8 xl:px-18 items-center lg:py-24 relative w-full">
    <div class="mx-auto text-center">
      <h2 class="mt-8">The Tools You Need To Grow Repeat Sales</h2>
      <p class="max-w-4xl mx-auto mt-4">Points, VIP, referrals, gift cards, and store credit work seamlessly together to create the ultimate rewards program for your business.</p>
    </div>
    <div class="mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-5 mt-16">
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt="Shopify gift cards" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopify/Shopify-GC.svg">
              <h3 class="mt-8">Sell Gift Cards - Physical and Digital</h3>
              <p class="mt-2">Allow customers to buy, send and design branded Gift Cards on every Shopify plan, and boost your gift card sales by 300%.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt=" Shopify loyalty program" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopify/Shopify-LP.svg">
              <h3 class="mt-8">Simple and Dynamic Loyalty Program</h3>
              <p class="mt-2 ">Offer an omni-channel loyalty program that boosts customer lifetime value and marketing performance.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt=" Shopify store credit" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopify/Shopify-SC.svg">
              <h3 class="mt-8"> Store Credit- Turn Refunds Into Sales</h3>
              <p class="mt-2">Issue store credit to your customers that can be used to process refunds or reward customers.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt=" Shopify coupons" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopify/Shopify-CG.svg">
              <h3 class="mt-8">Powerful Coupon Generator</h3>
              <p class="mt-2">Bulk, dynamic & personalize coupon generation for your store.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt=" Shopify referral program" class="text-center" width="176" height="176" loading="lazy" src="/assets/shopifyplus/Custom-Checkout.svg">
              <h3 class="mt-8">Custom Checkout Page</h3>
              <p class="mt-2">Elivate the cutomer experience by redeeming Giftcard & Coupon with just one click. </p>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col  p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5 rounded-3xl">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <img alt="Shopify pos" class="justify-center" width="176" height="176" loading="lazy" src="/assets/shopifyplus/Brand-wallet.svg">
              <h3 class="mt-8">Build Your Brand Wallet</h3>
              <p class="mt-2">Allow your customers to track and redeem Loyalty Points & Store Credits all from checkout.</p>
            </div>
          </div>
        </div>
    </div>
  </div>
  <div class="flex flex-col justify-center max-w-xl gap-2 mx-auto mt-10 sm:flex-row">
    <div class="flex flex-wrap justify-center gap-2 lg:mt-10">
      <a href="https://apps.shopify.com/99minds-gift-card-loyalty-referral#" target="_blank" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
          <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
          <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
          <span class="relative text-white">Install 99minds on Shopify</span>
          </span>
      </a>
    </div>
  </div>
</section>
