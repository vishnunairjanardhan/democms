---
import {workflows} from "../../config/component.jsx"
---
<section class="border-t border-y border-white/5 relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:pt-24">
  <div class="">
    <div class="py-6 items-center border border-indigo-400 hover:border-white rounded-3xl mx-0 hover:border hover:border-white/70 transition-shadow duration-300 flex flex-col justify-between group">
      <h2 class="px-10 lg:text-left">Milestone based gifting</h2>
      <p class="px-5 mt-2 ml-5 text-center  lg:text-left">Gamify incentives by setting gifts your customers can unlock through referral or order-based milestones.</p>
        <div class="flex lg:flex-row flex-col items-stretch grid grid-cols-1 lg:grid-cols-3 gap-4 mx-auto 2xl:max-w-7xl p-12 sm:px-4 w-full">
            {workflows.map(workflow => (
                <div class="mt-4 px-4 w-full relative flex flex-col items-center border border-white/20 rounded-2xl bg-vulcan-400 group-hover:bg-white transition-colors duration-300" key={workflow.title} data-tilt>
                <div class="relative rounded-3xl flex items-center">
                    <div class="text-left p-5">
                    <label class="inline-flex items-center my-2 cursor-pointer">
                        <img src={workflow.logo} alt="logo" class="h-20 w-20 flex-none rounded-lg object-cover object-center">
                    </label>
                    <h3 class="text-black text-lg font-bold">{workflow.title}</h3>
                    <p class="text-black text-sm">{workflow.description}</p>
                    </div>
                </div>
                </div>
            ))}
        </div>
    </div>
  </div>
</section>
