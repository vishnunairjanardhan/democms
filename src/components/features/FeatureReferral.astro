---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#FEFCF5]">
  <Verticalgrid />
  <div class="mx-auto lg:text-center px-8 lg:py-12">
        <h2 class="mt-8 font-medium">
          Key Features
        </h2>
         <!---<p class="font-body text-xl xl:text-2xl mt-4 text-vulcan-300 ">
            All your required key features under one roof</br>
        </p>--->
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24  items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
           Customize Referral Widget & </br>Web page
        </h2>
        <div class="gap-3 mt-10">
          </div>
          <!--- <div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div> --->
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl w-full"
          src="/assets/referral/referral-widget1.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium mt-8">
          Create Social Sharing & Referral link
        </h2>
        <!---<p class="font-semibold mt-4 text-base text-vulcan-300">Set up landmarks to accomplish VIP status</p>--->
        <p class="mt-4">Send and redeem physical and eGift cards issued by any POS like Square, Vend, Lightspeed etc.</p>
        <div class="gap-3 mt-10">
        
            </div>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/referral/social-sharing1.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
          Reward your customers the way they want
        </h2>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/referral/reward-referral1.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium mt-8">
          Promote
        </h2>
        <p class="mt-4 ">Send announcement Email or SMS Text to your Customer</p>
        <div class="gap-3 mt-10">
        
            </div>
      </div>
      <div class="h-full">
