---
import { Image } from "astro:assets";
import myImage from "../../assets/referral/referral_widget.webp";
import myImage1 from "../../assets/referral/social_sharing.webp";
import myImage2 from "../../assets/referral/reward_referral.webp";
import myImage3 from "../../assets/referral/social_sharing.webp";
---
<section class="relative bg-[#FEFCF5]">
  <div class="mx-auto lg:text-center px-8 lg:pt-[72px]">
    <h2 class="font-medium">
      Key Features
    </h2>
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]  md:space-y-24 space-y-5">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24  items-center mt-6">
      <div class=" ">
        <h2 class="font-medium mt-8">
           Customize Referral Widget & </br>Web page
        </h2>
        <p class="mt-4">Customize your referral widget and referral page to perfectly </br> match your brand for a seamless customer experience.</p>
        <div class="gap-3 mt-10">
          </div>
      </div>
      
      <div class="h-full">
        <Image
            src={myImage}
            alt="Referral Widget"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium mt-8">
          Create Social Sharing & Referral Links
        </h2>
        <!---<p class="font-semibold mt-4 text-base text-vulcan-300">Set up landmarks to accomplish VIP status</p>--->
        <p class="mt-4">Enable customers to share unique referral links across social media, email, and other channels with just one click.</p>
        <div class="gap-3 mt-10">
        
            </div>
      </div>
      <div class="h-full">
        <Image
            src={myImage1}
            alt="Sharing & Referral Links"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium mt-8">
          Reward Your Customers </br> the Way They Want
        </h2>
        <p class="mt-4">Offer flexible rewards like loyalty points, store credit, discounts, or gift cards to motivate both referrers and referred customers.</p>
      </div>
      <div class="h-full">
       <Image
            src={myImage2}
            alt="Reward Your Customers"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-20 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium mt-8">
          Promote Your Referral Program
        </h2>
        <p class="mt-4 ">Easily promote referrals using onsite emails and SMS to maximize participation and reach.</p>
        <div class="gap-3 mt-10">
        
            </div>
      </div>
      <div class="h-full">
        <Image
            src={myImage3}
            alt="Referral Program"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

