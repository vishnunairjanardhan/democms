---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div data-aos="fade-down" data-aos-duration="2000" class="mx-auto lg:text-center px-8 lg:py-12">
        <h2 class="mt-8 2xl:text-5xl">
          Key features. 
        </h2>
         <p class="font-body text-xl mt-4">
            All your coupon needs, covered
        </p>
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div data-aos="fade-right" data-aos-duration="2000" class=" ">
        <h2 class="2xl:text-5xl mt-8">
           Advanced coupon marketing software
        </h2>
        <p class="mt-4">Design Loyalty program right for your brand</p>
        <div class="gap-3 mt-10">
         <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Efficiently create millions of randomly generated coupons.
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Set expiry dates and link customer IDs to single coupons.
                </p>
              </div>
            </li>
          </ul>
          </div>
          <!--- <div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div> --->
      </div>
      
      <div data-aos="zoom-in" data-aos-duration="2000" class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/coupons/advanced-coupon2.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-left" data-aos-duration="2000" class="sm:order-last  ">
        <h2 class="2xl:text-5xl mt-8">
          Custom-made coupons
        </h2>
        <!--- <p class="font-semibold mt-4 text-base text-vulcan-300">Set up landmarks to accomplish VIP status</p>
        <p class="mt-4">Encourage your customers to attain the next tier with contesting but achievable milestones!</p> --->
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  SKU-based
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Coupon Category based coupon
                </p>
              </div>
            </li>
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  BOGO Coupon
                </p>
              </div>
            </li>
            </ul>
            </div>
      </div>
      <div data-aos="zoom-in" data-aos-duration="2000" class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/coupons/custom-coupon2.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div data-aos="fade-right" data-aos-duration="2000" class=" ">
        <h2 class="2xl:text-5xl mt-8">
          Reward your customers the way they want
        </h2>
        <div class="gap-3 mt-10">
        <ul class="list-none" role="list">
            <li>
              <div class="relative flex items-center py-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-4 text-white/70 icon icon-tabler icon-tabler-circle-check"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
                  <path d="M9 12l2 2l4 -4"></path>
                </svg>
                <p class="ml-2 leading-6">
                  Track coupon usage using coupons transactions associated with Customer & Order ID
                </p>
              </div>
            </li>
            </ul>
            </div>   
      </div>
      <div data-aos="zoom-in" data-aos-duration="2000" class="h-full">
        <img
          alt="Lexington thumbnail"
          loading="lazy"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/coupons/reward-customer2.webp"
        />
      </div>
    </div>
    
  </div>
</section>
