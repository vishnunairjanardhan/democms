<section class="relative">
  <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-7xl lg:px-0 mx-auto px-6 right-0">
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
  </div>
  <div class="relative max-w-7xl px-2 md:px-12 lg:px-16 mx-auto py-12 lg:py-24 bg-[#FEFCF5]">
    
    <h2 class="text-center text-2xl lg:text-4xl mb-0 lg:mb-16">Design Stunning Passes with Our Intuitive Builder. With Three simple steps
    </h2>
    <p class="text-base sm:text-lg text-gray-600 leading-relaxed w-full">
        Get your mobile wallet passes up and running in minutes, not days.
    </p>
    <div class="grid grid-cols-1 gap-6 p-8 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-32 lg:p-0 lg:pt-8">
       <div class="relative items-center gap-12 pb-12 m-auto lg:inline-flex md:order-first lg:pb-32 xl:pt-0">
        <div class="max-w-xl text-center lg:text-left">
           <h3 class="lg:mt-8 text-xl lg:text-3xl">Design your pass</h3>
        <p class="text-base sm:text-lg text-gray-600 leading-relaxed w-full max-w-xl mx-auto sm:text-left sm:mx-0">
            Choose a template and customize it with your branding, colors, and content using our intuitive visual editor.
        </p>
        <div class="lg:flex gap-2 mt-10">
             <div x-data="{ open: false }" class="flex justify-center">
              <!-- Modal -->
              <div x-show="open" x-on:keydown.escape.prevent.stop="open = false" role="dialog" aria-modal="true" x-id="['modal-title']" :aria-labelledby="$id('modal-title')" class="fixed inset-0 z-50 w-screen overflow-y-auto " aria-labelledby="modal-title-5">
                <!-- Overlay -->
                <div x-show="open" x-transition.opacity="" class="fixed inset-0 bg-vulcan-950 bg-opacity-50" style="display: none;"></div>
                <!-- Panel -->
                <div x-show="open" x-transition="" x-on:click="open = false" class="relative flex min-h-screen items-center justify-center p-4" style="display: none;">
                  <div x-on:click.stop="" x-trap.noscroll.inert="open" class="relative w-full max-w-3xl overflow-y-auto shadow-2xl rounded-3xl p-[0.060rem]">
                    <div class="bg-white rounded-3xl p-4 text-center">
                      
                    <iframe
                      src="../GetStarted"
                      width="100%"
                      height="600"
                      frameBorder="0"
                      allowFullScreen
                      title="Calendly"
                    ></iframe>

                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        
        </div>
       </div>
        <div class="relative order-first w-full lg:w-5/6 flex justify-center items-center mx-auto">
            <img 
                src="/assets/wallet/wallet_d.webp" 
                alt="hero" 
                class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl h-auto rounded-3xl border border-gray-300 shadow-2xl object-contain object-center"
            />
        </div>
    </div>
  </div>
</section>