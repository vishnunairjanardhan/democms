---
import { Image } from "astro:assets";
import myImage from "../../assets/homepage/GC-exp.webp";
import myImage1 from "../../assets/homepage/LP1.webp";
import myImage2 from "../../assets/homepage/SC1.webp";
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section id="giftcardsection" class="relative bg-[#FEFCF5]">
  <Verticalgrid />
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-24  md:space-y-24 space-y-5">
    <div class="grid grid-cols-1 gap-6 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="h-full">
        <!--<img
          role='img'
          loading="lazy"
          alt="gift card image"
          class="rounded-2xl shadow-vulcan-950/50" width="731" height="733"
          src="/assets/homepage/GC-exp.webp"
        />-->
        <Image
            src={myImage}
            alt="Gift card experience"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={80}
            loading="lazy"
            class="rounded-2xl shadow-vulcan-950/50"
          />
      </div>
      <div class="">
        <p
          class="text-base font-medium text-[#6820EE] uppercase bg-clip-text">
          Gift Card Management
        </p>
        <h2 class="py-4 font-medium">
           Drive Revenue with Omnichannel Gift Card Experience  
        </h2>
        <p class="">
          Seamlessly issue offline and online gift cards to boost your sales across all the channels including website, mobile apps, and multiple physical store locations.<br /><br /> Let your customers send gift cards physically or virtually through mail, social media, email, WhatsApp, or iMessage.
        </p>
          <div class="lg:flex gap-2 mt-10" role="button">
              <div x-data="{ open: false }" class="flex justify-start lg:justify-center">
              <!-- Trigger -->
             <span x-on:click="open = true">
                <a href="/giftcard" target="_blank" type="button" role="button" aria-label="Get Started for Free"
                  class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                  
                  <span class="relative text-[#6820EE] text-xl  transition-colors duration-300">
                    Learn more about Gift Cards
                  </span>

                  <svg
                    class="ml-3 h-8 w-8 text-[#6820EE] transition-all duration-300 transform group-hover:translate-x-2"
                    width="16" height="16" viewBox="0 0 24 24"
                    stroke-width="2" stroke="currentColor" fill="none"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <line x1="13" y1="18" x2="19" y2="12" />
                    <line x1="13" y1="6" x2="19" y2="12" />
                  </svg>
                </a>
              </span>
              </div>
            </div>
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="h-full sm:order-last">
        <Image
            src={myImage1}
            alt="Gift card experience"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={80}
            loading="lazy"
            class="rounded-2xl shadow-vulcan-950/50"
          />
      </div>
      <div class="">
        <p
          class="text-base font-medium text-[#6820EE] uppercase bg-clip-text">
          Loyalty Program
        </p>
        <h2 class="py-4 font-medium">
          Build Long-Term Purchase Habits with Loyalty Programs
        </h2>
        <p class="">
          Encourage your customers to buy more by rewarding them with loyalty points on each purchase or for different activities (i.e., sign up, reviews, social sharing, etc.). Define custom values for points, and set expiry dates to drive regular sales.<br /><br />Set up VIP tiers and build long-term loyalty by awarding more points at higher tiers of a multi-tiered loyalty program.
        </p>
       <div class="lg:flex gap-2 mt-10" role="button">
              <div x-data="{ open: false }" class="flex justify-start lg:justify-center">
              <!-- Trigger -->
             <span x-on:click="open = true">
                <a href="/loyalty" target="_blank" type="button" role="button" aria-label="Get Started for Free"
                  class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                  
                  <span class="relative text-[#6820EE] text-xl  transition-colors duration-300">
                    Learn more about Loyalty Program
                  </span>

                  <svg
                    class="ml-3 h-8 w-8 text-[#6820EE] transition-all duration-300 transform group-hover:translate-x-2"
                    width="16" height="16" viewBox="0 0 24 24"
                    stroke-width="2" stroke="currentColor" fill="none"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <line x1="13" y1="18" x2="19" y2="12" />
                    <line x1="13" y1="6" x2="19" y2="12" />
                  </svg>
                </a>
              </span>
              </div>
            </div>
      </div>
      
    </div>
    <div class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
    <div class="h-full">
        <Image
            src={myImage2}
            alt="Gift card experience"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={80}
            loading="lazy"
            class="rounded-2xl shadow-vulcan-950/50"
          />
      </div>
      <div class="sm:order-last">
        <p 
          role='term'
          class="text-base font-medium text-[#6820EE] uppercase bg-clip-text">
          CASHBACK & STORE CREDIT MANAGEMENT
        </p>
        <h2 role='heading' class="py-4 font-medium">
          Acquire Customers with Cashback & Retain with Store Credit
        </h2>
        <p role='emphasis' class="">
          Run simple-to-sophisticated cashback campaigns to boost your sales. Manage returns easily with effortless issuance and management of store credits, allowing your customers to engage and shop with ease and flexibility.<br /><br />Automate store credit compensations to further enhance the refund processes and to ensure that the revenue you generate remains within your business.
        </p>
               <div class="lg:flex gap-2 mt-10" role="button">
              <div x-data="{ open: false }" class="flex justify-start lg:justify-center">
              <!-- Trigger -->
             <span x-on:click="open = true">
                <a href="/store-credit" target="_blank" type="button" role="button" aria-label="Get Started for Free"
                  class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                  
                  <span class="relative text-[#6820EE] text-xl  transition-colors duration-300">
                    Learn more about Store Credit
                  </span>

                  <svg
                    class="ml-3 h-8 w-8 text-[#6820EE] transition-all duration-300 transform group-hover:translate-x-2"
                    width="16" height="16" viewBox="0 0 24 24"
                    stroke-width="2" stroke="currentColor" fill="none"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <line x1="13" y1="18" x2="19" y2="12" />
                    <line x1="13" y1="6" x2="19" y2="12" />
                  </svg>
                </a>
              </span>
              </div>
            </div>
      </div>
      
    </div>
  </div>
</section>
