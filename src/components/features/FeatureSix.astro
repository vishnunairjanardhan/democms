                  </div>
                </div>
              </div>
            </div>
      </div>
      <div class="h-full">
        <img
          role='img'
          loading="lazy"
          alt="Loyalty Points image"
          class="rounded-2xl shadow-vulcan-950/50 " width="760" height="700"
          src="/assets/homepage/LP1.webp"
        />
      </div>
