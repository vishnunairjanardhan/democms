---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="">
<Verticalgrid />
  <div class="mx-auto max-w-7xl py-24 lg:px-16 md:px-12 px-8 xl:px-18 items-center lg:py-24 relative w-full">
    <div class="mx-auto text-center">
      <h2 class="mt-2">Experience Unified Commerce with iPaaS.com</h2>
    </div>
    <div class="mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-5 mt-20">
      <div class="flex flex-col  p-[0.060rem] bg-white rounded-3xl border border-gray-500">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <!--<img alt="iPaaS gift cards" class="w-44 text-center" src="/assets/shopify/Shopify-GC.svg">-->
              <h3 class="mt-2">Connect Your Complete Ecosystem</h3>
              <p class="mt-2 ">Utilize iPaaS.com to deliver unified commerce experiences by flowing loyalty data with CRM, ERP, eCommerce, FSM, marketing, POS, review management, and other software platform</p>
            </div>
          </div>
        </div>
      
          
        
      </div>
      <div class="flex flex-col  p-[0.060rem] bg-white rounded-3xl border border-gray-500">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <!--<img alt="Heartland loyalty program" class="w-44 text-center" src="/assets/shopify/Shopify-LP.svg">-->
              <h3 class=" text-2xl mt-2 text-black">Get Data in <br> Real-time</h3>
              <p class="mt-2 ">Get data in real-time through your integration API ecosystem on iPaas.com. Set up flexible data that provides accountable data in real-time and even allow error identification.</p>
            </div>
          </div>
        </div>
       
      </div>
      <div class="flex flex-col  p-[0.060rem] bg-white rounded-3xl border border-gray-500">
        <div class="px-6 py-8 sm:p-10 sm:pb-6">
          <div class="grid items-center justify-center w-full grid-cols-1 text-left">
            <div>
              <!--<img alt="Heartland store credit" class="w-44 text-center" src="/assets/shopify/Shopify-SC.svg">-->
              <h3 class=" text-2xl mt-2 text-black">Customize Data <br> Flows</h3>
              <p class="mt-2 ">This integration helps you set up easy to modify data flows that allows you to add custom fields and define unique data orchestration, translations, and transformations.</p>
            </div>
          </div>
        </div>
      
      </div>
   
  </div>
   <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto mt-20 sm:flex-row">
          <a href="https://giftcard.99minds.io/access/register" target="_blank" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                <span class="w-full h-full bg-black absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                <span class="relative text-white">Install 99minds for free</span>
                </span>
          </a>
      </div>
</section>
