---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section>
  <div
    x-data="{annual: false}"
    class="relative items-center w-full px-4 py-32 mx-auto md:px-12 lg:px-16 max-w-7xl lg:py-36">
    <div class="max-w-3xl mx-auto text-center lg:max-w-none">
      <div class="max-w-xl lg:text-center lg:mx-auto">
       
        <h2 class="mt-8 text-3xl font-normal tracking-tight text-white">
          Additional key features
        </h2>
      </div>
      <div
        class="w-full bg-vulcan-800 overflow-hidden inline-flex p-0.5 rounded-lg mt-8 z-0 lg:ml-auto max-w-xl">
        <button
          class="block w-full px-8 py-2 text-xs font-medium text-white transition border border-transparent rounded-md"
          @click="annual = false"
          :class="annual == false ? 'bg-vulcan-900 border text-white ' : ''"
          type="button">Bulk Gift Card</button
        >
        <button
          class="block w-full px-8 py-2 text-xs font-medium text-white transition border border-transparent rounded-md"
          @click="annual = true"
          :class="annual == true ? 'bg-vulcan-900 border text-white' : ''"
          type="button">Import & Migration</button
        >
         <button
          class="block w-full px-8 py-2 text-xs font-medium text-white transition border border-transparent rounded-md"
          @click="MC = true"
          :class="MC == true ? 'bg-vulcan-900 border text-white' : ''"
          type="button">Multi-Currency</button
        >
      </div>
    </div>

    <section class="relative">

  <div class="relative max-w-8xl px-8 md:px-12 lg:px-32 mx-auto py-12 lg:py-12  space-y-24">
    <div class="grid grid-cols-1 gap-6 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="2xl:px-20">
        <h2 class="text-2xl xl:text-3xl 2xl:text-5xl mt-8 font-normal text-white tracking-tight">
           Gift Card Platform key features 
        </h2>
        <ul class="mt-4 text-base text-xl text-vulcan-300 ">
           <li>100’s of beautiful Gift Cards based on themes</li>
            <li>Upload your brand design Gift Cards</li>
            <li>Customize & Personalize gift card experience with your Picture and Video</li>
            <li>Send gift card via Multi-channel like email, Social media, SMS/Text, and Print-at-home.</li>  
        </ul>
          <div class="flex flex-wrap items-center gap-2 mt-10">
      
          </div>
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-2xl shadow-vulcan-950/50 w-full"
          src="/assets/giftcard_1.png"
        />
      </div>
    </div>
  </div>
</section>
