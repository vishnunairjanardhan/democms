---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-y border-gray-200">
  
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-[72px]">
    <div class="text-center max-w-4xl lg:mt-0 mx-auto">
      <h2 class="font-medium">Powering Global Reach and Future-Ready Commerce</h2>
    </div>
    <div class="grid grid-cols-1 mt-8 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-3 gap-x-10 lg:mx-8">
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="use gift card software for easy redemption" loading="lazy" src="/assets/multicurrency/globe-icon.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Global Distribution, Powered by Blackhawk
            </h3>
            <p class="mt-2 text-base">Sell your gift cards in over 500,000 retail locations across 28 countries and online. Expand your reach with ease.
</p>
          </div>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl">
            <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="create gift cards to improve cash flow" loading="lazy" src="/assets/multicurrency/plug&play.svg">
            </div>
          <h3 class="mt-5 text-xl text-black">
            Plug-and-Play Integration
          </h3>
          <p class="mt-2 text-base">99minds connects with Givex, Shift4, Fiserv, Clutch, and Paytronix. Streamline gift card redemption across Shopify and your tech stack.</p>
        </div>
      </div>
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-xl border shadow-vulcan-350 ">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div>
          <div class="text-indigo-400 w-14 h-14">
              <img class="" alt="Retain users with gift card software" loading="lazy" src="/assets/multicurrency/future-cart.svg">
            </div>
            <h3 class="mt-5 text-xl text-black">
              Built for the Future of Commerce
            </h3>
            <p class="mt-2 text-base">One API to rule them all. Enable gift card redemption through AI agents like ChatGPT and Perplexity.</p>
          </div>
        </div>
      </div>
    </div>

</section>



