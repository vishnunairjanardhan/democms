---
import Verticalgrid from "../assets/Verticalgrid.astro";
import { buttonConfig, cardData, Fashion, Others } from "../../config/CaseStudy.jsx";
---

<section class="relative">
  <div class="relative mx-auto max-w-7xl md:px-12 lg:px-0 lg:py-0">
    <div class="relative mt-10 w-full">
      <div class="relative w-full pt-8 content border-t mt-8 border-vulcan-800">
        <div class="flex pb-6 mt-2 justify-between items-center">
        <p class="font-semibold">Featured CaseStudy</p>
        <a class="font-medium cursor-pointer" href="/case-study">View All</a>
        </div>
        <div class="relative w-full" id="tabs-5-content-1">
          <section>
            <div class="py-10 w-full">
              <ol class="grid grid-cols-1 gap-16 lg:grid-cols-2 sm:grid-cols-2" role="list">
                {cardData.slice(0, 4).map((data) => (
                  <li key={data.title} class="group border bg-white border-white/5 overflow-hidden rounded-xl shadow-2xl">
                    <a href={data.href}>
                      <div class="flex items-end shadow-lg justify-center overflow-hidden rounded-t-xl">
                        <div class="flex">
                          {data.img ? (
                            <img 
                              class="group-hover:scale-110 duration-300 aspect-[2/1] object-cover" 
                              loading="lazy" 
                              src={data.img} 
                              alt={data.alt} 
                              width="630"
                            />
                          ) : data.videoId ? (
                            <iframe
                              class="group-hover:scale-110 duration-300 aspect-[2/1] object-cover"
                              src={`https://www.youtube.com/embed/${data.videoId}?enablejsapi=1&autoplay=1&mute=1&rel=0`}
                              title={data.title}
                              width="630"
                              height="315"
                              frameBorder="0"
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                              allowFullScreen
                              id="youtube-video"
                            ></iframe>
                          ) : null}
                        </div>
                      </div>
                      <div class="p-8">
                        <div class="flex">
                          <div class="basis-1/2"><img class="h-9" alt="" src={data.logo}></div>
                        </div>
                        <h2 class="text-xl font-semibold text-gray-700">{data.heading}</h2> 
                        <h2 class="mt-5 text-lg font-medium leading-6 text-gray-900">{data.title}</h2>
                        <p class="mt-2 text-base text-blue-600 line-clamp-1">{data.description}</p>
                        <a href={data.href} class="text-blue-600 mt-5 hover:underline">Read More</a>
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </div>           
          </section>
        </div>
      </div>
    </div>
  </div>
</section>