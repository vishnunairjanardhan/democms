---
import { Image } from "astro:assets";
import myImage from "../../assets/loyalty/customloyalty_1.webp";
import myImage1 from "../../assets/giftcard/pos.webp";
import myImage2 from "../../assets/giftcard/analyse.webp";
import myImage3 from "../../assets/giftcard/schedule_delivery.webp";
---
<section class="relative bg-[#FEFCF5]">
  
        <div class="mx-auto lg:text-center px-8 lg:pt-[72px]">
          <h2 class="font-medium">
            Gift Card & Platform features.
          </h2>
         
        </div>
       
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px]  md:space-y-24 space-y-5">
   <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="">
        <h2 class="font-medium">
           Leverage Customizable Gift Card Templates
        </h2>
        <p class="mt-4 text-[#4b4b4b]">Leverage hundreds of pre-existing themes for your gift cards or give it a personal touch with photos and videos of your choice. Customise gift card color and style to match your brand. </p>
         
      </div>
      
      <div class="h-full">
        <Image
            src={myImage}
            alt="Gift Card Templates"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last">
        <h2 class="font-medium">
          Integrate with your favourite POS
        </h2>
        <p class="mt-4 text-[#4b4b4b]">Issue and track gift cards with any popular POS (Point of Sale) like Square, Lightspeed, Heartland Retail, and more. Having gift card software will help you sell, redeem, reload, and check the balance of your customer's physical or digital gift cards.
        </p>
      </div>
      <div class="h-full">
        <Image
            src={myImage1}
            alt="POS"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <h2 class="font-medium">
          Analyse Gift Card Data
        </h2>
         <p class="mt-4 text-[#4b4b4b]">Keep an eye on customer data and gift card usage. Track and analyse the entire gift card life cycle, from issuance to order-level redemption. Use this data to break down user behaviour and set up engaging campaigns.</p> 
      </div>
      <div class="h-full">
        <Image
            src={myImage2}
            alt="Analyse Gift Card Data"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium">
          Schedule Delivery & Gift card for Out of Stock inventory
        </h2>
        <ul class="mt-4 ">
          <li>
              <div class="relative flex items-center py-2">
                <p class="leading-6 text-[#4b4b4b]">Out of stock gift card to retain customer
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <p class="leading-6 text-[#4b4b4b]">Gift card balance reminder email to customer
              </p></div>
           </li>
        </ul>
      </div>
      <div class="h-full">
        <Image
            src={myImage3}
            alt="Schedule Delivery"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 90vw, 836px"
            format="webp"
            quality={100}
            loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
