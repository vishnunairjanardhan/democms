---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div class="mx-auto lg:text-center px-8 lg:py-12">
        <h2 class="mt-8 text-white text-2xl xl:text-3xl 2xl:text-5xl font-normal tracking-tight text-white">
          Gift Card & Platform features.
        </h2>
         <p class="font-body text-xl xl:text-2xl mt-4 text-vulcan-300 ">
            All your gift card needs, covered</br>
        </p>
        </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
   <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 lg:gap-24">
      <div class=" ">
        <p class="text-3xl font-normal tracking-tight text-white">
           Gift Card Platform key features 
        </p>
        <ul class="mt-4 text-base text-vulcan-300 ">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">100’s of beautiful Gift Cards based on themes
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Upload your brand design Gift Cards
              </p></div>
           </li>
            <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Customize & Personalize gift card experience with your Picture and Video
              </p></div>
            </li>
            <li>
                <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Send gift card via Multi-channel like Email, Social media, SMS/Text, and Print-at-home.
              </p></div>
            </li>
             
        </ul>
          <!---<div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
          </div>--->
      </div>
      
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl <!---shadow-2xl---> shadow-vulcan-950/50 w-full"
          src="/assets/giftcard_1.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <p class="text-3xl font-normal tracking-tight text-white">
          Point of Sale
        </p>
       <ul class="mt-4 text-base text-vulcan-300 ">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Sell and Redeem Physical and Digital (eGift) Card issued by any POS like Square, Shopkeep, Vend, Revel, Poynt, Lightspeed, etc.
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Check balance, Reload Gift card at store and online
              </p></div>
           </li>

        </ul>
        
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/Pos.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class=" ">
        <p class="text-3xl font-normal tracking-tight text-white">
          Reporting & Analytics
        </p>
         <ul class="mt-4 text-base text-vulcan-300 ">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Gift card life-cycle management, tracking, and visibility from issuance to order level redemption
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Customer data reporting and analytics based on gift card usage.
              </p></div>
           </li>
        </ul>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/report.png"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <p class="text-3xl font-normal tracking-tight text-white">
          Schedule Delivery & Gift card for Out of Stock inventory
        </p>
        <ul class="mt-4 text-base text-vulcan-300 ">
          <li>
              <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Out of stock gift card to retain customer
              </p></div>
          </li>
           <li>
           <div class="relative flex items-center py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400 icon icon-tabler icon-tabler-circle-check" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M9 12l2 2l4 -4"></path></svg><p class="ml-2 text-base leading-6 text-vulcan-300">Gift card balance reminder email to customer
              </p></div>
           </li>
        </ul>
      </div>
      <div class="h-full">
        <img
          alt="Lexington thumbnail"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/schedule.png"
        />
      </div>
    </div>
  </div>
</section>
