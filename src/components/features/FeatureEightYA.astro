---
import Verticalgrid from "../assets/Verticalgrid.astro";
---
<section class="relative border-t border-y border-white/5">
  <div class="hidden pt-2 lg:block">
    <!-- Vertical grid (optional background or decorative) -->
  </div>

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="text-3xl font-normal tracking-tight text-balance text-black">
        Upgrade to 99minds and <br />
Save $500 Instantly 
      </h2>
     <p class="max-w-4xl mx-auto mt-4">Monthly Order Volumes</p>
     
    </div>

    <div class="grid grid-cols-1 mt-16 -mx-4 gap-y-10 sm:mx-auto lg:max-w-none md:grid-cols-2 lg:grid-cols-2 gap-x-10 lg:mx-8">
      <!-- Box 1 -->
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div class="text-indigo-400 text-center">
            <p>Yotpo Monthly Cost</p>
          </div>
          <p class="mt-2 text-base text-center">$79</p>
        </div>
      </div>

      <!-- Box 2 -->
      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-350">
        <div class="h-full p-8 bg-white rounded-3xl flex flex-col justify-between">
          <div class="text-indigo-400 text-center">
            <p>99minds Monthly Cost</p>
          </div>
          <p class="mt-2 text-base text-center">$19</p>
        </div>
      </div>   
  </div>
  <div class="text-center max-w-4xl mx-auto mt-12">
  <p class="text-lg font-semibold text-black">Your Monthly Savings: $1200</p>
</div>
<div class="text-center max-w-4xl mx-auto mt-12">
<button type="button" class="raise1 relative p-0.5 inline-flex items-center justify-center ml-4 overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });"> <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-10 duration-400 inline-flex items-center gap-2">
                  <svg role="img" alt="customer support logo" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-headset text-white" viewBox="0 0 16 16">
                    <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"/>
                  </svg>
                  <span class="relative text-white">Book a Demo</span> </span>
							</button>
                            </div>
</section>
