---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#91C8FA]">
  <Verticalgrid />
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px]  space-y-24" role="none">
    <div class="grid grid-cols-1 gap-4 list-none lg:grid-cols-2 lg:gap-24 ">
      <div>
        <p role="heading" class="lg:mt-24 text-5xl">
          Intelligent Workflows with Effective Results for Shopify
        </p>
        <p role="emphasis" class="mt-4 ">
            Create AI-powered automated workflows for your entire customer retention and promotion program. Grow your store and drive revenue with intelligent campaign automation.
        </p>
      </div>
      <div class="lg:mt-0 mt-12 h-full">
        <img
          role="img"
          alt="Wallet pass image"
          class="rounded-2xl shadow-vulcan-950/50" width="550" height="550"
          src="/assets/homepage/workflow1.svg"
        />
      </div>
    </div>
  </div> 
  <div class="bg-black">
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-[72px]  space-y-24" role="none"> 
      <ul class="grid grid-cols-1 lg:gap-16 lg:px-0 lg:text-left lg:grid-cols-3 lg:gap-12"
        role="list">
         <li class="">
          <div>
            <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Integrate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Integrate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
              Seamlessly integrate your loyalty program and other customer retention features with all popular third-party apps in the Shopify and Bigcommerce ecosystems. 99minds works with all popular CRMs, POS providers, marketing tools, and a whole lot of other apps.
          </p>
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Automate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Automate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
              Develop custom workflows to execute data-driven and sophisticated promotional campaigns. Effortlessly incorporate features such as store credit, coupons, gift cards, and digital wallets into intricate workflows designed to attract, convert, and retain customers.
          </p>
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Personalize.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Personalize</h3>           
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Design fully automated, data-driven campaigns personalized for your customers. Offer incentives based on each customer's activities and profile, including rewards, cashbacks, loyalty points, coupons, gift cards, store credits, and more, to enhance engagement and loyalty.
          </p>
        </li>
       
      </ul>
    </div>
  </div>
  </div>
</section>
