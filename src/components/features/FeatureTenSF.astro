---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative">
  <Verticalgrid />
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-12  space-y-24 bg-[#91C8FA]" role="none">
    <div class="grid grid-cols-1 gap-4 mt-6 list-none lg:grid-cols-2 lg:gap-24 ">
      <div>
        <p role="heading" class="lg:mt-24 text-5xl">
          Intelligent Workflows with Effective Results for Salesforce
        </p>
        <p role="emphasis" class="mt-4 ">
           Develop AI-driven workflows to enhance user engagement, retention, and acquisition. Expand your store and increase revenue through automated loyalty marketing strategies
        </p>
      </div>
      <div class="lg:mt-0 mt-12 h-full">
        <img
          role="img"
          loading="lazy"
          alt="Wallet pass image"
          class="rounded-2xl shadow-vulcan-950/50" width="550" height="550"
          src="/assets/homepage/workflow1.svg"
        />
      </div>
    </div>
  </div> 
  <div class="relative max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-12 lg:py-16  space-y-24 bg-black" role="none"> 
      <ul class="grid grid-cols-1 lg:gap-16 lg:px-6 mt-2 lg:text-left lg:grid-cols-3 lg:gap-12"
        role="list">
         <li class="">
          <div>
            <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Integrate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Integrate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Seamlessly integrate your salesforce store with leading eCommerce platforms and related apps, enabling more customized workflows. Effortlessly craft impactful and streamlined experiences at each point of the customer journey, all with just a few clicks.
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Automate1.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Automate
            </h3>
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Design customized workflows to deploy advanced, data-centric marketing campaigns. Effortlessly blend features such as Salesforce store credit, coupons, gift cards, and digital wallets into detailed workflows crafted to attract, convert, and retain customers.
          </p>
        </li>
        <li>
          <div>
           <div class="text-indigo-400">
              <img role="img" alt="gift card logo" class="py-4" width="38" height="24" src="/assets/homepage/Personalize.svg"/>
            </div>
            <h3
              role="heading"
              class="text-2xl font-medium text-white">
              Personalize</h3>           
          </div>
          <p role="definition" class="mt-2 text-base text-[#B9BABD]">
            Design fully automated, data-driven campaigns that are custom-tailored for your customers. Offer personalized incentives based on each customer's activities and profile, including rewards, cash backs, loyalty points, coupons, gift cards, store credits, and more, to enhance engagement and loyalty.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
