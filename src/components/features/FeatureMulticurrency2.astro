---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="relative bg-[#FEFCF5]">
  <Verticalgrid />
        <div class="mx-auto lg:text-center px-8 lg:py-2">
          <h2 class="mt-24 font-medium">
            What You Get with 99minds Multi-Currency Support
          </h2>
        
        </div>
       
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-8">
   <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="">
        <h2 class="font-medium">
          Worldwide Gifting Made Local
        </h2>
        <p class="mt-4">Issue and redeem gift cards in local currencies. Customers enjoy a seamless, familiar experience regardless of their location or preferred currency.
</p>
         
      </div>
      
      <div class="h-full ">
        <img
          alt="Gifting Made Local"
          class="rounded-2xl <!---shadow-2xl---> shadow-vulcan-950/50 w-full"
          src="/assets/multicurrency/global-gift.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last">
        <h2 class="font-medium">
          Smart Currency Conversion
        </h2>
        <p class="mt-4">Automatically detect user currency at checkout and convert accordingly. Ensure a smooth transaction process without manual adjustments or customer confusion. All currency conversions are controlled by Shopify's own exchange rate logic
        </p>
      </div>
      <div class="lg:justify-center mx-auto">
        <img
          alt="Currency Conversion"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/multicurrency/currency_conversion.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="">
        <h2 class="font-medium">
          Unified Multicurrency Dashboard
        </h2>
         <p class="mt-4">Access comprehensive multicurrency performance insights from a single dashboard. Track redemptions, revenue, and customer usage across all currencies in real-time.</p> 
      </div>
      <div class="h-full">
        <img
          alt="Multicurrency Dashboard"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/multicurrency/multicurrency_dashboard.webp"
        />
      </div>
    </div>
    <div
      class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:gap-24 items-center">
      <div class="sm:order-last  ">
        <h2 class="font-medium">
          Shopify-Ready Integration
        </h2>
        <p class="mt-4">Fully integrated with Shopify and Shopify Plus. 99minds enables instant deployment, automates syncing, and supports large-scale gift card operations effortlessly.</p>
      </div>
      <div class="h-full">
        <img
          alt="Shopify Integration"
          class="rounded-2xl shadow-vulcan-950/50 w-full"
          src="/assets/multicurrency/shopify_integration.webp"
        />
      </div>
    </div>
  </div>
</section>
