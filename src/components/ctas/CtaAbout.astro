---
import RoundedGrid from "../assets/RoundedGrid.astro";
---
<section class="relative border-t border-y border-black/5">
  

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="relative items-center">
      <div class="flex flex-col justify-between w-full lg:flex-row lg:items-center text-center"> 
        <div class="flex flex-col items-center text-center max-w-xl mx-auto lg:mr-10"">
          <h3 class="mt-8 text-3xl font-normal tracking-tight text-black">Let’s Talk</h3>
          <p class="mt-4 text-base">
            Tell us more and we’ll offer quick solutions.
            Or
            Get in touch through 99minds assistant. We’re eager to offer you a quick solution.
          </p>
          <div class="mt-8">
            <div class="flex justify-center items-center gap-2 mt-6"> 
              <a href="/contact" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gray-900 absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-10 duration-400">
                  <span class="relative text-white">Contact Us</span>
                </span>
              </a>
            </div>
          </div>
        </div>
        <div class="flex flex-col items-center text-center max-w-xl mx-auto lg:ml-10 mt-10 lg:mt-0">
          <h3 class="mt-8 text-3xl font-normal tracking-tight text-black">Explore 99minds</h3>
          <p class="mt-4 text-base">
            Take your customer engagement to the next level with a personalized Gift Card and loyalty program.
          </p>
          <div class="mt-8">
            <div class="flex justify-center items-center gap-2 mt-6"> 
              <button type="button" class="raise1 relative p-0.5 inline-flex items-center justify-center overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });"> <span class="w-full h-full bg-black text-white border border-black rounded-md group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span> <span class="relative px-4 py-2 transition-all ease-out rounded-md group-hover:bg-opacity-10 duration-400 inline-flex items-center gap-2">
								<svg role="img" alt="customer support logo" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" class="bi bi-headset text-white" viewBox="0 0 16 16">
									<path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"/>
								</svg>
								<span class="relative text-white">Book a Demo</span> </span>
							</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
