---
import RoundedGrid from "../assets/RoundedGrid.astro";
---
<section class="relative overflow-hidden border-t border-white/5">
  <RoundedGrid />

  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="relative items-center">
      <div class="flex flex-col justify-between w-full lg:flex-row lg:items-center text-center"> 
        <!-- First Section -->
        <div data-aos="fade-right" data-aos-duration="3000" class="flex flex-col items-center text-center max-w-xl mx-auto">
          <h3 class="mt-8 text-3xl font-normal tracking-tight text-white">Let’s Talk</h3>
          <p class="mt-4 text-base">
            Tell us more and we’ll offer quick solutions.
            Or
            Get in touch through 99minds assistant. We’re eager to offer you a quick solution.
          </p>
          <div data-aos="fade-left" data-aos-duration="3000" class="mt-8"> 
            <div class="flex justify-center items-center gap-2 mt-6"> 
              <a href="/contact" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-10 duration-400">
                  <span class="relative text-white">Contact Sales</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- Second Section -->
        <div data-aos="fade-right" data-aos-duration="3000" class="flex flex-col items-center text-center max-w-xl mx-auto mt-10 lg:mt-0">
          <h3 class="mt-8 text-3xl font-normal tracking-tight text-white">Explore 99minds</h3>
          <p class="mt-4 text-base">
            Take your customer engagement to the next level with a personalized Gift Card and loyalty program.
          </p>
          <div data-aos="fade-left" data-aos-duration="3000" class="mt-8"> 
            <div class="flex justify-center items-center gap-2 mt-6"> 
              <button type="button" class="raise relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md" onClick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-10 duration-400">
                  <span class="relative text-white">Book a Demo</span>
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
