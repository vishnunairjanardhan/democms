---
import ButtonsGrid from "../buttons/getStarted2";
---
<section class="relative">
  <div class="relative  w-full px-5 py-12 mx-auto md:px-12 lg:px-12 max-w-7xl lg:pb-16 pt-24 lg:pt-32">
    <div class="text-center">
    <div class="grid grid-cols-1">
      <img class="m-auto" width="474" height="145" src="/assets/square/99minds-Square.svg" alt="" loading="lazy">
      </div>
      <h1 class="">Connect 99minds to Square POS</h1>
      <p class="max-w-4xl mx-auto mt-4">Square POS has teamed up with 99minds to enhance your gifting experience and deepen customer connections through innovative loyalty and rewards programs, available both online and in-store.</h5>
      <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto mt-10 sm:flex-row">
          <a href="https://giftcard.99minds.io/access/register" target="_blank" class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium">
                <span class="w-full h-full bg-black absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
                <span class="relative text-white">Connect to Square</span>
                </span>
          </a>
        </div>
      </div>
    </div>
  </div>
     <div class="relative px-8 py-4 mx-auto max-w-7xl md:px-12 lg:px-8 lg:py-0">
    <!-- Buttons -->
      <ButtonsGrid client:load/>
  </div>
  </div>
</section>