---
import ButtonsGrid from "../buttons/getStarted2";
---
<section class="relative">
  <div class="relative w-full px-5 py-12 mx-auto md:px-12 lg:px-12 max-w-7xl lg:pb-8 pt-24 lg:pt-32">
    <div class="text-center">
    <div class="grid grid-cols-1 place-content-center">
      <img class="m-auto " src="/assets/bigcommerce/99minds-BC2.svg" width="592" height="181" loading="lazy" alt="99minds and Bigcommerce integration">
      </div>
      <h1 class="mt-2">Bigcommerce and 99minds Integration</h1>
      <p class="max-w-4xl mx-auto mt-4">Add 99minds app to your Bigcommerce store and develop robust loyalty programs and gift cards experience. Install today to enhance sales and customer loyalty.
</p>
      <div class="flex flex-col justify-center max-w-xl gap-2 mx-auto sm:flex-row">
      <div class="flex flex-wrap justify-center gap-2 lg:mt-10">
          <a href="https://www.bigcommerce.com/apps/99minds-gift-card/" target="_blank" class="raise1 relative py-2 px-4 inline-flex items-center justify-center font-bold overflow-hidden group rounded-lg font-medium">
                <span class="w-full h-full bg-white absolute border border-black rounded-lg"></span>
                <span class="relative text-black">Install 99minds on </span><img class="z-40 m-auto ml-2" width="120" src="/assets/homepage/Bcom-l.svg" alt="99minds and Shopify Integration">
                </span>
          </a>
          </div>
      </div>
      </div>
    </div>
  </div>
    <div class="relative px-8 py-4 mx-auto max-w-7xl md:px-12 lg:px-8 lg:py-0">
    <!-- Buttons -->
      <ButtonsGrid client:load/>
  </div>
  </div>
</section>