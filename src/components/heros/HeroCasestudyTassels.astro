---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-full h-20 object-cover bg-opacity-50"></div> <!-- Fixed width with w-full -->
</section>

<section class="relative pt-2 y-12 mt-12 mx-auto max-w-7xl">
  <div class="relative">
    <!-- <img src="/assets/case-study/tassels1.png" alt="Background Image" class="h-[40rem] object-cover rounded-t-2xl">  Use w-full instead of w-screen -->
<div class="flex items-center justify-center">
  <iframe class="rounded-md" 
        src="https://www.youtube.com/embed/W1vkcWAw-zo?enablejsapi=1&autoplay=1" 
        title="YouTube video player" 
        frameborder="0" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen 
        width="1432" 
        height="640" 
        id="youtube-video">
  </iframe>
</div>  
  <script>
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);

    let player;

    function onYouTubeIframeAPIReady() {
      player = new YT.Player('youtube-video', {
        events: {
          'onReady': onPlayerReady
        }
      });
    }

    function onPlayerReady(event) {
      const videoElement = document.getElementById('youtube-video');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.intersectionRatio >= 0.5) {
            player.playVideo();
          } else {
            player.pauseVideo();
          }
        });
      }, { threshold: [0.5] });

      observer.observe(videoElement);
    }

    // Fallback in case YouTube API takes time to load
    if (!window.YT) {
      window.onYouTubeIframeAPIReady = onYouTubeIframeAPIReady;
    }

  </script>
   <div class="absolute inset-0 bg-black bg-opacity-30 rounded-t-2xl"></div>
   <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
     <h1 class="relative px-4 py-6 mt-[10rem] sm:mt-48 md:mt-96 lg:mt-[30rem] mx-auto max-w-lg sm:max-w-xl md:max-w-2xl lg:max-w-7xl text-xl sm:text-2xl md:text-3xl lg:text-4xl text-white">
       Tassel gained a 15% Conversion Rate and boosted Customer retention by 40% with Store Credit as Cashback and Loyalty program
     </h1>
   </div>
   
</section>
