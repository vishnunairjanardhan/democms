---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-full h-20 object-cover bg-opacity-50"></div> <!-- Fixed width with w-full -->
</section>

<section class="relative pt-2 y-12 mt-12 mx-auto max-w-7xl">
  <div class="relative">
    <!-- <img src="/assets/case-study/tassels1.png" alt="Background Image" class="h-[40rem] object-cover rounded-t-2xl">  Use w-full instead of w-screen -->
    <div class="flex items-center justify-center">
    <video class="rounded-lg shadow-2xl items-center w-full rounded-t-2xl" playsinline>
      <source src="/videos/Tassels.mp4" type="video/mp4">
    </video>
  </div>

  <script>
    // Select the video element
    const video = document.querySelector('video');

    // Function to play the video when it becomes visible
    const playVideoWhenVisible = (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          video.play();
        } else {
          video.pause();
        }
      });
    };

    // Create an Intersection Observer
    const observer = new IntersectionObserver(playVideoWhenVisible, {
      threshold: 0.5  // Play when 50% of the video is visible
    });

    // Observe the video element
    observer.observe(video);
  </script>
    <div class="absolute inset-0 bg-black bg-opacity-30 rounded-t-2xl"></div> <!-- Added rounded-2xl to match image and prevent overflow -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
      <h1 class="relative px-8 py-12 mt-0 mx-auto max-w-7xl md:px-12 lg:px-16 text-white">
        Tassel gain 15% Conversion Rate and boost Customer retention by 40% with Store Credit as Cashback and Loyalty program
      </h1>
    </div>
  </div>
</section>
