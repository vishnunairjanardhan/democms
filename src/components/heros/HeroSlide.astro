---
import TESTIMONIAL from "../../config/Testimonial.json";
---

<section class="relative">
  <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-7xl lg:px-0 mx-auto px-6 right-0">
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
  </div>

  <div class="relative items-center w-full px-5 pt-24 mx-auto md:px-12 lg:px-16 max-w-7xl lg:py-16">
    <div class="grid grid-cols-1 gap-6 p-0 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-24 lg:p-0 lg:pt-8">
      <div class="relative items-center gap-8 pb-12 m-auto lg:inline-flex md:order-first lg:pb-32 xl:pt-0">
        <div class="max-w-xl text-center lg:text-left">
          <h1 class="mt-8 font-bold">Engage, Acquire & Retain Customers</h1>
          <p class="max-w-2xl mt-4">Enrich your Customer Journey with a Gift Card, Store Credit, and Loyalty Program. Empower them to share your brand experience with Referrals</p>
          <div class="mt-2" x-data="{ open: false }">
  
  <span @click="open = true">
    <button
      type="button"
      role="button"
      aria-label="Get Started for Free"
      class="raise1 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md font-medium mt-4"
    >
      <span class="w-full h-full bg-black group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
      <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 duration-400">
        <span class="relative text-white">Get started for free</span>
      </span>
    </button>
  </span>

  <div
    x-show="open"
    @keydown.escape.window="open = false"
    class="fixed inset-0 z-50 w-screen overflow-y-auto"
    style="display: none"
    x-transition
  >
   
    <div
      class="fixed inset-0 bg-vulcan-950 bg-opacity-50"
      @click="open = false"
    ></div>

    <div class="relative flex min-h-screen items-center justify-center p-4">
      <div
        @click.stop
        class="relative w-full max-w-3xl overflow-y-auto shadow-2xl rounded-3xl p-[0.060rem]"
      >
        <div class="bg-white rounded-3xl p-4 text-center">
          <iframe
            src="../GetStarted"
            width="100%"
            height="600"
            frameborder="0"
            allowfullscreen
            title="Get Started"
          ></iframe>
        </div>
      </div>
    </div>
    
  </div>
   <div class="flex items-center gap-2 mt-6">
                <img
                  src="data:image/svg+xml;base64,"
                  alt=""
                  class="h-4 w-6"
                />
                <p class="font-bold text-gray-700 text-md">No Credit Card Required</p>
          </div>
        </div>
        </div>
      </div>
      <div class="rounded-3xl relative h-auto video-container overflow-hidden">
        <section>
          <div class="mx-auto lg:px-4 md:px-2 items-center w-full">
            <div class="flex flex-col w-full" x-data="{
            currentSlide: 0,
            totalSlides: 6,
            interval: null,
            slider: null,
            slideWidth: 0,
            isTransitioning: false,

            next() {
           if (this.isTransitioning) return;
    
            this.isTransitioning = true;
            this.currentSlide++;
    
           
           this.slider.style.transition = 'transform 0.5s ease-in-out';
           this.slider.style.transform = `translateX(-${this.currentSlide * this.slideWidth}px)`;
    
           setTimeout(() => {
           if (this.currentSlide >= this.totalSlides) {
           // Reset to first slide without transition
           this.slider.style.transition = 'none';
           this.currentSlide = 0;
           this.slider.style.transform = `translateX(0px)`;
        
           // Re-enable transitions after a brief moment
           setTimeout(() => {
           this.slider.style.transition = 'transform 0.5s ease-in-out';
           }, 50);
         }
           this.isTransitioning = false;
      }, 500);
  },

      startAutoSlide() {
      this.interval = setInterval(() => this.next(), 2500);
  },

    stopAutoSlide() {
    clearInterval(this.interval);
  },

    init() {
    this.slider = this.$refs.slider;
    this.slideWidth = this.slider.children[0].offsetWidth + 12; // width + gap
    this.startAutoSlide();
    
    // Handle window resize
    window.addEventListener('resize', () => {
      this.slideWidth = this.slider.children[0].offsetWidth + 12;
      this.slider.style.transform = `translateX(-${this.currentSlide * this.slideWidth}px)`;
    });
  }
}"
     x-init="init"
     @mouseenter="stopAutoSlide()"
     @mouseleave="startAutoSlide()"
     role="button">
              <div class="flex flex-col w-full" aria-labelledby="carousel-label" role="region" tabindex="0">
                <div class="overflow-hidden">
                  <ul
                    x-ref="slider"
                    class="flex gap-3 pb-6 pt-4 w-full"
                    style="transition: transform 0.5s ease-in-out;"
                  >
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/loyalty/Loyalty-banner1.webp" alt="Loyalty Program">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Loyalty Program</h3>
                          <p class="text-sm text-gray-600">Build customer loyalty with points, rewards, and exclusive benefits that keep them coming back.</p>
                        </figcaption>
                      </figure>
                    </li>
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/giftcardBanner1.png" alt="Gift Cards">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Gift Cards</h3>
                          <p class="text-sm text-gray-600">Increase revenue and attract new customers with customizable digital gift cards.</p>
                        </figcaption>
                      </figure>
                    </li>
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/storecredit/store-credit-banner.webp" alt="Store Credit">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Store Credit</h3>
                          <p class="text-sm text-gray-600">Retain customers and reduce refunds by offering flexible store credit options.</p>
                        </figcaption>
                      </figure>
                    </li>
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/coupons/coupon-banner2.webp" alt="Coupons & Discounts">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Coupons & Discounts</h3>
                          <p class="text-sm text-gray-600">Drive sales with targeted promotional campaigns and personalized discount codes.</p>
                        </figcaption>
                      </figure>
                    </li>
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/referral/referral-banner1.webp" alt="Referral Program">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Referral Program</h3>
                          <p class="text-sm text-gray-600">Turn customers into brand advocates with rewarding referral incentives.</p>
                        </figcaption>
                      </figure>
                    </li>
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/automation/automationBanner1.webp" alt="Marketing Automation">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Marketing Automation</h3>
                          <p class="text-sm text-gray-600">Streamline your marketing efforts with intelligent automation workflows.</p>
                        </figcaption>
                      </figure>
                    </li>
                
                    <li class="w-full flex flex-col shrink-0" role="option">
                      <figure class="text-center">
                        <div class="lg:mt-0 mb-4 shadow-3xl rounded-3xl p-[0.060rem] w-full">
                          <div class="mt-0 lg:mt-0 lg:flex lg:w-[32rem] lg:items-center">
                            <img class="object-cover object-center rounded-xl" loading="lazy" src="/assets/loyalty/Loyalty-banner1.webp" alt="Loyalty Program">
                          </div>
                        </div>
                        <figcaption class="mt-4 px-4">
                          <h3 class="text-lg font-semibold text-gray-800 mb-2">Loyalty Program</h3>
                          <p class="text-sm text-gray-600">Build customer loyalty with points, rewards, and exclusive benefits that keep them coming back.</p>
                        </figcaption>
                      </figure>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>    
    </div>
  </div>
</section>