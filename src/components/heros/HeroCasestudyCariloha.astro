---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-full h-20 object-cover bg-opacity-50"></div>
</section>

<section class="relative pt-2 mt-12 mx-auto max-w-7xl">
  <div class="relative">
    <img 
      src="/assets/case-study/cariloha.png" 
      alt="Cariloha gift card promotion banner" 
      class="h-[40rem] w-full object-cover rounded-t-2xl" 
    >
    
    <div class="absolute inset-0 bg-black bg-opacity-50 rounded-t-2xl"></div> 
    
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
      <h1 
        class="relative px-8 py-12 mt-0 mx-auto max-w-7xl md:px-12 lg:px-16 text-white"
        aria-label="Cariloha’s Social Media Gift Card Promotion Drives Customer Acquisition by 30%"
      >
        Cariloha’s Social Media Gift Card Promotion Drives Customer Acquisition by 30%
      </h1>
    </div>
  </div>
</section>
