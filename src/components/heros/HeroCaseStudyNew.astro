      <div class="flex flex-col rounded-3xl p-[0.060rem] shadow-2xl shadow-vulcan-950 bg-gradient-to-b from-slate-800 via-indigo-500/5">
        <div class="h-full p-6 bg-vulcan-900 rounded-3xl flex flex-col justify-between">
          
          <div class="text-indigo-400">
            <img class="w-full" alt="Retain users with gift card software" loading="lazy" width="350" src="/assets/case-study/hexclad-1.webp">
          </div>
          
          <div class="mt-6 text-indigo-400">
            <h2 class="text-xl font-semibold">HEXCLAD</h2> 
            <h3 class="text-lg mt-4">$450k within first 90 days</h3> 
          </div>
          
          <p class="mt-2 text-lg">
            Hexclad partnered with rivo to launch their tiered loyalty program
          </p>
          
