---
import Verticalgrid from "../assets/Verticalgrid.astro";
import CaseStudyTab from "../../components/features/CaseStudyTab.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
import RoundedGrid from "../assets/RoundedGrid.astro";
---
<section class="relative">
  <Verticalgrid />
  <!--<div class="w-screen flex justify-item-center">
    <video class="mt-24 w-screen responsive-video-file" aria-describedby="Sprocket Rocket Demo" autoplay="" loop="" muted="" playsinline="">
      <source src="/testimonial.mp4" type="video/mp4">
    </video>
  </div>-->
  <div class="relative px-8 py-12 mx-auto space-y-24 max-w-7xl md:px-12 lg:px-16 lg:py-24 lg:pt-36 text-center">
    <div class="max-w-2xl mx-auto">
      <div data-aos="fade-down" data-aos-duration="2000">
        <span
          class="text-xs font-medium tracking-widest text-transparent uppercase bg-clip-text bg-gradient-to-r from-indigo-300 via-indigo-400 to-indigo-500"
          >case studies</span
        >
        <h1
          class="mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">
         
          <span class="block">Explore customer stories</span>
        </h1>
        <p class="max-w-xl mt-4 text-base text-vulcan-300 mx-auto">
          See how brands like yours built strong relationships with 99minds.
        </p>
      </div>
    </div>
  </div>
<section class="relative border-t border-white/5">
