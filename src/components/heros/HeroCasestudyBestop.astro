---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-full h-20 object-cover bg-opacity-50"></div> 
</section>

<section class="relative pt-2  mt-12 mx-auto max-w-7xl">
  <div class="relative">
    <img 
      src="/assets/case-study/Bestop-banner.webp" 
      alt="Bestop banner featuring Heather Storm Off-Road Series" 
      class="h-[40rem] w-full object-cover rounded-t-2xl" 
    >
    
    <div class="absolute inset-0 bg-black bg-opacity-50 rounded-t-2xl"></div> 

    <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
      <h1 
        class="relative px-8 py-12 mt-0 mx-auto max-w-7xl md:px-12 lg:px-16 text-white text-2xl md:text-4xl font-semibold"
        aria-label="Bestop increased Conversion Rate by 15% with a Gift Card Promo on Facebook featuring Heather Storm Off-Road Series."
      >
        Bestop increased Conversion Rate by 15% with a Gift Card Promo on Facebook featuring 
        <strong class="font-bold">Heather Storm</strong> Off-Road Series.
      </h1>
    </div>
  </div>
</section>
