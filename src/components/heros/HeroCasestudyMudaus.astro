---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-full h-20 object-cover bg-opacity-50"></div> <!-- Fixed width with w-full -->
</section>

<section class="relative pt-2 y-12 mt-12 mx-auto max-w-7xl">
  <div class="relative bg-vulcan-900 rounded-t-2xl">
    <img src="/assets/case-study/mud-Aus-banner.svg" aria-hidden="true" alt="Background Image" class="h-[40rem] object-cover rounded-t-2xl"> <!-- Use w-full instead of w-screen -->
    <div class="absolute inset-0 bg-black bg-opacity-30 rounded-t-2xl"></div> <!-- Added rounded-2xl to match image and prevent overflow -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
      <h1 class="relative px-8 py-12 mt-0 mx-auto max-w-7xl md:px-12 lg:px-16 text-white">
        38% increase in AOV due to Omnichannel & Multi-Currency Gift Card Transformation
      </h1>
    </div>
  </div>
</section>
