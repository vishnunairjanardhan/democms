---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <div class="w-screen h-24 object-cover bg-opacity-50"></div>
</section>
<section class="relative">
  <img src="/assets/MudAustralia.png" alt="Background Image" class="w-screen h-96 object-cover">
  <div class="absolute inset-0 bg-black bg-opacity-50"></div> <!-- Overlay for better text visibility -->
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
    <h1 class="relative px-8 py-12 mt-12 mx-auto max-w-7xl md:px-12 lg:px-16">MudAustralia's Omnichannel & Multi-Currency Gift card Transformation leads to growth</h1>
  </div>
</section>
