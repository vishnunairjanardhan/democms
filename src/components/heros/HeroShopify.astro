---
import ButtonsGrid from "../buttons/getStarted2";
---
<section class="relative">
  <div class="relative w-full px-5 py-12 mx-auto md:px-12 lg:px-12 max-w-7xl lg:pb-0 pt-24 lg:pt-32">
    <div class="text-center">
    <div class="grid grid-cols-1 place-content-center">
      <img class="m-auto" width="474" height="181" src="/assets/shopify/99minds-Shopify.svg" alt="99minds and Shopify Integration">
      </div>
      <h1 class="mt-2">Shopify and 99minds Integration</h1>
      <p class="max-w-5xl mx-auto mt-4">Countless Shopify stores trust 99minds for creating impactful Shopify loyalty programs and enhancing Shopify gift card experience. Integrate now to boost sales and customer retention.</p>
        <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto py-8 sm:flex-row">
           <p clas="justify-center mx-auto">
            <span class="flex">
            <img src="/5-star.svg" alt="5 stars" class="w-24 h-auto mr-2 justify-center mx-auto" />
            5 Star Reviews
            </span>
          </p>
        </div>
      <div class="flex flex-wrap justify-center max-w-xl gap-2 mx-auto  sm:flex-row">
          <a href="https://apps.shopify.com/99minds-gift-card-loyalty-referral#" target="_blank" class="raise1 relative p-4 inline-flex items-center justify-center font-bold overflow-hidden group rounded-lg font-medium">
                <span class="w-full h-full bg-white absolute border border-black rounded-lg"></span>
                <span class="relative text-black">Install on </span><img class="z-40 m-auto ml-2" width="90" src="/assets/shopify/Shopify-logo.svg" alt="99minds and Shopify Integration">
                </span>
          </a>
        </div>
         
        </div>
      </div>
  </div>
  
    <!---<div class="relative px-8 py-4 mx-auto max-w-7xl md:px-12 lg:px-8 lg:py-0">
      <ButtonsGrid client:load/>
  </div>-->
  </div>
</section>

