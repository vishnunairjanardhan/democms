---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---



<section class="relative">
  <div class="w-full h-full -z-1 absolute flex flex-row justify-between left-0 lg:h-full lg:max-w-8xl lg:px-0 mx-auto px-6 right-0">
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
    <div class="w-full h-full border-[#f5f5f510]/5 border-x border-dashed"></div>
  </div>
  <svg class="absolute blur-3xl right-0 opacity-80" width="50%" height="100%" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g clip-path="url(#clip0_17_60)">
      <g filter="url(#filter0_f_17_60)">
        <path d="M128.6 0H0V322.2L332.5 211.5L128.6 0Z" fill="#4D07E3"></path>
        <path d="M0 322.2V400H240H320L332.5 211.5L0 322.2Z" fill="#4C00FF"></path>
        <path d="M320 400H400V78.75L332.5 211.5L320 400Z" fill="#7fcef3"></path>
        <path d="M400 0H128.6L332.5 211.5L400 78.75V0Z" fill="#7fcef3"></path>
      </g>
    </g>
    <defs>
      <filter id="filter0_f_17_60" x="-159.933" y="-159.933" width="719.867" height="719.867" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
        <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"></feBlend>
        <feGaussianBlur stdDeviation="79.9667" result="effect1_foregroundBlur_17_60"></feGaussianBlur>
      </filter>
    </defs>
  </svg>
  <div class="relative items-center w-full px-5 pt-36 mx-auto md:px-12 lg:px-12 max-w-7xl lg:pt-30">
    <div class="grid grid-cols-1 gap-6 p-8 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-24 lg:p-4 lg:pb-20">
      <div class="relative items-center gap-12 pb-12 m-auto lg:inline-flex md:order-first lg:pb-32 xl:pt-10">
        <div class="max-w-xl text-center lg:text-left">
          <p class="text-sm text-transparent uppercase bg-gradient-to-r from-indigo-300 to-indigo-400 bg-clip-text">Case Study</p>
          <p class=" uppercase mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">Uplifting Flight:</p>
          <p class=" max-w-2xl mt-4 text-xl text-vulcan-300">Birdsnest Migrates to ConnectPOS with 99minds to Enhance Omnichannel Experience</p>
          <!---<div class="flex flex-wrap items-center gap-2 mt-10">
            <a href="https://lexingtonthemes.lemonsqueezy.com/checkout/buy/cad98266-24b3-47fd-99a6-e65ad9af37f6" class="flex items-center justify-center h-10 px-4 py-2 text-sm font-semibold text-white transition-all rounded-lg hover:to-indigo-600 bg-gradient-to-b from-indigo-300 via-indigo-400 to-indigo-500">Buy Navy</a>
            <a href="/system/overview" class="flex items-center justify-center h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">See all pages</a>
          </div>--->
        </div>
      </div>
      <div class="relative order-first w-full lg:block">
        <img class="object-cover object-center w-full mx-auto my-auto shadow-l lg:absolute lg:ml-auto shadow-black" alt="hero" src="/assets/birdsnesthero1.png">
      </div>
    </div>
  </div>
</section>
