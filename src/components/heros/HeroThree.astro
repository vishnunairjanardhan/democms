---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<section class="relative">
  <Verticalgrid />
  <Blurgradientleft />
  <div class="relative max-w-8xl items-center w-full px-5 pt-24 mx-auto md:px-12 lg:px-12 lg:pt-36">
    <div class="grid grid-cols-1 gap-6 p-8 pb-0 overflow-hidden lg:grid-cols-2 lg:gap-24 lg:p-20 lg:pb-20">
      <div class="relative items-center gap-12 pb-12 m-auto lg:inline-flex md:order-first xl:py-6 2xl:pb-20 2xl:px-10">
        <div class="max-w-2xl text-center lg:text-left">
          <h1 class="mt-8 font-semibold text-white text-3xl xl:text-4xl 2xl:text-6xl">
            <span class="text-indigo-800">Gift Card</span> Management Cloud for Ecommerce
          </h1>
          <p class="font-body text-2xl max-w-2xl mt-4 text-vulcan-300 ">
          Online solution to manage and scale gift cards, store credit, digital wallets, and loyalty programs. Build better brands to acquire, engage, and retain lifelong customers.
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-10">
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-100 duration-400">
                <span class="relative text-white">Sign Up Free</span>
                </span>
              </a>
              <a href="#_" class="relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md">
                <span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] group-hover:from-[#ff00c6] group-hover:via-[#ff5478] group-hover:to-[#ff8a05] absolute"></span>
                <span class="relative px-4 py-2 transition-all ease-out bg-gray-900 rounded-md group-hover:bg-opacity-0 duration-400">
                <span class="relative text-white">Contact Sales</span>
                </span>
              </a>
          </div>
        </div>
      </div>
      <div class="relative order-first hidden w-full lg:block">
        <img
          class="object-cover object-center w-full mx-auto shadow-2xl lg:absolute lg:ml-auto shadow-black"
          alt="hero"
          src="/assets/retain-be74a8698db45dee238bd377cf9db6ee.png"
        />
      </div>
    </div>
  </div>
</section>
