---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
import BookDemoButton from "../buttons/bookDemoButton";

---

<section class="relative pt-2 y-12 mt-12 mx-auto max-w-7xl">
  <div class="relative">
<div class="flex items-center justify-center bg-vulcan-900 rounded-t-2xl">
  <iframe class="rounded-t-2xl" 
        aria-hidden="true"
        src="https://www.youtube.com/embed/W1vkcWAw-zo?enablejsapi=1&autoplay=1?rel=0" 
                title="YouTube video player" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen 
                width="1432" 
                height="640" 
                id="youtube-video">
        </iframe>
      </div>
      
      <script>
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);
      
        let player;
      
        function onYouTubeIframeAPIReady() {
          player = new YT.Player('youtube-video', {
            events: {
              'onReady': onPlayerReady
            }
          });
        }
      
        function onPlayerReady(event) {
      
          const videoElement = document.getElementById('youtube-video');
      
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio >= 0.5) {
                player.unMute();  // Unmute when visible
                player.playVideo();
              } else {
                player.mute(); // Mute when not visible
                player.pauseVideo();
              }
            });
          }, { threshold: [0.5] });
      
          observer.observe(videoElement);
        }
      
        // Set a fallback in case YouTube API takes time to load
        if (!window.YT) {
          window.onYouTubeIframeAPIReady = onYouTubeIframeAPIReady;
        }
      </script>
   <section className="text-center pt-20 lg:pt-28">
          <h1 className="py-4 mt-4 mx-auto justify-center text-center flex text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold leading-snug md:max-w-3xl">
            Discover The Future of Retail Promotions with 99minds at NRF 2026
          </h1>

          <p className="max-w-xs sm:max-w-md md:max-w-4xl mx-auto text-base sm:text-lg text-gray-600 mb-8 text-center leading-relaxed">
            Promotions shouldn’t be guesswork. They should be autonomous.
At NRF 2026, 99minds is showcasing an AI-powered automation platform that continuously monitors real-time customer and business signals to deploy the most profitable promotion for each shopper—automatically.

          </p>

          <div
            className="flex flex-wrap items-center justify-center gap-4 px-8"
            role="group"
          > 
            <BookDemoButton />
          </div>
    </section>
</section>
