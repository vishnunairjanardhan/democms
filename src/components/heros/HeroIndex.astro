---
import  TabbedImages from "../features/FeartureTabs.jsx";
import GetStartedButton from "../buttons/GetStartedButton.astro";
import BookDemoButton from "../buttons/BookDemoButton.astro";
---


 <section>
  <div class="relative max-w-7xl px-0 md:px-12 lg:px-16 mx-auto py-4 lg:py-6">

      <section class="text-center px-6 pt-20 lg:pt-28"> 
            <h1 class="py-4 mt-4 mx-auto text-center text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold leading-snug max-w-xs lg:max-w-7xl md:max-w-3xl">Automate Growth.<span class="text-[#EF5A3C]"> Amplify Results.</span> </h1>
        <p class="max-w-xs sm:max-w-md md:max-w-4xl mx-auto text-base sm:text-lg text-gray-600 mb-6 text-center leading-relaxed">
            Instantly Launch Gift Cards, Store Credit & Automated Promotions via Apple and Google Wallets. Boost Revenue and Customer Loyalty Across Your Retail & eCommerce Stores
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4" role="group">
						<GetStartedButton/>
						<BookDemoButton/>
		</div>
     <TabbedImages client:load/>
    </section>


</div>
</section>
