---
import ButtonsGrid from "../buttons/getStarted2";
---

<section class="relative">
  <!-- Background grid lines -->
  <div class="absolute inset-0 flex flex-row justify-between w-full h-full -z-10 lg:max-w-7xl lg:mx-auto lg:px-0">
    {[...Array(6)].map(() => (
      <div class="w-full h-full border-x border-dashed border-[#f5f5f510]/5"></div>
    ))}
  </div>

  <!-- Content -->
  <div class="relative w-full max-w-7xl px-5 py-12 lg:py-0 mx-auto md:px-12 lg:px-12 pt-24 lg:pt-32">
    <div class="text-center">
      <!-- Logo -->
      <div class="grid grid-cols-1">
        <img 
          class="m-auto" 
          src="/assets/heartland/99minds-HLG.webp" 
          width="512" 
          height="157" 
          alt="99minds and Heartland integration" 
          loading="lazy" 
        />
      </div>

      <!-- Heading -->
      <h1 class="mt-6">99minds Integrates with Heartland</h1>

      <!-- Subtext -->
      <p class="max-w-5xl mx-auto my-4 pb-4">
        Heartland Retail has partnered with 99minds to help you build seamless gifting 
        experiences and profitable customer relationships with smart loyalty and rewards, 
        online and in-person.
      </p>

      <!-- Buttons -->
      <ButtonsGrid client:load/>
    </div>
  </div>
</section>
