---
import TabbedImages from "../features/FeatureTrybadge.jsx";
import GetStartedButton from "../buttons/GetStartedButton.astro";
import BookDemoButton from "../buttons/BookDemoButton.astro";
---


 <section>
  <div class="relative max-w-7xl px-0 md:px-4 lg:px-6 mx-auto py-4 lg:py-6">

      <section class="text-center px-6 pt-20 lg:pt-28"> 
         <h1 class="py-4 mt-4 mx-auto text-center text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold leading-snug max-w-xs lg:max-w-7xl md:max-w-3xl">Turning Every Mobile into a <span class="text-[#EF5A3C]">Revenue Channel</span> </h1>
      <p class="max-w-xs sm:max-w-md md:max-w-2xl mx-auto text-base sm:text-lg text-gray-600 mb-6 text-center leading-relaxed">
       Create Branded Mobile Wallet Passes, Gift Cards & Loyalty Rewards for Apple Wallet and Google Pay
      </p>
    <div class="lg:flex justify-center gap-2 mt-10" role="group">
		<GetStartedButton/>
		<BookDemoButton/>					
	</div>
     <TabbedImages client:load/>
    </section>


</div>
</section>
