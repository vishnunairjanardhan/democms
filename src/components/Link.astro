---
interface Props {
    text: string;
    href: string;
    icon?: {
    name: string;
    side: "left" | "right";
    };
    isFilled?: boolean;
    borderVisible?: boolean;
    classes?: string;
}
const {
    text,
    href,
    icon,
    isFilled=true,
    borderVisible=true,
    classes,
    ...rest
} = Astro.props as Props;
---
<>
<a href={href}
class="h-8 text-xs px-4 py-2 font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700"
>
<span>
    {text}
</span>
</a>
</>