<section
  aria-labelledby="logocloud"
  id="logocloud "
  class="flex items-end justify-center bg-vulcan-900 border-t border-white/60 border-y border-white/5 px-8 mx-auto max-w-7xl md:px-12 lg:px-16 rounded-b-2xl" style="background-image: linear-gradient(to top, #DABCA8 , #CBA286);">
  <div
    class="justify-center px-8 mx-auto max-w-7xl md:px-12 lg:px-0">
    <ul class="grid grid-cols-1 gap-6 list-none sm:grid-cols-2 md:grid-cols-4 lg:gap-8 lg:mt-0 py-4 text-center" role="list">
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black">38% </h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Increase Average Spend Over Gift Card Value</div>
      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black">30%</h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Increase in Sales due to rise in Gift Card Redemption frequency</div>
      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black whitespace-nowrap">Saved 400hrs</h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Manual Work</div>
      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black whitespace-nowrap">AUS $ USD $ GBP £</h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Multi-Currency </div>
      </li>
    </ul>
  </div>
</section>
