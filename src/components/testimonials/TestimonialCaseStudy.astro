---
import RoundedGrid from "../assets/RoundedGrid.astro";
---

<section>
<div class="relative overflow-hidden border-t border-white/5">
  <!--<RoundedGrid />-->
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-14">
    <div class="relative items-center">
      <div class="flex flex-col justify-center w-full lg:flex-row lg:items-start">
        <div class="max-w-2xl px-6 ">
            <p class="text-white mt-12 text-xl text-vulcan-300">
                "One stop solution for Marketing and Promotion.Complete automation for gift cards and Coupons based on Customer Journey."
            </p>
            <p class="text-white mt-4 text-xl text-vulcan-300">
                - JOSH KIKKERT, DIRECTOR OF E-COMMERCE, CARILOHA
            </p>
        </div>
      </div>
    </div>    
  </div>
</div>
<div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-14">
    <img alt="Lexington thumbnail" class="rounded-2xl shadow-2xl shadow-vulcan-950/50 h-64 absolute bottom-0 left-4 mb-4 mr-4" src="/assets/testimonial/Cariloha-t2.svg">
</div>
</section>

