              <figure class="h-full w-full flex justify-center"> <!-- Centering the figure -->
                <ul class="h-full flex justify-center">
                  <li class="shadow-3xl rounded-3xl p-[0.060rem] h-auto w-[360px]"> <!-- Set width to match real mobile image -->
                    <figure class="bg-white rounded-[32px] overflow-hidden [background:linear-gradient(180deg,rgb(217,205,255)_0%,rgb(196.86,178.5,255)_100%)]  opacity-95">
                      <div class="py-4 flex flex-col items-center h-full">
