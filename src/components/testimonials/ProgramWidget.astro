          <svg width="14" height="10" fill="none" viewBox="0 0 14 10" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0 5C0 5.27614 0.223858 5.5 0.5 5.5L12.2929 5.5L9.14645 8.64645C8.95118 8.84171 8.95118 9.15829 9.14645 9.35355C9.34171 9.54882 9.65829 9.54882 9.85355 9.35355L13.8536 5.35355C14.0488 5.15829 14.0488 4.84171 13.8536 4.64645L9.85355 0.646446C9.65829 0.451183 9.34171 0.451183 9.14645 0.646446C8.95118 0.841707 8.95118 1.15829 9.14645 1.35355L12.2929 4.5L0.5 4.5C0.223858 4.5 0 4.72386 0 5Z" fill="#FFFFFF"></path>
          </svg>
        </button>
      </div>
