<section class="lg:p-8 border-t border-y border-white/5">
  <div class="mx-auto 2xl:max-w-7xl py-12 lg:px-16 md:px-12 px-6 sm:px-4 items-center w-full border border-white/20 rounded-3xl p-4">
    <div class="mx-auto text-center lg:py-8">
      <h3 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-white">
        Program experiences
      </h3>
      <p class="mt-6 text-white">A hub for your customers to seamlessly get their referral link, redeem their store credit, claim gifts and more!</p>
    </div>

    <div class="flex flex-col w-full"
     x-data="{
      activeTab: 1,    // This controls the tabs and should not be affected by slide changes
      slideIndex: 1,   // This controls the slide index
      totalSlides: 3,  // Total number of slides
      interval: null,
      autoSlideEnabled: false,
      startAutoSlide() {
        this.interval = setInterval(() => {
          this.nextSlide();
        }, 3000); 
      },
      stopAutoSlide() {
        clearInterval(this.interval);
        this.interval = null; 
      },
      checkScreenSize() {
        const isMobileView = window.innerWidth < 640;
        if (isMobileView && !this.autoSlideEnabled) {
          this.autoSlideEnabled = true;
          this.startAutoSlide();
        } else if (!isMobileView && this.autoSlideEnabled) {
          this.autoSlideEnabled = false;
          this.stopAutoSlide(); 
        }
      },
      init() {
        this.checkScreenSize(); 
        window.addEventListener('resize', this.checkScreenSize.bind(this)); 
      }
    }"
    x-init="init()"
  >
    
    <div class="relative flex justify-center items-center w-full h-8 mx-auto mt-6 text-white select-none sm:flex">
      <div class="shadow-[0_4px_10px_rgba(255,255,255,0.2)] flex w-50% p-2 overflow-hidden rounded-3xl">
        <button @click="activeTab = 1; slideIndex = 1; stopAutoSlide()" :class="{ 'text-white [background:linear-gradient(180deg,rgb(170,143,255)_0%,rgb(150.5,117.3,255)_100%)] border font-bold rounded-3xl': activeTab === 1, 'text-white font-bold': activeTab !== 1 }" class="px-2 py-1 md:px-4 md:py-2">Portal</button>
        <button @click="activeTab = 2; slideIndex = 1; stopAutoSlide()" :class="{ 'text-white [background:linear-gradient(180deg,rgb(170,143,255)_0%,rgb(150.5,117.3,255)_100%)] border font-bold rounded-3xl': activeTab === 2, 'text-white font-bold': activeTab !== 2 }" class="px-2 py-1 md:px-4 md:py-2">Program Widget</button>
        <button @click="activeTab = 3; slideIndex = 1; stopAutoSlide()" :class="{ 'text-white [background:linear-gradient(180deg,rgb(170,143,255)_0%,rgb(150.5,117.3,255)_100%)] border font-bold rounded-3xl': activeTab === 3, 'text-white font-bold': activeTab !== 3 }" class="px-2 py-1 md:px-4 md:py-2">Cobranded Landing Page</button>
      </div>
    </div>
  
    <div class="transition-transform duration-500 ease-in-out relative">
      <div class="absolute left-4 top-1/2 transform -translate-y-1/2 flex items-center justify-start z-20">
        <button @click=""
