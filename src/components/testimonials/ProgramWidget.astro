                    <figure class="bg-white rounded-[32px] overflow-hidden [background:linear-gradient(180deg,rgb(217,205,255)_0%,rgb(196.86,178.5,255)_100%)] opacity-95">
                      <div class="py-4 flex flex-col items-center h-full">
                        <div class="mb-6">
                          <p class="text-3xl text-black text-center">GLAMNETIC</p>
                        </div>
                        <div class="relative h-[400px] w-full">
                          <!-- Original Real Mobile Image -->
                          <img class="absolute left-1/2 top-0 transform -translate-x-1/2 -translate-y-0 h-full" loading="lazy" 
                               src="https://cdn.prod.website-files.com/633dd95841f93492e857d508/6667777e0401df8a85725cf2_phone-mockup-black.svg" alt="Real Mobile Image" />
                          
                          <!-- GLAMNETIC cobranded landing page image -->
                          <img class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 h-4/5 w-4/5 object-contain" loading="lazy" 
                               src="https://cdn.prod.website-files.com/633dd95841f93492e857d508/667acb608040f2377587ea87_cozyearth-exp-2.webp" alt="Front Phone Image" />
