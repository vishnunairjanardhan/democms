---
import TestimonialCarousel from "../../components/testimonials/TestimonialsCarousel.jsx";
---

<section class="relative">
  <TestimonialCarousel client:load/>
  
  <div class="mt-10 flex items-center justify-center">
    <a href="/case-study" class="group inline-flex items-center">
      <span class="text-[#6820EE] text-xl font-medium transition-colors duration-300">All Customer Stories</span>
      <svg
        class="ml-3 h-8 w-8 text-[#6820EE] transition-all duration-300 transform group-hover:translate-x-2"
        width="16" height="16" viewBox="0 0 24 24"
        stroke-width="2" stroke="currentColor" fill="none"
        stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" />
        <line x1="5" y1="12" x2="19" y2="12" />
        <line x1="13" y1="18" x2="19" y2="12" />
        <line x1="13" y1="6" x2="19" y2="12" />
      </svg>
    </a>
  </div>
</section>