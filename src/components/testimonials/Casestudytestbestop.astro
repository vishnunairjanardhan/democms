<section
  aria-labelledby="logocloud"
  id="logocloud "
  class="flex items-end justify-center bg-vulcan-900 border-t border-white/60 border-y border-white/5 px-8 mx-auto max-w-7xl md:px-12 lg:px-16 rounded-b-2xl" style="background-image: linear-gradient(to top, #DABCA8 , #CBA286);">
  <div
    class="justify-center px-8 mx-auto max-w-7xl md:px-12 lg:px-0">
    <ul class="grid grid-cols-1 gap-6 list-none sm:grid-cols-2 md:grid-cols-4 lg:gap-8 lg:mt-0 py-4 text-center" role="list">
      <li>
