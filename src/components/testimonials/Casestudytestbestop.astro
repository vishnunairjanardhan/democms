      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black">20% </h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Increase in AOV</div>
      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black">15%</h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Increase in Conversion Rate</div>
      </li>
      <li>
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-black whitespace-nowrap">60 Days</h2>
        </div>
        <div class="mt-2 text-black font-bold text-sm md:text-base">Promotion with Heather Storm </div>
      </li>
    </ul>
  </div>
</section>