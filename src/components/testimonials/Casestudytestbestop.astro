<section
  aria-labelledby="logocloud"
  id="logocloud"
  class="flex items-end justify-center bg-vulcan-900 border-t border-white/60 border-y border-white/5 px-8 mx-auto max-w-7xl md:px-12 lg:px-16 rounded-b-2xl"
  style="background-image: linear-gradient(to top, #DABCA8, #CBA286);">
  <div class="justify-center px-8 mx-auto max-w-7xl md:px-12 lg:px-0">
    <ul class="grid grid-cols-1 gap-6 list-none sm:grid-cols-2 md:grid-cols-4 lg:gap-8 lg:mt-0 py-4 text-center" role="list">
      
      <li role="listitem" 
          x-data="{ count: 0, target: 1.5, formattedCount() { return '$' + this.count.toFixed(1) + 'M'; }, counter() { 
            if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) { 
              let interval = setInterval(() => { 
                if (this.count < this.target) { 
                    this.count += 0.1; 
                    if (this.count > this.target) { 
                        this.count = this.target;
                    }
                } else { 
                    clearInterval(interval); 
                } 
              }, 50); 
            } else { this.count = this.target; } 
          } }" x-init="counter()">
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-gray-900" x-text="formattedCount()" aria-live="polite"></h2>
        </div>
        <div class="mt-2 text-gray-900 font-bold text-sm md:text-base">In Sales due to Gift Card Promotion</div>
      </li>

      <li role="listitem" x-data="{ count: 0, target: 20, counter() { 
          if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) { 
            let interval = setInterval(() => { 
              if (this.count < this.target) { 
                  this.count += 0.5; 
              } else { 
                  this.count = this.target; 
                  clearInterval(interval); 
              } 
            }, 30); 
          } else { this.count = this.target; } 
      } }" x-init="counter()">
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-gray-900" x-text="count + '%'" aria-live="polite"></h2>
        </div>
        <div class="mt-2 text-gray-900 font-bold text-sm md:text-base">Increase in AOV</div>
      </li>

      <li role="listitem" x-data="{ count: 0, target: 15, counter() { 
          if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) { 
            let interval = setInterval(() => { 
              if (this.count < this.target) { 
                  this.count += 0.5; 
              } else { 
                  this.count = this.target; 
                  clearInterval(interval); 
              } 
            }, 30); 
          } else { this.count = this.target; } 
      } }" x-init="counter()">
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-gray-900" x-text="count + '%'" aria-live="polite"></h2>
        </div>
        <div class="mt-2 text-gray-900 font-bold text-sm md:text-base">Increase in Conversion Rate</div>
      </li>

      <li role="listitem" x-data="{ count: 0, target: 60, counter() { 
          if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) { 
            let interval = setInterval(() => { 
              if (this.count < this.target) { 
                  this.count += 2; 
              } else { 
                  this.count = this.target; 
                  clearInterval(interval); 
              } 
            }, 50); 
          } else { this.count = this.target; } 
      } }" x-init="counter()">
        <div>
          <h2 class="text-2xl md:text-2xl mt-3 font-bold text-gray-900" x-text="count + ' Days'" aria-live="polite"></h2>
        </div>
        <div class="mt-2 text-gray-900 font-bold text-sm md:text-base">Promotion with Heather Storm </div>
      </li>

    </ul>
  </div>
</section>
