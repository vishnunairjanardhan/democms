      x-data="{
        activeTab: 1,
        interval: null,
        autoSlideEnabled: false,
        startAutoSlide() {
          this.interval = setInterval(() => {
            this.activeTab = this.activeTab === 6 ? 1 : this.activeTab + 1;
          }, 3000); 
        },
        stopAutoSlide() {
          clearInterval(this.interval);
          this.interval = null; 
        },
        checkScreenSize() {
          const isMobileView = window.innerWidth < 640;

          if (isMobileView && !this.autoSlideEnabled) {
            this.autoSlideEnabled = true;
            this.startAutoSlide();
          } else if (!isMobileView && this.autoSlideEnabled) {
            this.autoSlideEnabled = false;
            this.stopAutoSlide(); 
          }
        },
        init() {
          this.checkScreenSize(); 
          window.addEventListener('resize', this.checkScreenSize.bind(this)); 
        }
      }"
      x-init="init()"
    >
      
