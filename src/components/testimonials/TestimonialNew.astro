---
import Verticalgrid from "../assets/Verticalgrid.astro";
---

<section class="lg:p-8 border-t border-y border-white/5">
  <div class="mx-auto max-w-7xl py-12 lg:px-24 md:px-12 px-6 sm:px-4 items-center w-full">
    <div class="mx-auto text-center lg:py-8">
      <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-black">
        Don’t just take our word for it.<br /> Meet our brands.
      </h2>
    </div>
    <div class="flex flex-col w-full lg:px-2" 
        x-data="{
            activeTab: 1,
            interval: null,
            autoSlideEnabled: false,
            startAutoSlide() {
            this.interval = setInterval(() => {
                this.activeTab = this.activeTab === 6 ? 1 : this.activeTab + 1;
            }, 3000); 
            },
            stopAutoSlide() {
            clearInterval(this.interval);
            this.interval = null; 
            },
            checkScreenSize() {
            if (!this.autoSlideEnabled) {
                this.autoSlideEnabled = true;
                this.startAutoSlide();
            }
            },
            init() {
            this.checkScreenSize(); 
            window.addEventListener('resize', this.checkScreenSize.bind(this)); 
            }
        }"
        x-init="init()"
        @mouseenter="stopAutoSlide()" 
        @mouseleave="startAutoSlide()">
      <div class="relative inline-grid items-center justify-center w-full h-8 grid-cols-3 md:grid-cols-6 mx-auto mt-6 text-white select-none hidden sm:grid">
        <button @click="activeTab = 1;" 
                :class="{ 'text-white bg-white border font-bold rounded-3xl': activeTab === 1, 'text-white': activeTab !== 1 }" 
                class="px-2 py-2 md:px-4 md:py-4">
            <img :src="activeTab === 1 ? '/assets/testimonial/MudAustralia-B-logo.svg' : '/assets/testimonial/MudAustralia-logo.svg'"
                class="h-7 justify-center mx-auto" 
                alt="MudAustralia" />
        </button>
        <button @click="activeTab = 2;" 
                :class="{ 'text-black bg-white border font-bold rounded-3xl': activeTab === 2, 'text-gray-400': activeTab !== 2 }" 
                class="px-2 py-1 md:px-4 md:py-4">
            <img :src="activeTab === 2 ? '/assets/testimonial/Solistice-logo.svg' : '/assets/testimonial/Solistice-logo-w.svg'" 
                class="h-8 justify-center mx-auto" 
                alt="Solistice" />
        </button>
        <button @click="activeTab = 3;" 
                :class="{ 'text-black bg-white border font-bold rounded-3xl': activeTab === 3, 'text-gray-400': activeTab !== 3 }" 
                class="px-2 py-1 md:px-4 md:py-5">
            <img :src="activeTab === 3 ? '/assets/testimonial/Natori-logo.svg' : '/assets/testimonial/Natori-logo-w.svg'" 
                class="h-4 justify-center mx-auto" 
                alt="Natori" />
