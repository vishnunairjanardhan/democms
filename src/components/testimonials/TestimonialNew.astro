        <button @click="activeTab = 4;" 
                :class="{ 'text-black bg-white border font-bold rounded-3xl': activeTab === 4, 'text-gray-400': activeTab !== 4 }" 
                class="px-2 py-1 md:px-4 md:py-4">
            <img :src="activeTab === 4 ? '/assets/testimonial/Bestop-logo.svg' : '/assets/testimonial/Bestop-logo-w.svg'" 
                class="h-6 justify-center mx-auto" 
                alt="Bestop" />
        </button>
        <button @click="activeTab = 5;" 
                :class="{ 'text-black bg-white border font-bold rounded-3xl': activeTab === 5, 'text-gray-400': activeTab !== 5 }" 
                class="px-2 py-1 md:px-4 md:py-4">
