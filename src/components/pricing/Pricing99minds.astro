---
import Verticalgrid from "../assets/Verticalgrid.astro";
import Blurgradientleft from "../assets/Blurgradientleft.astro";
import { TABLE_HEAD, TABLE_BOTTOM, CHECK_ICON, PRICE_LIST_AMOUNT, TOP_PRODUCT_PRICE_LIST, REMAINING_PRODUCT_PRICE_LIST } from "../../config/Pricing.jsx"
import { Icon } from 'astro-icon/components'
---

<section class="relative  border-t border-white/5">
  <div class="hidden lg:block">
    <Verticalgrid />
    <Blurgradientleft />
  </div>
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-32 lg:py-24 mt-8">
    <div data-aos="fade-down" data-aos-duration="2000" class="max-w-3xl lg:text-center lg:mx-auto">
      <h2
        class="text-sm text-transparent uppercase bg-gradient-to-r from-indigo-300 to-indigo-400 bg-clip-text"
        >pricing
      </h2>
      <h1 class="mt-8">
        Pricing plans for your brand 
      </h1>
      <h3 class="mt-8">
        Designed  for every stage of your business
      </h3>
       <p class="mt-6">
        Our FREE plan comes with 50 transactions, 1 Campaign, 1 Integration and $0.5 per additional transaction.
      </p>
    </div>
  </div>
  <div data-aos="fade-up" data-aos-duration="2000" class="pb-24 lg:pb-32">
    <!-- Here starts the mobile pricing table -->
    <div class="block lg:hidden">
      <div class="mx-auto mt-8">
        {TABLE_HEAD.slice(1).map((header) => (
          <div class="flex flex-col max-w-s p-8 mx-auto mb-8 text-white border-0 shadow-sm">
            <div class="text-lg font-medium leading-6 text-white">
              {header}
            </div>
            {PRICE_LIST_AMOUNT.map((price) => (
              <div>
                <div class="flex mt-4 mb-6">
                  <div class="flex-shrink-0 text-6xl font-bold text-white">{price[header]}</div>
                  <div class="mt-auto ml-2 text-sm font-normal text-white">
                    per month
                  </div>
                </div>
              </div>
            ))}
            <div class="mt-4"></div>
            {TOP_PRODUCT_PRICE_LIST.map((features) => (
              features[header] !== "No" && (
                <li class="flex py-2 text-sm text-vulcan-300">
                  <svg
                    class="flex-shrink-0 w-5 h-5 text-indigo-400"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  {features[header] !== "Yes" && features[header] !== "No" && (
                    <span class="ml-2 mr-2 font-normal text-white">{features[header]}</span>
                  )}
                  <span class="font-normal">
                    <a href="#">{features.Column1}</a>
                  </span>
                </li>
              )
            ))}
            <div class="w-full py-2 mb-4">
              <a href="/Get-Started"
                class="flex items-center justify-center h-10 px-4 py-2 text-sm font-semibold text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700">
                Get started
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <!---- Here starts the Desktop pricing table -->
    <section class="relative hidden lg:block">
      <div class="max-w-7xl p-8 mx-auto border border-white/5 rounded-3xl bg-vulcan-900">
        <table class="w-full mx-auto text-white bg-vulcan-900">
          <thead>
            <tr class="text-center align-top">
              <th class=""></th>
              <th class="px-2" width="8%">
                <tr>
                  {TABLE_HEAD.map((header) => (
                    <th class="px-2 p-4 font-normal text-white" key={header}>{header}</th>
                  ))}
                </tr>
                <tr>
                  {TABLE_BOTTOM.map((feature) => (
                    <th class="w-1/12 px-2">
                      {feature.active && (
                        <div class="py-2 mb-4">
                          <a href={feature.Url}
                            class="flex items-center justify-center h-10 px-4 py-2 text-sm font-normal text-white transition-all border rounded-lg bg-vulcan-900 hover:text-indigo-400 border-vulcan-700 w-full"
                            id="billing-plan-get-in-touch-enterprise">
                            {feature.Label}
                          </a>
                        </div>
                      )}
                    </th>
                  ))}
                </tr>  
                {PRICE_LIST_AMOUNT.map((feature) => (
                  <tr class="mt-6 text-sm text-vulcan-300 border-b border-white/5" key={feature.Column1}>
                    <th class="px-2 p-4 font-normal" >{feature.Column1}</th>
                    {TABLE_HEAD.slice(1).map((col) => (
                      <th class="font-normal text-white" key={col}>{feature[col]}</th>
                    ))}
                  </tr>
                ))}
                {TOP_PRODUCT_PRICE_LIST.map((feature) => (
                  <tr class="mt-6 text-sm font-normal text-vulcan-300 border-b border-white/5 mx-auto" key={feature.Column1}>
                    <th class="p-4 font-normal">{feature.Column1}</th>
                    {TABLE_HEAD.slice(1).map((col) => (
                      <th class="font-normal text-white" key={col}>
                        {feature[col] === 'Yes' ? (
                          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#16a34a" class="m-auto bi bi-check-lg" viewBox="0 0 16 16">
                            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z"/>
                          </svg>
                        ) : feature[col] === 'No' ? (
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#dc2626" class="m-auto bi bi-x-lg" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                          </svg>
                        ) : (
                          feature[col]
                        )}
                      </th>
                    ))}
                  </tr>
                ))}
            </tr>
          </thead>
        </table>
        <div class="relative mx-auto rounded-3xl border-white/5 bg-vulcan-900" x-data="{selected:null}">
          <button
            role="button"
            type="button"
            class="w-full px-8 py-6 text-left"
            @click="selected !== 1 ? selected = 1 : selected = null">
            <div class="flex text-white group">
              <p
                class="text-base text-center font-bold w-full duration-200 group-hover:text-white">
                Compare Price List
                <svg :class="{'rotate-180': open, 'rotate-180': !open}" xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-chevron-down inline h-5 transition-transform duration-200 transform rotate-180" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M6 9l6 6l6 -6"></path>
                </svg>
              </p>
            </div>
          </button>
          <div
            class="relative overflow-hidden transition-all duration-700 max-h-0"
            style=""
            x-ref="container1"
            x-bind:style="selected == 1 ? 'max-height: ' + $refs.container1.scrollHeight + 'px' : ''"
          >
            <div class="max-w-7xl mx-auto rounded-xl bg-vulcan-900">
              <table class="w-full mx-auto text-white bg-vulcan-900 mt-5">
                <thead>
                  {REMAINING_PRODUCT_PRICE_LIST.map((feature) => (
                    <tr class="mt-6 text-sm font-normal text-vulcan-300 border-b border-white/5 mx-auto text-center" key={feature.Column1}>
                      <th class="w-1/12 p-4 font-normal">{feature.Column1}</th>
                      {TABLE_HEAD.slice(1).map((col) => (
                        <td class="w-1/12 font-normal text-white" key={col}>
                          {feature[col] === 'Yes' ? (
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#16a34a" class="m-auto bi bi-check-lg" viewBox="0 0 16 16">
                              <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z"/>
                            </svg>
                          ) : feature[col] === 'No' ? (
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#dc2626" class="m-auto bi bi-x-lg" viewBox="0 0 16 16">
                              <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                            </svg>
                          ) : (
                            feature[col]
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>