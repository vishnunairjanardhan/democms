---
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<footer
  aria-labelledby="footer"
  id="footer "
  class="relative border-t bg-vulcan-900 border-white/5">
  <Blurgradientleft />
  <div class="relative px-8 py-12 mx-auto md:px-12 lg:px-44 lg:py-12">
    <div class="xl:grid xl:grid-cols-4 xl:gap-8">
      <div class="text-white">
        <div class="inline-flex items-center gap-3">
            <img
              class="h-10"
              alt="hero"
              src="/assets/99mindslogo.png"
            />
        </div>
        <p class="mt-2 text-sm text-vulcan-300">
          <span class="mt-6 text-sm font-normal text-vulcan-300">
            © 2023 99Minds Inc. <br /> All rights reserved
          </span>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 xl:col-span-3">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-white">Features</h3>
            <ul role="list" class="mt-4 space-y-2">
              <li>
                <a
                  class="inline-flex items-center text-sm text-vulcan-300 hover:text-white"
                  href="/sytem/overview"
                  >Gift Card Management <span
                    class="items-center inline-flex font-medium text-indigo-400 bg-vulcan-800 ml-4 px-3 py-0.5 rounded-full text-xs"
                    >NEW !!</span
                  ></a
                >
              </li>
              <li>
                <a
                  href="/system/styleguide"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Coupon Management
                </a>
              </li>
              <li>
                <a
                  href="/system/styleguide"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Store Credit Management
                </a>
              </li>
              <li>
                <a
                  href="/system/styleguide"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Loyalty Program Management
                </a>
              </li>
              <li>
                <a
                  href="/system/styleguide"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Automated Workflows
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-12 md:mt-0">
            <h3 class="text-white">Other projects</h3>
            <ul role="list" class="mt-4 space-y-2">
              <li>
                <a
                  href="https://www.unwrapped.design"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Unwrapped
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-white">Stay updated</h3>
            <ul role="list" class="mt-4 space-y-2">
              <li>
                <a
                  href="https://www.lexingtonthemes.com/license"
                  class="text-sm text-vulcan-300 hover:text-white">
                  License
                </a>
              </li>
              <li>
                <a
                  href="https://www.lexingtonthemes.com/documentation"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Documentation
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-12 md:mt-0">
            <h3 class="text-white">Socials</h3>
            <ul role="list" class="mt-4 space-y-2">
              <li>
                <a
                  href="https://twitter.com/unwrappedHQ"
                  class="text-sm text-vulcan-300 hover:text-white">
                  @unwrappedHQ
                </a>
              </li>
              <li>
                <a
                  href="https://twitter.com/Mike_Andreuzza"
                  class="text-sm text-vulcan-300 hover:text-white">
                  @Mike_Andreuzza
                </a>
              </li>
              <li>
                <a
                  href="https://dribbble.com/MichaelAndreuzza.html"
                  class="text-sm text-vulcan-300 hover:text-white">
                  Dribbble
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<footer class="bg-vulcan-900">
  <div class="relative px-8 pb-24 mx-auto max-w-7xl md:px-12 lg:px-32">
    <div
      class="pt-12 border-t lg:flex lg:items-center lg:justify-between border-white/5">
      <div>
        <h3 class="text-white">Ecommerce Marketing Cloud Built With <svg class="w-6 h-6 text-gray-800 dark:text-white inline-block" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 18"><path d="M17.947 2.053a5.209 5.209 0 0 0-3.793-1.53A6.414 6.414 0 0 0 10 2.311 6.482 6.482 0 0 0 5.824.5a5.2 5.2 0 0 0-3.8 1.521c-1.915 1.916-2.315 5.392.625 8.333l7 7a.5.5 0 0 0 .708 0l7-7a6.6 6.6 0 0 0 2.123-4.508 5.179 5.179 0 0 0-1.533-3.793Z"/></svg> For Internet Businesses</h3>
        <a href="#_" class="relative inline-block text-lg group">
          <span class="relative z-10 block px-5 py-3 overflow-hidden font-medium leading-tight text-indigo-900 transition-colors duration-300 ease-out border-2 border-indigo-900 rounded-lg group-hover:text-white">
          <span class="absolute inset-0 w-full h-full px-5 py-3 rounded-lg bg-indigo-50"></span>
          <span class="absolute left-0 w-48 h-48 -ml-2 transition-all duration-300 origin-top-right -rotate-90 -translate-x-full translate-y-12 bg-indigo-900 group-hover:-rotate-180 ease"></span>
          <span class="relative">Button Text</span>
          </span>
          <span class="absolute bottom-0 right-0 w-full h-12 -mb-1 -mr-1 transition-all duration-200 ease-linear bg-indigo-900 rounded-lg group-hover:mb-0 group-hover:mr-0" data-rounded="rounded-lg"></span>
        </a>
      </div>
    </div>
  </div>
</footer>
