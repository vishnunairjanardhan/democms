---
import Blurgradientleft from "../assets/Blurgradientleft.astro";
---

<footer
  id="footer"
  class="relative border-t bg-vulcan-900 border-white/5">
  <div class="relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24">
    <div class="xl:grid xl:grid-cols-5 xl:gap-8">
      <div class="text-white">
        <div class="inline-flex items-center gap-3">
            <img
              width="179"
              height="40"
              alt="99minds logo"
              src="/assets/99minds-logo1.svg"
            />
        </div>
        <p class="mt-2 text-sm text-white/70">
          <span class="mt-6 text-sm font-normal">
            99minds platform enables you to create coupons, gift cards, discounts, send out referrals, build loyalty programs, and location-based promotions for your customers.
          </span>
          <div class="mt-5 flex items-center gap-4">
            <a
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit 99minds on Facebook"
              href="https://www.facebook.com/99minds.io">
              <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="30" viewBox="0,0,256,256">
                <g fill="#ffffff" fill-rule="nonzero">
                  <g transform="scale(10.66667,10.66667)">
                    <path d="M12,2c-5.523,0 -10,4.477 -10,10c0,5.013 3.693,9.153 8.505,9.876v-7.226h-2.474v-2.629h2.474v-1.749c0,
                      -2.896 1.411,-4.167 3.818,-4.167c1.153,0 1.762,0.085 2.051,0.124v2.294h-1.642c-1.022,0 -1.379,0.969 -1.379,
                      2.061v1.437h2.995l-0.406,2.629h-2.588v7.247c4.881,-0.661 8.646,-4.835 8.646,-9.897c0,-5.523 -4.477,-10 -10,-10z">
                    </path>
                  </g>
                </g>
              </svg>
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit 99minds on LinkedIn"
              href="https://www.linkedin.com/company/99minds-loyalty-promotions-and-giftcard/">
              <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="30" viewBox="0 0 50 50">
                <g fill="#ffffff" fill-rule="nonzero">
                  <path d="M41,4H9C6.24,4,4,6.24,4,9v32c0,2.76,2.24,5,5,5h32c2.76,0,5-2.24,5-5V9C46,6.24,43.76,4,41,4z M17,20v19h-6V20H17z M11,14.47c0-1.4,1.2-2.47,3-2.47s2.93,1.07,3,2.47c0,1.4-1.12,2.53-3,2.53C12.2,17,11,15.87,11,14.47z M39,39h-6c0,0,0-9.26,0-10 c0-2-1-4-3.5-4.04h-0.08C27,24.96,26,27.02,26,29c0,0.91,0,10,0,10h-6V20h6v2.56c0,0,1.93-2.56,5.81-2.56 c3.97,0,7.19,2.73,7.19,8.26V39z"></path>
                </g>
              </svg>
            </a>
                   <a target="_blank" rel="noopener noreferer" class="link" href="https://twitter.com/99minds_io">
                   
                   <span class="sr-only">Follow Astro on Twitter</span><svg viewBox="0 0 24 24" aria-hidden="true" width="30"
                   astro-icon="social/twitter"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 
                   21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></a>
                   <a target="_blank" rel="noopener noreferer" class="link" href="https://www.instagram.com/99minds.io/">
                   <span class="sr-only">Follow Astro on Mastodon</span>
                   <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="30" viewBox="0 0 30 30">
                   <g fill="#ffffff" fill-rule="nonzero" 
                 stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter"
                    stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" 
                      font-size="none" text-anchor="none" style="mix-blend-mode: normal">
    <path d="M 9.9980469 3 C 6.1390469 3 3 6.1419531 3 10.001953 L 3 20.001953 C 3 23.860953 6.1419531 27 10.001953 27 L 20.001953 27 C 23.860953 27 27 23.858047 27 19.998047 L 27 9.9980469 C 27 6.1390469 23.858047 3 19.998047 3 L 9.9980469 3 z M 22 7 C 22.552 7 23 7.448 23 8 C 23 8.552 22.552 9 22 9 C 21.448 9 21 8.552 21 8 C 21 7.448 21.448 7 22 7 z M 15 9 C 18.309 9 21 11.691 21 15 C 21 18.309 18.309 21 15 21 C 11.691 21 9 18.309 9 15 C 9 11.691 11.691 9 15 9 z M 15 11 A 4 4 0 0 0 11 15 A 4 4 0 0 0 15 19 A 4 4 0 0 0 19 15 A 4 4 0 0 0 15 11 z"></path></svg></a></div>
        </p>
      </div>      
        <div class="md:grid  md:gap-8">
          <div class="mt-12 md:mt-0">
            <p class=" pt-4 font-normal text-white">Features</p>
            <ul role="list" class="mt-4 text-white/70 space-y-2">
              <li>
                <a
                  class="inline-flex items-center text-sm  hover:text-white"
                  href="/giftcard"
                  >Gift Card Management 
                  <!---<span
                    class="items-center inline-flex font-medium text-indigo-400 bg-vulcan-800 ml-4 px-3 py-0.5 rounded-full text-xs"
                    >NEW !!</span>--->
                    </a
                >
              </li>
              <li>
                <a
                  href="/coupons"
                  class="text-sm hover:text-white">
                  Coupon Management
                </a>
              </li>
              <li>
                <a
                  href="/store-credit"
                  class="text-sm  hover:text-white">
                  Store Credit Management
                </a>
              </li>
              <li>
                <a
                  href="/loyalty"
                  class="text-sm  hover:text-white">
                  Loyalty Program Management
                </a>
              </li>
              <li>
                <a
                  href="/referral"
                  class="text-sm  hover:text-white">
                  Referral Program Management
                </a>
              </li>
              <li>
                <a
                  href="/automated-workflow"
                  class="text-sm  hover:text-white">
                  Automated Workflows
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-12 md:mt-0">
            <p class=" pt-4 font-normal text-white">Resources</p>
            <ul role="list" class="mt-4 text-white/70 space-y-2">
              <li>
                <a
                  href="/blog"
                  class="text-sm  hover:text-white">
                  Blog
                </a>
              </li>
              <li>
                <a
                  href="https://support.99minds.io/en/"
                  class="text-sm hover:text-white">
                  Documentation
                </a>
              </li>
              <li>
                <a
                  href="https://docs.99minds.io/"
                  class="text-sm  hover:text-white">
                  API Documentation
                </a>
              </li>
              <li>
                <a
                  href="https://99minds.io/coupon-code-generator"
                  class="text-sm  hover:text-white">
                  Coupon Code Generator
                </a>
              </li>
              <li>
                <a
                  href="https://99minds.io/giftcard-code-generator"
                  class="text-sm  hover:text-white">
                  Gift Card Code Generator
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-12 md:mt-0">
            <p class="pt-4 font-normal text-white">Legal</h2>
            <ul role="list" class="mt-4 text-white/70 space-y-2">
              <li>
                <a href="/trust" class="text-sm hover:text-white">
                  Trust
                </a>
              </li>
              <li>
                <a href="https://app.termly.io/document/privacy-policy/e1054a68-e1ab-43c0-92ad-e4b68339718d" class="text-sm hover:text-white">
                  Privacy Policy
                </a>
              </li>
              <li>
                <a href="https://app.termly.io/document/terms-of-use-for-saas/30ada467-9d58-4b21-b3ed-e7d79c015bc4" class="text-sm hover:text-white">
                  Terms & Conditions
                </a>
              </li>
              <li>
                <a href="/legal/data-processing-addendum" class="text-sm hover:text-white">
                  Data Processing Addendum
                </a>
              </li>
              <li>
                <a href="/legal/subprocessors" class="text-sm hover:text-white">
                  Sub Processors
                </a>
              </li>
              <li>
                <a href="/99minds-gdpr-compliance" class="text-sm hover:text-white">
                  GDPR Compliance
                </a>
              </li>
              <li>
                <a href="https://app.termly.io/notify/e1054a68-e1ab-43c0-92ad-e4b68339718d" class="text-sm hover:text-white">
                  Do Not Sell or Share My Personal Information
                </a>
              </li>
              <li>
                <a href="https://app.termly.io/notify/e1054a68-e1ab-43c0-92ad-e4b68339718d" class="text-sm hover:text-white">
                  Limit the Use Of My Sensitive Personal Information
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-12 md:mt-0">
            <p class="pt-4 font-normal text-white">About Us</h2>
            <ul role="list" class="mt-4 text-white/70 space-y-2">
              <li>
                <a href="/contact" class="text-sm hover:text-white">
                  Contact
                </a>
              </li>
            </ul>
          </div>
      </div>
    </div> 
</footer>
<footer class="bg-vulcan-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="relative px-8 pb-24 mx-auto max-w-7xl md:px-12 lg:px-16">
    <div class="pt-12 border-t lg:flex lg:items-center lg:justify-between border-white/5">
      <div>
        <p class="text-white text-sm text-vulcan-300">
          Copyright © 2023 99minds Inc. All rights reserved.
        </p>
      </div>
      <div>
        <div class="text-white/70 font-medium">
          <div class="p-2">
            <a href="https://www.99minds.io/sitemap-index.xml" 
               class="text-sm px-2 inline-block" 
               aria-label="View sitemap of 99minds website">
               Sitemap
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>