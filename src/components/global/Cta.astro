      <div class="justify-end"><button @click="showAlert = false" class="bg-black border-transparent focus:ring-white hover:bg-black/10 hover:text-black rounded-full p-0.5 ring-1 ring-transparent text-white mt-4 md:mt-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-x w-4 h-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M18 6l-12 12"></path>
            <path d="M6 6l12 12"></path>
          </svg>
        </button></div>
    </div>
  </div>
  <!-- Announcement End -->