 <!-- Announcement Start -->
     <div class="items-center w-full mx-auto relative" x-show="showAlert" x-data="{ showAlert: true }">
    <div class="w-full flex flex-col lg:px-32  max-w-8xl   2xl:max-w-screen-2xl   mx-auto px-8 lg:bg-white bg-white md:flex-row md:items-center md:justify-between md:py-1 py-3" x-data="{ open: false }">
      <div class="items-center flex justify-between flex-row lg:justify-start">
        <a class="text-lg text-black focus:outline-none focus:ring lg:text-2xl tracking-tight" href="/">
          <span class="focus:ring-0 font-normal lg:text-lg">
            <span class="items-center inline-flex gap-2 group">
               Black Friday and Cyber Monday</span>
          </span>
        </a>
        <button aria-label="open" @click="open = !open" class="items-center inline-flex focus:outline-none text-black focus:text-accent-400 hover:text-accent-400 justify-center md:hidden p-2">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor">
            <path d="M4 6h16M4 12h16M4 18h16" :class="{'hidden': open, 'inline-flex': !open }" class="inline-flex" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            <path d="M6 18L18 6M6 6l12 12" :class="{'hidden': !open, 'inline-flex': open }" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
      </div>

    
    <div
      class="w-full mx-auto 2xl:max-w-7xl lg:max-w-3xl flex flex-col justify-center  py-2 relative p-2">
      
      <div class="mt-0 border-neutral-200  pt-0 max-w-2xl mx-auto w-full">
        <!-- Starts compoent -->
        <div
          class="w-full justify-center border bg-vulcan-900 p-2 px-12 rounded-xl"
          x-data="{
              endDate: new Date('2024-11-29T23:59:59').getTime(),
              remainingTime: 0,
              formatTime(time) {
                const days = Math.floor(time / (1000 * 60 * 60 * 24));
                const hours = Math.floor((time % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((time % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((time % (1000 * 60)) / 1000);
                return { days, hours, minutes, seconds };
              }
            }"
                      x-init="() => {
              setInterval(() => {
                const now = new Date().getTime();
                const remainingTime = endDate - now;
                $data.remainingTime = remainingTime > 0 ? remainingTime : 0;
              }, 1000);
            }">
          <template x-if="remainingTime > 0">
            <div class="gap-4 text-center w-full flex mx-auto justify-between">
              <div class="flex flex-inline items-center">
                <div
                  class="text-3xl font-medium text-white"
                  x-text="formatTime(remainingTime).days">
                </div>
                <div class="ml-2 text-xl text-[#AA8FFF]">Days</div>
              </div>
              <div class="flex flex-inline items-center">
                <div
                  class="text-3xl font-medium text-white"
                  x-text="formatTime(remainingTime).hours">
                </div>
                <div class="ml-2 text-xl text-[#AA8FFF]">Hours</div>
              </div>
              <div class="flex flex-inline items-center">
                <div
                  class="text-3xl font-medium text-white"
                  x-text="formatTime(remainingTime).minutes">
                </div>
                <div class="text-xl ml-2 text-[#AA8FFF]">Minutes</div>
              </div>
              <div class="flex flex-inline items-center">
                <div
                  class="text-3xl font-medium text-white"
                  x-text="formatTime(remainingTime).seconds">
                </div>
                <div class="text-xl ml-2 text-[#AA8FFF]">Seconds</div>
              </div>
            </div>
          </template>
          <!--<template x-if="remainingTime <= 0">
            <div class="text-center">
              <div class="text-xl font-normal text-gray-500">Countdown has ended</div>
            </div>
          </template>-->
        </div>
        <!-- Ends compoent -->
        
      </div>
    </div>
 



