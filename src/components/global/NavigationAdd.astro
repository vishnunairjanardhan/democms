<style>
[x-cloak] {
  display: none !important;
}
</style>

<section
  role="navigation"
  aria-label="Main Navigation"
  class="fixed z-50 w-full border-b bg-vulcan-900/20 border-white/5 backdrop-blur-2xl lg:bg-vulcan-900/0"
  x-data="{ showAlert: true, prevScroll: 0 }"
  x-init="
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset || document.documentElement.scrollTop;
      showAlert = currentScroll === 0;
      prevScroll = currentScroll;
    });
  "
>
<div class="relative w-full mx-auto max-w-7xl">

<div
x-data="{ mobileOpen:false }"
class="relative flex flex-col w-full px-8 py-5 mx-auto md:flex-row md:items-center md:justify-between md:px-12 lg:px-16"
>

<div class="flex flex-row items-center justify-between text-white lg:justify-start">

<a href="/" class="lg:pr-8">
<div class="inline-flex items-center gap-3">
<img
width="125"
height="28"
alt="99minds logo"
src="/assets/99minds-logo1.svg"
/>
</div>
</a>

<button
aria-label="navigation"
@click="mobileOpen = !mobileOpen"
:aria-expanded="mobileOpen"
class="inline-flex items-center justify-center p-2 text-white hover:text-indigo-400 md:hidden"
>
<svg class="w-6 h-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
<path
:class="{'hidden': mobileOpen}"
stroke-linecap="round"
stroke-linejoin="round"
stroke-width="2"
d="M4 6h16M4 12h16M4 18h16"
/>
<path
:class="{'hidden': !mobileOpen}"
stroke-linecap="round"
stroke-linejoin="round"
stroke-width="2"
d="M6 18L18 6M6 6l12 12"
/>
</svg>
</button>

<nav
:class="{'flex': mobileOpen, 'hidden': !mobileOpen}"
class="flex-col hidden flex-grow md:flex md:flex-row md:justify-end md:pb-0"
>

<!-- PRODUCTS DROPDOWN -->

<div x-data="{ productsOpen:false }" @click.away="productsOpen=false" class="relative">

<button
@click="productsOpen = !productsOpen"
class="inline-flex items-center gap-2 px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3"
>
<span>Products</span>

<svg
:class="{'rotate-180': productsOpen}"
class="inline h-4 transition-transform duration-200"
viewBox="0 0 24 24"
stroke="currentColor"
fill="none"
stroke-width="2"
>
<path d="M6 9l6 6l6 -6"/>
</svg>

</button>

<div
x-cloak
x-show="productsOpen"
x-transition
class="hidden absolute left-0 z-50 mt-2 w-52 rounded-xl bg-gradient-to-b from-indigo-500 p-[1px]"
:class="{ 'hidden': !productsOpen }"
>

<div class="py-1 bg-vulcan-900 rounded-xl">

<a href="/giftcard" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Gift Card</a>
<a href="/store-credit" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Store Credit</a>
<a href="/loyalty" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Loyalty Program</a>
<a href="/coupons" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Coupons</a>
<a href="/referral" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Referrals</a>
<a href="/automated-workflow" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Automated Workflows</a>

</div>
</div>
</div>

<a class="px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3" href="/integrations">
Integrations
</a>

<a class="px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3" href="/case-study">
Case Study
</a>

<!-- RESOURCES DROPDOWN -->

<div x-data="{ resourcesOpen:false }" @click.away="resourcesOpen=false" class="relative">

<button
@click="resourcesOpen = !resourcesOpen"
class="inline-flex items-center gap-2 px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3"
>

<span>Resources</span>

<svg
:class="{'rotate-180': resourcesOpen}"
class="inline h-4 transition-transform duration-200"
viewBox="0 0 24 24"
stroke="currentColor"
fill="none"
stroke-width="2"
>
<path d="M6 9l6 6l6 -6"/>
</svg>

</button>

<div
x-cloak
x-show="resourcesOpen"
x-transition
class="hidden absolute left-0 z-50 mt-2 w-52 rounded-xl bg-gradient-to-b from-indigo-500 p-[1px]"
:class="{ 'hidden': !resourcesOpen }"
>

<div class="py-1 bg-vulcan-900 rounded-xl">

<a href="/blog" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Blog</a>
<a href="https://support.99minds.io/en" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Documentation</a>
<a href="https://docs.99minds.io/" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">API Documentation</a>
<a href="/giftcard-code-generator" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Gift Card Generator</a>
<a href="/coupon-code-generator" class="block px-4 py-2 text-sm text-white hover:text-indigo-400">Coupon Code Generator</a>

</div>
</div>
</div>

<a class="px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3" href="/pricing">
Pricing
</a>

<a
target="_blank"
class="px-2 py-2 text-sm text-white hover:text-white/50 lg:px-3"
href="https://giftcard.99minds.io/access/register"
>
Sign Up
</a>

<button
type="button"
class="mx-3 relative p-0.5 inline-flex items-center justify-center font-bold overflow-hidden group rounded-md"
onclick="Calendly?.initPopupWidget({ url: 'https://calendly.com/99minds/30min' });"
>

<span class="w-full h-full bg-gradient-to-br from-[#ff8a05] via-[#ff5478] to-[#ff00c6] absolute"></span>

<span class="relative px-4 py-2 bg-gray-900 bg-opacity-0 rounded-md group-hover:bg-opacity-10 text-white">
Book a Demo
</span>

</button>

</nav>
</div>
</div>
</div>
</section>