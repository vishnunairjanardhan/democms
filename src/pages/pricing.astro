---
import BaseLayout from "../layouts/BaseLayout.astro";

import Pricing99minds from "../components/pricing/Pricing99minds.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import Faq99minds from "../components/Infopages/Faq99minds.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Plans & Pricing - 99minds"
  description="Explore 99minds' diverse pricing plans from basic packages to premium offerings, find the perfect solution for your business growth and success."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Plans & Pricing - 99minds",
    description: "Explore 99minds' diverse pricing plans from basic packages to premium offerings, find the perfect solution for your business growth and success.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <Pricing99minds />
  <Faq99minds />
  <LogoCloudOne />
  <CtaThree99minds />
</BaseLayout>
