---
import BaseLayout3 from "../layouts/BaseLayout3.astro";

import Pricing99minds from "../components/pricing/Pricing99minds.astro";
import NewLogoCloud from "../components/testimonials/NewLogoCloud.jsx";
import Faq99minds from "../components/Infopages/Faq99minds.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<BaseLayout3>
<AstroSeo
  title="Plans & Pricing - 99minds"
  description="Explore 99minds' diverse pricing plans from basic packages to premium offerings, find the perfect solution for your business growth and success."
  canonical="https://www.99minds.io/pricing"
  openGraph={{
    url: "https://www.99minds.io/pricing",
    title: "Plans & Pricing - 99minds",
    description: "Explore 99minds' diverse pricing plans from basic packages to premium offerings, find the perfect solution for your business growth and success.",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg ",
        alt: "99minds Pricing",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/pricing",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg ",
        alt: "99minds Pricing",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <Pricing99minds/>
  <Faq99minds />
  <NewLogoCloud />
  <CtaThree99minds />
</BaseLayout3>
