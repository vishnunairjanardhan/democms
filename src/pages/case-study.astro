---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyHeader from "../components/features/CaseStudyHeader.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="The Partnership to Success: Insights from 99minds Case Studies"
  description="Discover the power of strategic collaborations with 99minds through illuminating case studies"
  canonical="https://www.99minds.io/case-study"
  openGraph={{
    url: "https://www.99minds.io/case-study",
    title: "The Partnership to Success: Insights from 99minds Case Studies",
    description: "Discover the power of strategic collaborations with 99minds through illuminating case studies",
    
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <CaseStudyHeader />
</BaseLayout>
