---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyHeader from "../components/features/CaseStudyHeader.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="The Partnership to Success: Insights from 99minds Case Studies"
  description="Discover the power of strategic collaborations with 99minds through illuminating case studies"
  canonical="https://www.99minds.io/case-study"
  openGraph={{
    url: "https://www.99minds.io/case-study",
    title: "The Partnership to Success: Insights from 99minds Case Studies",
    description: "Discover the power of strategic collaborations with 99minds through illuminating case studies",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <CaseStudyHeader />
</BaseLayout>
