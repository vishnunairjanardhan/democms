---
import BaseLayout3 from "../../layouts/BaseLayout3.astro";
import HeroIntegration from "../../components/heros/HeroIntegration.jsx";
import ClientLogoScroller from "../../components/testimonials/ClientLogoScroller.astro";
import FeatureHeartland from "../../components/features/FeatureHeartland.astro";
import FeatureHeartland2 from "../../components/features/FeatureHeartland2.astro";
import FeatureTenHeartland from "../../components/features/FeatureTenHeartland.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThreeU from "../../components/ctas/CtaThreeU.astro";
import IntegrationHeartland from "../../components/integrations/IntegrationHeartland.astro";

import { AstroSeo } from "@astrolib/seo";
import { heartlandPageConfig } from "../../config/heroConfig.js";

const { seo, hero } = heartlandPageConfig;
---

<BaseLayout3>
  <AstroSeo {...seo} />

  <!-- ✅ Hero gets only its props -->
  <HeroIntegration {...hero} client:load/>

  <ClientLogoScroller />
  <FeatureHeartland />
  <FeatureHeartland2 />
  <FeatureTenHeartland />

  <!-- ✅ Integration section also gets its props -->
  <IntegrationHeartland />

  <Testimonialtry />
  <CtaThreeU />
</BaseLayout3>
