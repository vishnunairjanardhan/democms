---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroHeartland from "../../components/heros/HeroHeartland.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureHeartland from "../../components/features/FeatureHeartland.astro";
import FeatureHeartland2 from "../../components/features/FeatureHeartland2.astro";
import FeatureTenHeartland from "../../components/features/FeatureTenHeartland.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import Cta99mindsPOS from "../../components/ctas/Cta99mindsPOS.astro";
import IntegrationHeartland from "../../components/integrations/IntegrationHeartland.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds and Heartland integration | 99minds"
  description="The complete rewards solution for Heartland Retail. Drive sales from your existing customer base with smart omnichannel loyalty, gift card and store credit."
  canonical="https://www.99minds.io/integrations/heartland"
  openGraph={{
    url: "https://www.99minds.io/integrations/heartland",
    title: "99minds and Heartland integration | 99minds",
    description: "The complete rewards solution for Heartland Retail. Drive sales from your existing customer base with smart omnichannel loyalty, gift card and store credit.",
    images: [
      {
        src: "https://www.99minds.io/assets/99minds-HL1.svg",
        alt: "99minds Heartland Integration",
        type: "image/svg",
      },
      {
        src: "https://www.99minds.io/assets/99minds-HL1.svg",
        alt: "99minds Heartland Integration",
        type: "image/svg",
      },
      { url: "https://www.99minds.io/assets/99minds-HL1.svg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "99minds Heartland Integration",
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroHeartland />
  <LogoCloudOne />
  <FeatureHeartland />
  <FeatureHeartland2 />
  <FeatureTenHeartland />
  <IntegrationHeartland />
  <Testimonialtry />
  <Cta99mindsPOS />
</BaseLayout>
