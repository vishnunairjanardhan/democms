import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds and Klaviyo integration | 99minds"
  description="99minds integrates with Klaviyo to boost sales and customer loyalty through dynamic & bulk loyalty and gift card email and sms campaigns"
  canonical="https://www.99minds.io/integrations/klaviyo"
  openGraph={{
    url: "https://www.99minds.io/integrations/klaviyo",
    title: "99minds and Klaviyo integration | 99minds",
    description: "99minds integrates with Klaviyo to boost sales and customer loyalty through dynamic & bulk loyalty and gift card email and sms campaigns.",
    images: [
          {
            url: "https://www.99minds.io/assets/99minds-Klaviyo-OGI.svg",
            alt: "99minds & Klaviyo",
            type: "image/svg",
          }
        ],
        site_name: "99minds",
      }}
      twitter={{
        url: "https://www.99minds.io/integrations/klaviyo",
        images: [
          {
            url: "https://www.99minds.io/assets/99minds-Klaviyo-OGI.svg",
            alt: "99minds & Klaviyo",
            type: "image/svg",
          }
      ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout3>
