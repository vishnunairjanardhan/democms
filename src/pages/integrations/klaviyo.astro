---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroKlaviyo2 from "../../components/heros/HeroKlaviyo2.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureKlaviyo from "../../components/features/FeatureKlaviyo.astro";
import FeatureKlaviyo1 from "../../components/features/FeatureKlaviyo1.astro";
import FeatureKlaviyo2 from "../../components/features/FeatureKlaviyo2.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../../components/integrations/Integrations99minds.astro";
import KlaviyoDemo from "../../components/Infopages/KlaviyoDemo.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Convert Refunds to Sales with 99mind's Store Credit Software | 99minds"
  description="Build customer loyalty and increase sales by easily issuing store credit to process refunds and reward customers."
  canonical="https://www.99minds.io/store-credit"
  openGraph={{
    url: "https://www.99minds.io/store-credit",
    title: "Convert Refunds to Sales with 99mind's Store Credit Software | 99minds",
    description: "Build customer loyalty and increase sales by easily issuing store credit to process refunds and reward customers.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroKlaviyo2 />
  <LogoCloudOne />
  <FeatureKlaviyo1 />
  <!--<FeatureKlaviyo />-->
  <FeatureKlaviyo2 />
  <KlaviyoDemo />
  <!--<Testimonialtry />-->
  <!--<Integrations99minds />-->
  <!--<CtaThree99minds />-->
</BaseLayout>
