import HeroBigcommerce2 from "../../components/heros/HeroBigcommerce2.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureBcom from "../../components/features/FeatureBcom.astro";
import FeatureShopify2 from "../../components/features/FeatureShopify2.astro";
import FeatureShopify3 from "../../components/features/FeatureShopify3.astro";
import FeatureTenBcom from "../../components/features/FeatureTenBcom.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import Cta99mindsBcom from "../../components/ctas/Cta99mindsBcom.astro";
import IntegrationsHome from "../../components/integrations/IntegrationsHome.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";
import IntegrationBigC from "../../components/integrations/IntegrationBigC.astro";
import IntegrationBcom from "../../components/integrations/IntegrationBcom.astro";
import CtaThree from "../../components/ctas/CtaThree.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds.io Integrations | BigCommerce"
  description="Thousands of BigCommerce stores use 99minds' easy integration to increase trust and sales. They provide powerful social proof at every step of the buyer's journey."

  canonical="https://www.99minds.io/integrations/bigcommerce"
  openGraph={{
    url: "https://www.99minds.io/integrations/bigcommerce",
    title: "99minds.io Integrations | BigCommerce",
    description: "Thousands of BigCommerce stores use 99minds' easy integration to increase trust and sales. They provide powerful social proof at every step of the buyer's journey.",
    images: [
          {
            url: "https://www.99minds.io/assets/99minds-BC.svg",
            alt: "99minds & BigCommerce",
            type: "image/svg",
          }
        ],
        site_name: "99minds",
      }}
      twitter={{
        url: "https://www.99minds.io/integrations/bigcommerce",
        images: [
          {
            url: "https://www.99minds.io/assets/99minds-BC.svg",
            alt: "99minds & BigCommerce",
            type: "image/svg",
          }
      ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroBigcommerce2 />
  <LogoCloudOne />
  <FeatureBcom />
  <IntegrationBigC />
  <!--<FeatureShopify2 />-->
  <FeatureTenBcom />
  <IntegrationBcom />
  <Testimonialtry />
  <!--<Integrations99minds />-->
