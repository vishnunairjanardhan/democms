import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds.io Integrations | BigCommerce"
  description="Thousands of BigCommerce stores use 99minds' easy integration to increase trust and sales. They provide powerful social proof at every step of the buyer's journey."

  canonical="https://www.99minds.io/integrations/bigcommerce"
  openGraph={{
    url: "https://www.99minds.io/integrations/bigcommerce",
    title: "99minds.io Integrations | BigCommerce",
    description: "Thousands of BigCommerce stores use 99minds' easy integration to increase trust and sales. They provide powerful social proof at every step of the buyer's journey.",

    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroBigcommerce2 />
  <LogoCloudOne />
  <FeatureBcom1 />
  <FeatureBcom2 />
  <IntegrationBigC />
  <BcomRating />
