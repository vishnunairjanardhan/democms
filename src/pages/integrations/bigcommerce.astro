---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroBigcommerce from "../../components/heros/HeroBigcommerce.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureBcom2 from "../../components/features/FeatureBcom2.astro";
import FeatureBcom1 from "../../components/features/FeatureBcom1.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../../components/integrations/Integrations99minds.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Convert Refunds to Sales with 99mind's Store Credit Software | 99minds"
  description="Build customer loyalty and increase sales by easily issuing store credit to process refunds and reward customers."
  canonical="https://www.99minds.io/integrations/bigcommerce"
  openGraph={{
    url: "https://www.99minds.io/integrations/bigcommerce",
    title: "Convert Refunds to Sales with 99mind's Store Credit Software | 99minds",
    description: "Build customer loyalty and increase sales by easily issuing store credit to process refunds and reward customers.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@99minds",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroBigcommerce />
  <LogoCloudOne />
  <FeatureBcom1 />
  <FeatureBcom2 />
  <BcomRating />
  <!--<Testimonialtry />-->
  <!--<Integrations99minds />-->
  <CtaThree99minds />
</BaseLayout>
