import FeatureShopifypos01 from "../../components/features/FeatureShopifypos01.astro";
import FeatureShopifypos2 from "../../components/features/FeatureShopifypos2.astro";
import FeatureBcom1 from "../../components/features/FeatureBcom1.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
