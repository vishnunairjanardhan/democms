---
import BaseLayout3 from "../../layouts/BaseLayout3.astro";
import IntegrationShopify from "../../components/integrations/IntegrationShopify.astro"; 
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import NewLogoCloud from "../../components/testimonials/NewLogoCloud.jsx";
import FeatureShopify from "../../components/features/FeatureShopify.astro";
import FeatureShopify3 from "../../components/features/FeatureShopify3.astro";
import FeatureBcom1 from "../../components/features/FeatureBcom1.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
//import Cta99mindsShopify from "../../components/ctas/Cta99mindsShopify.astro";
import ClientLogoScroller from "../../components/testimonials/ClientLogoScroller.astro";
import CtaThreeU from "../../components/ctas/CtaThreeU.astro";
import Integrations99minds from "../../components/integrations/Integrations99minds.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";
import FeatureBcom1 from "../../components/features/FeatureBcom1.astro";
import FeatureTen from "../../components/features/FeatureTen.astro";
import IntegrationSection from "../../components/heros/HeroInegrationEcom.jsx";
import { shopifyConfig } from "../../config/HeroIntegration.jsx";


import { AstroSeo } from "@astrolib/seo";
---


<BaseLayout3>
<AstroSeo
  title="99minds and Shopify integration | 99minds",
  description="Add the most powerful omnichannel gift card and loyalty program app to your Shopify account and improve customer retention and revenue.",
  canonical="https://www.99minds.io/integrations/shopify"
  openGraph={{
    url: "https://www.99minds.io/integrations/shopify",
    title: "99minds and Shopify integration | 99minds",
    description: "Add the most powerful omnichannel gift card and loyalty program app to your Shopify account and improve customer retention and revenue.",
    images: [
      {
        url: "https://www.99minds.io/assets/shopify/99minds-Shopify-OGI.svg",
        alt: "99minds & Shopify integration",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/integrations/shopify",
    images: [
      {
        url: "https://www.99minds.io/assets/shopify/99minds-Shopify-OGI.svg",
        alt: "99minds & Shopify integration",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <IntegrationSection config={shopifyConfig} client:load  />
  <ClientLogoScroller />
  <FeatureShopify />
  <FeatureShopify3 />
  <FeatureTen />
  <IntegrationShopify />
  <Testimonialtry />
  <CtaThreeU />
</BaseLayout3>
