import IntegrationShopify from "../../components/integrations/IntegrationShopify.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Using 99minds with Shopify"
  description="Omnichannel gift card, loyalty program and store credit solution for online and in-store, works with leading Point-of-Sale Systems"
  canonical="https://www.99minds.io/integrations/shopify"
  openGraph={{
    url: "https://www.99minds.io/integrations/shopify",
    title: "Using 99minds with Shopify",
    description: "Omnichannel gift card, loyalty program and store credit solution for online and in-store, works with leading Point-of-Sale Systems",
    images: [
      {
        url: "",
        alt: "Social open graph",
        type: "image/jpeg",
      },
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroShopify />
  <LogoCloudOne />
   <!--<FeatureBcom1 />-->
  <FeatureShopify />
  <!--<FeatureShopify2 />-->
  <FeatureTen />
  <IntegrationShopify />
