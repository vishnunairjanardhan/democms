---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSquarePOS from "../../components/heros/HeroSquarePOS.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureSquarePOS from "../../components/features/FeatureSquarePOS.astro";
import FeatureBcom1 from "../../components/features/FeatureBcom1.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../../components/integrations/Integrations99minds.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";
import IntegrationSquare from "../../components/integrations/IntegrationSquare.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Connect 99minds to Square POS"
  description="Square POS has partnered with 99minds to help you a smooth gifting experience and enrich customer relationships with clever loyalty & rewards programs, both online & in-store."
  canonical="https://www.99minds.io/integrations/square"
  openGraph={{
    url: "https://www.99minds.io/integrations/square",
    title: "Connect 99minds to Square POS",
    description: "Square POS has partnered with 99minds to help you a smooth gifting experience and enrich customer relationships with clever loyalty & rewards programs, both online & in-store.",
    images: [
      {
        url: "",
        alt: "Social open graph",
        type: "image/jpeg",
      },
      
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroSquarePOS />
  <LogoCloudOne />
  <FeatureBcom1 />
  <FeatureSquarePOS />
  <IntegrationSquare />
  <BcomRating />
  <!--<Testimonialtry />-->
  <!--<Integrations99minds />-->
  <!--<CtaThree99minds />-->
</BaseLayout>
