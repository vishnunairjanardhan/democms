---
import BaseLayout3 from "../../layouts/BaseLayout3.astro";
import HeroIntegration from "../../components/heros/HeroIntegration.jsx";
import ClientLogoScroller from "../../components/testimonials/ClientLogoScroller.astro";
import FeatureSquare from "../../components/features/FeatureSquare.astro";
import FeatureTenSquare from "../../components/features/FeatureTenSquare.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThreeU from "../../components/ctas/CtaThreeU.astro";
import IntegrationSquare from "../../components/integrations/IntegrationSquare.astro";
import IntegrationSquare2 from "../../components/integrations/IntegrationSquare2.astro";

import { AstroSeo } from "@astrolib/seo";
import { squarePageConfig } from "../../config/heroConfig.js";

const { seo, hero } = squarePageConfig;
---

<BaseLayout3>
  <AstroSeo {...seo} />

  <!-- ✅ Hero gets only its props -->
  <HeroIntegration {...hero} client:load />

  <ClientLogoScroller />
  <FeatureSquare />

  <!-- ✅ Integration sections -->
  <IntegrationSquare />
  <FeatureTenSquare />
  <IntegrationSquare2 />

  <Testimonialtry />
  <CtaThreeU />
</BaseLayout3>
