---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroWoocommerce from "../../components/heros/HeroWoocommerce.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureWcom from "../../components/features/FeatureWcom.astro";
import FeatureTen from "../../components/features/FeatureTen.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import Cta99mindsWcom from "../../components/ctas/Cta99mindsWcom.astro";
import IntegrationWcom2 from "../../components/integrations/IntegrationWcom2.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";
import IntegrationWcom from "../../components/integrations/IntegrationWcom.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds.io integrations | WooCommerce"
  description="Learn more about 99minds.io integrations available on WooCommerce."
  canonical="https://www.99minds.io/integrations/woocommerce"
  openGraph={{
    url: "https://www.99minds.io/integrations/woocommerce",
    title: "99minds.io integrations | WooCommerce",
    description: "Learn more about 99minds.io integrations available on WooCommerce.",
  images: [
      {
        url: "https://www.99minds.io/assets/99minds-woo.svg",
        alt: "99minds & WooCommerce",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/integrations/woocommerce",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-woo.svg",
        alt: "99minds & WooCommerce",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroWoocommerce />
  <LogoCloudOne />
  <FeatureWcom />
  <IntegrationWcom />
  <!--<FeatureShopify2 />-->
  <FeatureTen />
  <IntegrationWcom2 />
  <Testimonialtry />
  <Cta99mindsWcom />
</BaseLayout>
