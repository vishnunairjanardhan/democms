  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroWoocommerce />
  <LogoCloudOne />
  <FeatureBcom1 />
  <FeatureWcom2 />
  <IntegrationWcom />
  <BcomRating />
