import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds.io integrations | WooCommerce"
  description="Learn more about 99minds.io integrations available on WooCommerce."
  canonical="https://www.99minds.io/integrations/woocommerce"
