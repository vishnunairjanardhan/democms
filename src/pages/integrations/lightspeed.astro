---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroLightspeed from "../../components/heros/HeroLightspeed.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureLightspeed from "../../components/features/FeatureLightspeed.astro";
import FeatureLightspeed2 from "../../components/features/FeatureLightspeed2.astro";
import FeatureTenLightspeed from "../../components/features/FeatureTenLightspeed.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../../components/ctas/CtaThree99minds.astro";
import IntegrationLightspeed from "../../components/integrations/IntegrationLightspeed.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds and Lightspeed integration | 99minds"
  description="99minds combines data-driven automation, gift cards store credit, and loyalty programs to deliver smart, targeted marketing for Lightspeed Retail users."
  canonical="https://www.99minds.io/integrations/lightspeed"
  openGraph={{
    url: "https://www.99minds.io/integrations/lightspeed",
    title: "99minds and Lightspeed integration | 99minds",
    description: "99minds combines data-driven automation, gift cards store credit, and loyalty programs to deliver smart, targeted marketing for Lightspeed Retail users.",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-LS.svg",
        alt: "99minds and Lightspeed integration",
        type: "image/jpeg",
      },
      
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroLightspeed />
  <LogoCloudOne />
  <FeatureLightspeed />
  <FeatureLightspeed2 />
  <FeatureTenLightspeed />
  <IntegrationLightspeed />
  <Testimonialtry />
  <CtaThree99minds />
</BaseLayout>
