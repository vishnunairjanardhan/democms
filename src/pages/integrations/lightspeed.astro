import NewLogoCloud from "../../components/testimonials/NewLogoCloud.jsx";
import FeatureLightspeed from "../../components/features/FeatureLightspeed.astro";
import FeatureLightspeed2 from "../../components/features/FeatureLightspeed2.astro";
import FeatureTenLightspeed from "../../components/features/FeatureTenLightspeed.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
