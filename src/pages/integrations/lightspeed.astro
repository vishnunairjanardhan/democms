import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds.io integrations | Lightspeed"
  description="The most powerful gift card and loyalty app for Lightspeed."
  canonical="https://www.99minds.io/integrations/lightspeed"
  openGraph={{
    url: "https://www.99minds.io/integrations/lightspeed",
    title: "99minds.io integrations | Lightspeed",
    description: "The most powerful gift card and loyalty app for Lightspeed.",
    images: [
      {
        url: "",
        alt: "Social open graph",
        type: "image/jpeg",
      },
      
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroLightspeed />
  <LogoCloudOne />
  <FeatureBcom1 />
  <FeatureLightspeed />
  <IntegrationLightspeed />
  <BcomRating />
