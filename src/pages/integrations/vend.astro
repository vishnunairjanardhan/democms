import HeroVend from "../../components/heros/HeroVend.astro";
import ClientLogoScroller from "../../components/testimonials/ClientLogoScroller.astro";
import NewLogoCloud from "../../components/testimonials/NewLogoCloud.jsx";
import FeatureVend from "../../components/features/FeatureVend.astro";
import FeatureVend2 from "../../components/features/FeatureVend2.astro";
import FeatureTenVend from "../../components/features/FeatureTenVend.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
