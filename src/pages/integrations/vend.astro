import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<BaseLayout3>
<AstroSeo
  title="99minds and Vend integration | 99minds"
  description="99minds combines data-driven automation, gift cards store credit, and loyalty programs to deliver smart, targeted marketing for Vend users."
  canonical="https://www.99minds.io/integrations/vend"
  openGraph={{
    url: "https://www.99minds.io/integrations/vend",
    title: "99minds and Vend integration | 99minds",
    description: "99minds combines data-driven automation, gift cards store credit, and loyalty programs to deliver smart, targeted marketing for Vend users.",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-LS-OGI.svg",
        alt: "99minds and Vend integration",
        type: "image/jpeg",
      },
      
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <HeroVend />
  <!--<LogoCloudOne />-->
   <ClientLogoScroller />
  <FeatureVend />
