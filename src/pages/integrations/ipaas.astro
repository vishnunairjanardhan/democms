---
import BaseLayout3 from "../../layouts/BaseLayout3.astro";
import HeroIpaas from "../../components/heros/HeroIpaas.astro";
import LogoCloudOne from "../../components/testimonials/LogoCloudOne.astro";
import FeatureIpaas from "../../components/features/FeatureIpaas.astro";
import FeatureIpaas2 from "../../components/features/FeatureIpaas2.astro";
import Testimonialtry from "../../components/testimonials/Testimonialtry.astro";
//import Cta99mindsPOS from "../../components/ctas/Cta99mindsPOS.astro";
import CtaThreeU from "../../components/ctas/CtaThreeU.astro";
import IntegrationIpaas from "../../components/integrations/IntegrationIpaas.astro";
import BcomRating from "../../components/Infopages/BcomRating.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds & iPaas.com integration"
  description="Set up customizable data flows for your complete ecommerce ecosystem with 99minds and iPaas.com integration. Use No-code API to get accountable data in real-time."
  canonical="https://www.99minds.io/integrations/ipaas"
  openGraph={{
    url: "https://www.99minds.io/integrations/ipaas",
    title: "99minds & iPaas.com integration",
    description: "Set up customizable data flows for your complete ecommerce ecosystem with 99minds and iPaas.com integration. Use No-code API to get accountable data in real-time.",
    images: [
      {
        src: "https://www.99minds.io/assets/iPaas/99minds-Ipaas.webp",
        alt: "99minds IPaaS Integration",
        type: "image/webp",
      },
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout3>
  <HeroIpaas />
  <LogoCloudOne />
  <FeatureIpaas />
  <FeatureIpaas2 />
  <IntegrationIpaas />
  <Testimonialtry />
  <!-- <Cta99mindsPOS /> -->
  <CtaThreeU />
</BaseLayout3>
