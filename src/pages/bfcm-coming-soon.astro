---
import CasestudyLayout from "../layouts/CasestudyLayout.astro";
import Bfcm from "../components/features/Bfcm.astro";
import { AstroSeo } from "@astrolib/seo";

export async function get({ redirect }) {
  return {
    redirect: '/bfcm',
    status: 301 // Use 302 for temporary redirect or 301 for permanent redirect
  };
}

---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<AstroSeo
  title="Black Friday Cyber Monday Omnichannel Slaes"
  description="Discover Real-time Sales of Our Customers on Black Friday & Cyber Monday"
  canonical="https://www.99minds.io/bfcm-coming-soon"
  openGraph={{
    url: "https://www.99minds.io/bfcm-coming-soon",
    title: "Black Friday Cyber Monday Omnichannel Slaes",
    description: "Discover Real-time Sales of Our Customers on Black Friday & Cyber Monday",
    images: [
      {
        url: "https://www.99minds.io/assets/BFCM_sales_tracker.gif",
        alt: "Case Study",
        type: "image/gif",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/bfcm-coming-soon",
    images: [
      {
        url: "https://www.99minds.io/assets/BFCM_sales_tracker.gif",
        alt: "Case Study",
        type: "image/gif",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
 <head>
    <meta http-equiv="refresh" content="0; url=/bfcm" />
    <script>
      window.location.href = '/bfcm';
    </script>
  </head>
<CasestudyLayout>
<Bfcm />
</CasestudyLayout>
