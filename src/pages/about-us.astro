---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import { Seo } from "../config/Seo";
import HeroAboutus from "../components/heros/HeroAboutus.astro";
import HeroAboutUs2 from "../components/heros/HeroAboutUs2.astro";
import FeatureAboutus from "../components/features/FeatureAboutus.astro";
import FeatureAboutUs2 from "../components/features/FeatureAboutUs2.astro";
import FeatureAboutUs3 from "../components/features/FeatureAboutUs3.astro";
import About_us from "../components/Infopages/About_us.astro";
import AboutOne from "../components/about/AboutOne.astro";
import ClientLogoScroller from "../components/testimonials/ClientLogoScroller.astro";
import Team from "../components/about/Team.astro";
import CtaAbout from "../components/ctas/CtaAbout.astro";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<!-- <AstroSeo
  title="About 01"
  description="Your site description goes here"
  canonical=""
  {...Seo}
/>-->
<AstroSeo
  title="About 99minds | All-In-One Gift Card & Loyalty Platform For Businesses"
  description="99minds provides a complete solution for engagement, acquisition, and retention through our gift card and loyalty program services."
  canonical="https://www.99minds.io/about-us"
  openGraph={{
    url: "https://www.99minds.io/about-us",
    title: "About 99minds | All-In-One Gift Card & Loyalty Platform For Businesses",
    description: "99minds provides a complete solution for engagement, acquisition, and retention through our gift card and loyalty program services.",
    images: [
      {
        url: "https://www.99minds.io/assets/automation/Automationbanner2.png",
        alt: "Social open graph",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/about-us",
    images: [
      {
        url: "https://www.99minds.io/assets/automation/Automationbanner2.png",
        alt: "Social open graph",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout3>
  <HeroAboutUs2 />
  <!--<HeroAboutus />-->
  <About_us />
  <FeatureAboutus />
  <!--<AboutOne />-->
  <ClientLogoScroller />
  <FeatureAboutUs3 />
  <FeatureAboutUs2 />
  <!--<Team /> -->
  <CtaAbout />
</BaseLayout3>
