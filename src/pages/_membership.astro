---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroMembership from "../components/heros/HeroMembership.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import FeatureMembership from "../components/features/FeatureMembership.astro";
import FeatureMem1 from "../components/features/FeatureMem1.astro";
import FeatureMem2 from "../components/features/FeatureMem2.astro";
import FeatureMem3 from "../components/features/FeatureMem3.astro";
import Testimonialtry1 from "../components/testimonials/Testimonialtry1.astro";
import CtaThree from "../components/ctas/CtaThree.astro";
import { AstroSeo } from "@astrolib/seo";
import { Seo } from "../config/Seo.jsx";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Gift Cards & Loyalty Platform for Omnichannel e-Commerce & In-store | 99minds"
  description="An easy-to-use, plug-&-play, cost-effective loyalty & promotions platform for businesses to create campaigns to personalize promotions & build omnichannel customer experience."
  canonical="https://www.99minds.io"
  {...Seo}
/>

<BaseLayout>
  <HeroMembership />
  <LogoCloudOne />
  <FeatureMembership />
  <FeatureMem1 />
  <FeatureMem2 />
  <FeatureMem3 />
  <Testimonialtry1 />
  <CtaThree />
</BaseLayout>
