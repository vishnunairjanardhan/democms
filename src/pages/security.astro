---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSecurity from "../components/heros/HeroSecurity.astro";

import { Seo } from "../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Boost Organic Ecommerce Sales With 99minds Referral Program | 99minds"
  description="Incentivize your customers to refer your brand experience to their friends and families with 99minds referral program software."
  canonical="https://www.99minds.io/security"
  openGraph={{
    url: "https://www.99minds.io/security",
    title: "Boost Organic Ecommerce Sales With 99minds Referral Program | 99minds",
    description: "Incentivize your customers to refer your brand experience to their friends and families with 99minds referral program software.",
    images: [
      {
        url: "https://www.99minds.io/assets/referral/Referral-banner2.png ",
        alt: "99minds Referral",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/referral",
    images: [
      {
        url: "https://www.99minds.io/assets/referral/Referral-banner2.png ",
        alt: "99minds Referral",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroSecurity />
  
</BaseLayout>
