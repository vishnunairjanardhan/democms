---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import GDPR from "../components/gdpr/gdpr.astro";
import { AstroSeo } from "@astrolib/seo";
import { Seo } from "../config/Seo";
---

<BaseLayout3>
  <AstroSeo
    title="99minds GDPR Compliance | Ensuring Data Privacy & Security"
    description="Learn how 99minds ensures GDPR compliance with robust policies, secure data processing, and user data rights."
    canonical="https://www.99minds.io/99minds-gdpr-compliance"
    {...Seo}
  />

  <!-- Loads after page becomes idle -->
  <GDPR client:idle />
</BaseLayout3>