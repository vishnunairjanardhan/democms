---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import PassGenerator from "../components/react/walletPassGenerator/index.jsx"
import { AstroSeo } from "@astrolib/seo";
---

<BaseLayout3>
<AstroSeo
  title="Free Wallet Pass Creator | Create Apple & Google Wallet Passes Online | 99minds"
  description="Create Apple Wallet and Google Wallet passes for gift cards and loyalty cards with our free wallet pass creator. Customize, preview, and share your pass in minutes."
  canonical="https://www.99minds.io/wallet-pass-creator"
  openGraph={{
    url: "https://www.99minds.io/wallet-pass-creator",
    title: "Free Wallet Pass Creator | Create Apple & Google Wallet Passes Online | 99minds",
    description: "Create Apple Wallet and Google Wallet passes for gift cards and loyalty cards with our free wallet pass creator. Customize, preview, and share your pass in minutes.",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "99minds",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/wallet-pass-creator",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "99minds",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <PassGenerator client:load>
</BaseLayout3>
