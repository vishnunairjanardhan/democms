---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyNewHeader from "../components/features/CaseStudyNewHeader.astro";
import FeatureCaseStudyNew from "../components/features/FeatureCaseStudyNew.astro";
import FeatureCaseStudyNew2 from "../components/features/FeatureCaseStudyNew2.astro";
import FeatureCaseStudyNew3 from "../components/features/FeatureCaseStudyNew3.astro";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import TestimonialNew from "../components/testimonials/TestimonialNew.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="99minds | Case Studies"
  description="Discover the power of strategic collaborations with 99minds through illuminating case studies"
  canonical="https://www.99minds.io/case-study1"
  openGraph={{
    url: "https://www.99minds.io/case-study1",
    title: "99minds | Case Studies",
    description: "Discover the power of strategic collaborations with 99minds through illuminating case studies",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "Case Study",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/case-study1",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "Case Study",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <CaseStudyNewHeader />
  <FeatureCaseStudyNew/>
  <!-- <FeatureCaseStudyNew2/> -->
  <!-- <Testimonialtry2/> -->
  <TestimonialNew/>
  <CtaThreeU/>
</BaseLayout>
