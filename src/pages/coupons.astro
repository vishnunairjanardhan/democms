---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCoupons from "../components/heros/HeroCoupons.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import FeatureCoupons from "../components/features/FeatureCoupons.astro";
import TestimonialNew from "../components/testimonials/TestimonialNew.astro";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import Integrations99minds2 from "../components/integrations/Integrations99minds2.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds"
  description="99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers."
  canonical="https://www.99minds.io/coupons"
  openGraph={{
    url: "https://www.99minds.io/coupons",
    title: "Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds",
    description: "99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers.",
    images: [
      {
        url: "https://www.99minds.io/assets/coupons/Coupon-banner2.png",
        alt: "Coupons",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/coupons",
    images: [
      {
        url: "https://www.99minds.io/assets/coupons/Coupon-banner2.png",
        alt: "Coupons",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroCoupons />
  <LogoCloudOne />
  <FeatureCoupons />
  <TestimonialNew />
  <Integrations99minds2 />
  <CtaThreeU />
</BaseLayout>
