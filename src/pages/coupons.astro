---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import { couponConfig } from "../config/heroIndex.js";
import HeroSection from "../components/heros/HeroSection.jsx";
import ClientLogoScroller from "../components/testimonials/ClientLogoScroller.astro";
import FeatureCoupons from "../components/features/FeatureCoupons.astro";
import TestimonialCarousel from "../components/testimonials/TestimonialsCarousel.jsx";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import FeatureWalletEight from "../components/features/FeatureWalletEight.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<BaseLayout3>
<AstroSeo
  title="Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds"
  description="99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers."
  canonical="https://www.99minds.io/coupons"
  openGraph={{
    url: "https://www.99minds.io/coupons",
    title: "Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds",
    description: "99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers.",
    images: [
      {
        url: "/assets/coupons/coupon-banner2.webp",
        alt: "Coupons",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/coupons",
    images: [
      {
        url: "/assets/coupons/coupon-banner2.webp",
        alt: "Coupons",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <HeroSection {...couponConfig} client:load />
  <ClientLogoScroller />
  <FeatureCoupons />
  <TestimonialCarousel client:load/>
  <FeatureWalletEight />
  <CtaThreeU />
</BaseLayout3>
