---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCoupons from "../components/heros/HeroCoupons.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import FeatureCoupons from "../components/features/FeatureCoupons.astro";
import Testimonialtry from "../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../components/integrations/Integrations99minds.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds"
  description="99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Bulk, Dynamic & Personalized Coupons Generation For Your Store | 99minds",
    description: "99minds coupon marketing software lets you efficiently create millions of randomly generated personalised coupons to acquire and engage the right customers.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroCoupons />
  <LogoCloudOne />
  <FeatureCoupons />
  <Testimonialtry />
  <Integrations99minds />
  <CtaThree99minds />
</BaseLayout>
