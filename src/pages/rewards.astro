---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import FeatureRewards from "../components/features/FeatureRewards.astro";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";

import { Seo } from "../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<BaseLayout3>
<AstroSeo
  title="Rewards Program"
  description=""
  canonical="https://www.99minds.io/rewards"
  openGraph={{
    url: "https://www.99minds.io/rewards",
    title: "",
    description: "",
    images: [
      {
        url: "https://www.99minds.io/assets/referral/Referral-banner2.png ",
        alt: "99minds Referral",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/rewards",
    images: [
      {
        url: "https://www.99minds.io/assets/referral/Referral-banner2.png ",
        alt: "99minds Referral",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  
 <FeatureRewards/>
 
</BaseLayout3>
