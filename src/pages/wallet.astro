---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->


<BaseLayout3>
<AstroSeo
  title="All in one Digital Wallet for Loyalty and Gift cards | 99minds"
  description="Boost customer engagement with digital passes, interactive gift cards, loyalty rewards, and coupons for Apple Wallet and Google Pay"
  canonical="https://www.99minds.io/wallet"
  openGraph={{
    url: "https://www.99minds.io/wallet",
    title: "All in one Digital Wallet for Loyalty and Gift cards | 99minds",
    description: "Boost customer engagement with digital passes, interactive gift cards, loyalty rewards, and coupons for Apple Wallet and Google Pay",
   images: [
      {
        url: "https://www.99minds.io/assets/wallet/wallet_banner.webp ",
        alt: "99minds Wallet Pass",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/wallet",
    images: [
      {
        url: "https://www.99minds.io/assets/wallet/wallet_banner.webp",
        alt: "99minds Wallet Pass",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<HeroWallet/>
<ClientLogoScroller/>
<WalletSlider/>
<FeatureTabComp3/>
<FeatureWalletFour/> 
<TestimonialCarousel client:load/>
