---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import CouponGenerator from "../components/codeGenerator/codeGenerator"
import { AstroSeo } from "@astrolib/seo";
---

<BaseLayout3>
<AstroSeo
  title="Free Coupon Code Generator | 99minds"
  description="Generate unique and effective coupon codes for free! Enhance your business with quick and easy discount solutions that attract and retain customers."
  canonical="https://www.99minds.io/coupon-code-generator"
  openGraph={{
    url: "https://www.99minds.io/coupon-code-generator",
    title: "Free Coupon Code Generator | 99minds",
    description: "Generate unique and effective coupon codes for free! Enhance your business with quick and easy discount solutions that attract and retain customers.",
    images: [
      {
        url: "/assets/99minds-logo1.svg",
        alt: "Social open graph",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/coupons-code-generator",
    images: [
      {
        url: "/assets/99minds-logo1.svg",
        alt: "Social open graph",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <CouponGenerator client:load>
</BaseLayout3>
