---
import BaseLayout from "../layouts/BaseLayout.astro";
import CouponGenerator from "../components/codeGenerator/GiftCardGenerator"
import { AstroSeo } from "@astrolib/seo";
---
<AstroSeo
  title="Complete Gift Card Solution for All Businesses | 99minds"
  description="99minds enables you to create countless innovative gift cards to provide correct solutions for diverse customer groups."
  canonical="https://www.99minds.io/giftcard-generator"
  openGraph={{
    url: "https://www.99minds.io/giftcard-generator",
    title: "Complete Gift Card Solution for All Businesses | 99minds",
    description: "99minds enables you to create countless innovative gift cards to provide correct solutions for diverse customer groups.",
    
    site_name: "99minds",
  }}
  twitter={{
    
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <CouponGenerator client:load>
</BaseLayout>
