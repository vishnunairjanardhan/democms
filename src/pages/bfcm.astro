---
import CasestudyLayout from "../layouts/CasestudyLayout.astro";
import RealTimeStatsSection from "../components/features/Bfcm.jsx";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<AstroSeo
  title="Black Friday Cyber Monday Omnichannel Slaes"
  description="Discover Real-time Sales of Our Customers on Black Friday & Cyber Monday"
  canonical="https://www.99minds.io/bfcm"
  openGraph={{
    url: "https://www.99minds.io/bfcm",
    title: "Black Friday Cyber Monday Omnichannel Slaes",
    description: "Discover Real-time Sales of Our Customers on Black Friday & Cyber Monday",
    images: [
      {
        url: "https://www.99minds.io/assets/BFCM_sales_tracker.gif",
        alt: "Case Study",
        type: "image/gif",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/bfcm",
    images: [
      {
        url: "https://www.99minds.io/assets/BFCM_sales_tracker.gif",
        alt: "Case Study",
        type: "image/gif",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>

<CasestudyLayout>
<RealTimeStatsSection client:load />
</CasestudyLayout>
