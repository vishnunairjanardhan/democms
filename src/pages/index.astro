---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import HeroIndex from "../components/heros/HeroIndex.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro"
import NewLogoCloud from "../components/testimonials/NewLogoCloud.jsx";
import FeatureFive_NewHome from "../components/features/FeatureFive_NewHome.astro";
import FeatureSix from "../components/features/FeatureSix.astro";
import FeatureTen from "../components/features/FeatureTen.astro";
import TestimonialNew from "../components/testimonials/TestimonialNew.astro";
import TestimonialLite from "../components/testimonials/TestimonialLite.astro";
import Pricing99minds from "../components/pricing/Pricing99minds.astro";
import Faq99minds from "../components/Infopages/Faq99minds.astro";
import ClientLogoScroller from "../components/testimonials/ClientLogoScroller.astro";
import CtaThree from "../components/ctas/CtaThree.astro";
import IntegrationsHome from "../components/integrations/IntegrationsHome.astro";
import { AstroSeo } from "@astrolib/seo";
import { Seo } from "../config/Seo.jsx";
import TestimonialCarousel from "../components/testimonials/TestimonialsCarousel.jsx";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="All-In-One Gift Card & Loyalty Platform For Businesses | 99minds"
  description="An easy-to-use, plug-&-play, cost-effective loyalty & promotions platform for businesses to create campaigns to personalize promotions & build omnichannel customer experience."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "All-In-One Gift Card & Loyalty Platform For Businesses | 99minds",
    description: "An easy-to-use, plug-&-play, cost-effective loyalty & promotions platform for businesses to create campaigns to personalize promotions & build omnichannel customer experience.",
    
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout3>
  <HeroIndex />
  <ClientLogoScroller />
  <FeatureSix />
  <FeatureFive_NewHome />
  <FeatureTen />
  <!--<TestimonialNew />-->
   <TestimonialCarousel client:load/>
  <IntegrationsHome />
  <!--<Pricing99minds />-->
  <Faq99minds />
</BaseLayout3>
