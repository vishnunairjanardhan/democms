---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import HeroAutomatedWF from "../components/heros/HeroAutomatedWF.astro";
import NewLogoCloud from "../components/testimonials/NewLogoCloud.jsx";
import FeatureAutomatedWF from "../components/features/FeatureAutomatedWF.astro";
import TestimonialLite from "../components/testimonials/TestimonialLite.astro";
import Test from "../components/testimonials/Test.astro";
import ModernWorkflow from "../components/testimonials/ModernWorkflow.jsx";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import IntegrationsHome from "../components/integrations/IntegrationsHome.astro";
import FeatureWF from "../components/features/FeatureWF.astro";
import { Seo } from "../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->

<BaseLayout3>
<AstroSeo
  title="Powerful Marketing Automation For Ecommerce | 99minds"
  description="Automate your marketing efforts with gift cards, coupons and store credit at every stage of your customers journey with 99minds powerful marketing automation."
  canonical="https://www.99minds.io/automated-workflow"
  openGraph={{
    url: "https://www.99minds.io/automated-workflow",
    title: "Powerful Marketing Automation For Ecommerce | 99minds",
    description: "Automate your marketing efforts with gift cards, coupons and store credit at every stage of your customers journey with 99minds powerful marketing automation.",
    images: [
      {
        url: "https://www.99minds.io/assets/automation/Automationbanner2.png",
        alt: "Social open graph",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/automated-workflow",
    images: [
      {
        url: "https://www.99minds.io/assets/automation/Automationbanner2.png",
        alt: "Social open graph",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <HeroAutomatedWF />
  <NewLogoCloud />
  <!--<Test />-->
 <ModernWorkflow client:load />
  <FeatureAutomatedWF />
  <TestimonialLite />
  <!---<FeatureWF />--->
  <IntegrationsHome />
  <CtaThreeU />
</BaseLayout3>
