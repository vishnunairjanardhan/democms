---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroAutomatedWF from "../components/heros/HeroAutomatedWF.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import FeatureAutomatedWF from "../components/features/FeatureAutomatedWF.astro";
import Testimonialtry from "../components/testimonials/Testimonialtry.astro";
import Test from "../components/testimonials/Test.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../components/integrations/Integrations99minds.astro";
import FeatureWF from "../components/features/FeatureWF.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Powerful Marketing Automation For Ecommerce | 99minds"
  description="Automate your marketing efforts with gift cards, coupons and store credit at every stage of your customers journey with 99minds powerful marketing automation."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Powerful Marketing Automation For Ecommerce | 99minds",
    description: "Automate your marketing efforts with gift cards, coupons and store credit at every stage of your customers journey with 99minds powerful marketing automation.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroAutomatedWF />
  <LogoCloudOne />
  <Test />
  <FeatureAutomatedWF />
  <Testimonialtry />
  <!---<FeatureWF />--->
  <Integrations99minds />
  <CtaThree99minds />
</BaseLayout>
