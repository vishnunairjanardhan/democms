---
import { getCollection } from "astro:content";
import { AstroSeo } from "@astrolib/seo";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogWithSearch from "../components/react/BlogWithSearch.jsx";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort((a, b) => {
  // Assuming pubDate is a string in ISO 8601 format, you can directly compare them
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
});

const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<AstroSeo
  title='99minds - Blog'
  description="Discover diverse perspectives and valuable insights at 99minds Blog"
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Get Inspired: 99minds Blog Hub",
    description: "Discover diverse perspectives and valuable insights at 99minds Blog",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <section>
    <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-32 lg:py-36 relative">
      <div class="flex justify-center">
        <p class="mt-8 text-4xl font-normal tracking-tighter text-white sm:text-5xl">
          Get all of our latest updates.
        </p>
      </div>
      <BlogWithSearch client:only="react" sortedPosts={sortedPosts} tags={tags}/>
      <form class="mt-6 sm:flex sm:max-w-md">
        <label for="email-address" class="sr-only">Email address</label>
        <input
          type="email"
          name="email-address"
          id="email-address"
          autocomplete="email"
          required
          class="block w-full h-10 px-4 py-2 text-sm text-indigo-300 bg-transparent border rounded-lg appearance-none border-white/10 placeholder-white/50 focus:border-indigo-300 focus:bg-transparent focus:outline-none focus:ring-indigo-300 sm:text-sm"
          placeholder="Enter your email"
        />
        <div class="mt-4 sm:ml-2 sm:mt-0 sm:flex-shrink-0">
          <button
            type="submit"
            class="flex items-center justify-center w-auto h-10 px-4 py-2 text-sm font-semibold text-white transition-all rounded-lg hover:to-indigo-600 bg-gradient-to-b from-indigo-300 via-indigo-400 to-indigo-500"
            >Subscribe</button
          >
        </div>
      </form>
    </div>
  </section>
  <CtaThree99minds />
</BaseLayout>