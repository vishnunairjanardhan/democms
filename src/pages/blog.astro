---
import { getCollection } from "astro:content";
import { AstroSeo } from "@astrolib/seo";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import BlogWithSearch from "../components/react/BlogWithSearch.jsx";
import CaseStudyTabNew from "../components/features/CaseStudyTabNew.astro";

const allPosts = await getCollection("posts");

const sortedPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate))
  .map((post) => ({
    slug: post.slug,
    data: {
      heading: post.data.heading,
      description: (post.data.description ?? "").slice(0, 140),
      pubDate: new Date(post.data.pubDate).toLocaleDateString(),
      image: post.data.image?.url ?? (typeof post.data.image === 'string' ? post.data.image : post.data.image?.src),
    },
  }));

// Deduplicate tags (keep max 30 to limit payload)
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags ?? []))].slice(0, 30);

// Preload the LCP hero image (first post)
const lcpImageUrl = sortedPosts[0]?.data?.image?.url;
---

<BaseLayout3>
  <!-- Preload LCP hero image so browser fetches it before React hydrates -->
  {lcpImageUrl && (
    <link
      rel="preload"
      as="image"
      href={lcpImageUrl}
      fetchpriority="high"
      slot="head"
    />
  )}

  <AstroSeo
    title="99minds - Blog"
    description="Discover diverse perspectives and valuable insights at 99minds Blog"
    canonical="https://www.99minds.io/blog"
    openGraph={{
      url: "https://www.99minds.io/blog",
      title: "Get Inspired: 99minds Blog Hub",
      description: "Discover diverse perspectives and valuable insights at 99minds Blog",
      images: [
        {
          url: "/assets/99minds-logo1.svg",
          alt: "99minds Blog",
          type: "image/svg+xml",
        },
      ],
      site_name: "99minds",
    }}
    twitter={{
      url: "https://www.99minds.io/blog",
      images: [
        {
          url: "/assets/99minds-logo1.svg",
          alt: "99minds Blog",
          type: "image/svg+xml",
        },
      ],
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
  />

  <section>
    <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-24 lg:py-[72px] relative">
      <div class="flex justify-center">
        <h1 class="lg:mt-16 mt-4 text-4xl text-center font-normal tracking-tighter sm:text-5xl">
          Get all of our latest updates.
        </h1>
      </div>

      {/* Use client:load so the blog grid hydrates immediately — it's the primary page content */}
      <BlogWithSearch client:load sortedPosts={sortedPosts} tags={tags} />
      <CaseStudyTabNew client:visible/>
    </div>
  </section>

  <CtaThree99minds />
</BaseLayout3>