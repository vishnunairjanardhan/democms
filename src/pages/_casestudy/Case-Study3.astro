---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import HeroCasestudy from "/src/components/heros/HeroCasestudy.astro";
import Casestudytest3 from "/src/components/testimonials/Casestudytest3.astro";
import FeatureCasestudy from "/src/components/features/FeatureCasestudy.astro";
import CasestudyDetail3 from "/src/components/Infopages/CasestudyDetail3.astro";


import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<BaseLayout>
  <Fragment slot="head">
    <AstroSeo
      title="Case Study - 99minds"
      description="Discover how 99minds helped our customers achieve significant growth and success through our powerful rewards and gifting solutions."
      canonical="https://www.99minds.io/case-study/3"
      openGraph={{
        url: "https://www.99minds.io/case-study/3",
        title: "Case Study - 99minds",
        description: "Discover how 99minds helped our customers achieve significant growth and success through our powerful rewards and gifting solutions.",
        images: [
          {
            url: "https://www.99minds.io/assets/99minds-logo1.svg",
            alt: "Social open graph",
            type: "image/svg",
          }
        ],
        site_name: "99minds",
      }}
      twitter={{
        site: "@99minds_io",
        cardType: "summary_large_image",
      }}
    />
  </Fragment>
  <HeroCasestudy />
  <Casestudytest3 />
  <CasestudyDetail3 />
  <FeatureCasestudy />
</BaseLayout>
