---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import Integrationpage from "../components/integrations/Integrationpage.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Integrations to connect with apps you use | 99minds"
  description="Fully integrate your direct mail and e-gifting campaigns with Salesforce: Send, measure and scale everything using our 1-click integration. Learn more."
  canonical="https://www.99minds.io/integrations"
  openGraph={{
    url: "https://www.99minds.io/integrations",
    title: "Integrations to connect with apps you use | 99minds",
    description: "Fully integrate your direct mail and e-gifting campaigns with Salesforce: Send, measure and scale everything using our 1-click integration. Learn more.",
    images: [
      {
        url: "https://www.99minds.io/assets/Int-1.png",
        alt: "99minds Integrations",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/integrations",
    images: [
      {
        url: "https://www.99minds.io/assets/Int-1.png",
        alt: "99minds Integrations",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout3>
  <Integrationpage/>
</BaseLayout3>
