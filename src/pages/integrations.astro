---
import BaseLayout from "../layouts/BaseLayout.astro";
import Integrationpage from "../components/integrations/Integrationpage.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Integrations to connect with apps you use | 99minds"
  description="Fully integrate your direct mail and e-gifting campaigns with Salesforce: Send, measure and scale everything using our 1-click integration. Learn more."
  canonical="https://www.99minds.io/integration"
  openGraph={{
    url: "https://www.99minds.io/integration",
    title: "Integrations to connect with apps you use | 99minds",
    description: "Fully integrate your direct mail and e-gifting campaigns with Salesforce: Send, measure and scale everything using our 1-click integration. Learn more.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@99minds",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <Integrationpage />
</BaseLayout>
