---
import { getCollection } from "astro:content";
import EntriesOne from "../components/entries/EntriesOne.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AstroSeo } from "@astrolib/seo";

const searchTerm = $searchTerm;
const allPosts = await getCollection("posts");

const filteredPosts = allPosts.filter(post =>
  post.data.title.toLowerCase().includes(searchTerm.toLowerCase())
);
---

<AstroSeo
  title={`Search Results for "${searchTerm}" - 99minds Blog`}
  description={`Search results for "${searchTerm}" on 99minds Blog`}
  canonical="https://www.99minds.io/search"
/>

<BaseLayout>
  <section>
    <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-32 lg:py-36 relative">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-normal tracking-tighter text-white sm:text-5xl">Search Results for "{searchTerm}"</h1>
        <div class="py-24">
          <ol class="grid grid-cols-1 gap-4 lg:grid-cols-3 sm:grid-cols-2" role="list">
            {filteredPosts.map((post) => (
              <EntriesOne
                url={`/blog/${post.slug}`}
                title={post.data.title}
                description={post.data.description}
                alt={post.data.title}
                pubDate={post.data.pubDate.toString().slice(0, 10)}
                author={post.data.author}
                image={post.data.image.url}
                key={post.slug}
              />
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
