---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import HeroWallet from "../components/heros/HeroWallet.astro";
import ClientLogoScroller from "../components/testimonials/ClientLogoScroller.astro";
import FeatureWalletFour from "../components/features/FeatureWalletFour.astro";
import FeatureTabComp3 from "../components/features/FeatureTabComp3.astro";
import FeatureTabTest from "../components/features/FeatureTabTest.astro";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import { Seo } from "../config/Seo";
import { AstroSeo } from "@astrolib/seo";
import WalletSlider from "../components/features/WalletSlider.astro";
import TestimonialCarousel from "../components/testimonials/TestimonialsCarousel.jsx";
import PricingSection from "../components/pricing/PricingSection.jsx"; 
import pricingConfig from "../config/WalletPricing.js"; 
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->


<BaseLayout3>
<AstroSeo
  title="All in one Digital Wallet for Loyalty and Gift cards | 99minds"
  description="Boost customer engagement with digital passes, interactive gift cards, loyalty rewards, and coupons for Apple Wallet and Google Pay"
  canonical="https://www.99minds.io/wallet"
  openGraph={{
    url: "https://www.99minds.io/wallet",
    title: "All in one Digital Wallet for Loyalty and Gift cards | 99minds",
    description: "Boost customer engagement with digital passes, interactive gift cards, loyalty rewards, and coupons for Apple Wallet and Google Pay",
   images: [
      {
        url: "https://www.99minds.io/assets/wallet/wallet_banner.webp ",
        alt: "99minds Wallet Pass",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/wallet",
    images: [
      {
        url: "https://www.99minds.io/assets/wallet/wallet_banner.webp",
        alt: "99minds Wallet Pass",
        type: "image/png",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<HeroWallet/>
<ClientLogoScroller/>
<WalletSlider/>
<FeatureTabComp3/>
<FeatureWalletFour/> 
<PricingSection config={pricingConfig} client:load />
<TestimonialCarousel client:load/>
<!-- <TestimonialWallet /> -->
<FeatureWalletEight />
<CtaThreeU />
</BaseLayout3>
