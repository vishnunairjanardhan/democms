
---
import BaseLayout2 from "../layouts/BaseLayout2.astro";
import Slide from "../components/features/Slide.astro";
import ROICalculator from "../components/features/ROI.jsx";
import FeatureLogoWave from "../components/features/FeatureLogoWave.jsx";
import Slide1 from "../components/features/Slide1.astro";
import HeroSlide from "../components/heros/HeroSlide.astro";
import ProgramWidget from "../components/features/ProgramWidget.astro";
import FeatureCarousal from "../components/features/FeatureCarousal.astro";
import WorkFlow from "../components/features/WorkFlow.astro";
import SocialWidget from "../components/features/SocialWidget.astro";
import LogoMarquee from "../components/features/LogoMarquee.jsx";
import FeatureMem3 from "../components/features/FeatureMem3.astro";
import FeatureVerticalScroll from "../components/features/FeatureVerticalScroll.jsx";
import FeatureVerticalScroll1 from "../components/features/FeatureVerticalScroll1.jsx";
import TestimonialNew from "../components/testimonials/TestimonialNew.astro";
import LogosAnimate from "../components/testimonials/LogosAnimate.astro";
import NewLogoCloud from "../components/testimonials/NewLogoCloud.jsx";
import IntegrationAnimate from "../components/features/IntegrationAnimate.astro";
import FeatureTabComp from "../components/features/FeatureTabComp.astro";
import Bfcm from "../components/features/Bfcm.astro";
import ShopifyCheckout from "../components/features/ShopifyCheckout.astro";
import ResultsSection from "../components/features/ROI3.jsx";
import ScrollComp from "../components/features/ScrollComp.astro";
import { AstroSeo } from "@astrolib/seo";
import GlobeWithHexCountries from "../components/customers/ThreeScene.jsx"
import Counter from "../components/customers/Counter.astro"
import Slider from "../components/features/Slider.astro";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<head>
  <meta name="robots" content="noindex, nofollow">
</head>
<AstroSeo
  title="99minds | Case Studies"
  description="Discover the power of strategic collaborations with 99minds through illuminating case studies"
  canonical="https://www.99minds.io/product"
  openGraph={{
    url: "https://www.99minds.io/product",
    title: "99minds | Case Studies",
    description: "Discover the power of strategic collaborations with 99minds through illuminating case studies",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "Case Study",
        type: "image/svg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    url: "https://www.99minds.io/case-study1",
    images: [
      {
        url: "https://www.99minds.io/assets/99minds-logo1.svg",
        alt: "Case Study",
        type: "image/svg",
      }
    ],
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout2>
<!--<Bfcm />-->

<Slider/>
<FeatureVerticalScroll client:load/>
<!-- <FeatureVerticalScroll1 client:load/> -->

<Slide/>
<FeatureCarousal/>
<LogoMarquee client:load/>
<ProgramWidget/>
<SocialWidget/>
<Slide1/>
<ScrollComp />
<FeatureMem3 />
<FeatureTabComp />
<ShopifyCheckout/>
<WorkFlow/>
<Counter/>
<ROICalculator client:load/>
<FeatureLogoWave client:load/>
<LogosAnimate/>
<!--<GlobeWithHexCountries client:load />
<ResultsSection client:load />-->
<!-- <IntegrationAnimate/> -->

<HeroSlide/>



</BaseLayout2>
