---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroThree from "../components/heros/HeroThree.astro";
import HeroLoyalty from "../components/heros/HeroLoyalty.astro";
import LogoCloud from "../components/testimonials/LogoCloud.astro";
import LogoCloudTwo from "../components/testimonials/LogoCloudTwo.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import LogoCloudFour from "../components/testimonials/LogoCloudFour.astro";
import FeatureFive_NewHome from "../components/features/FeatureFive_NewHome.astro";
import FeatureNine from "../components/features/FeatureNine.astro";
import FeatureLoyalty from "../components/features/FeatureLoyalty.astro";
import FeatureTwo from "../components/features/FeatureTwo.astro";
import FeatureSeven from "../components/features/FeatureSeven.astro";
import FeatureTen from "../components/features/FeatureTen.astro";
import Testimonialtry from "../components/testimonials/Testimonialtry.astro";
import PricingFive from "../components/pricing/PricingFive.astro";
import FaqTwo from "../components/Infopages/FaqTwo.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../components/integrations/Integrations99minds.astro";
import LoyaltyTab from "../components/features/LoyaltyTab.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Build Strong Customer Loyalty With 99minds Loyalty Program | 99minds"
  description="99minds loyalty program enables businesses to increase brand loyalty and forge endless customer relationships that boost customer engagement and retention."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Build Strong Customer Loyalty With 99minds Loyalty Program | 99minds",
    description: "99minds loyalty program enables businesses to increase brand loyalty and forge endless customer relationships that boost customer engagement and retention.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroLoyalty />
  <LogoCloudOne />
  <FeatureLoyalty />
  <LoyaltyTab />
  <Testimonialtry />
  <Integrations99minds />
  <CtaThree99minds />
</BaseLayout>
