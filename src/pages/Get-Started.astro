---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import GetStarted from "../components/getStarted/getStarted";
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="Get Started with 99minds"
  description="Scale up your business with 99minds and escalate your brand value with custom gift cards, loyalty programs, store credits and many more."
  canonical="https://www.99minds.io/Get-Started"
  openGraph={{
    url: "https://www.99minds.io/Get-Started",
    title: "Get Started with 99minds",
    description: "Scale up your business with 99minds and escalate your brand value with custom gift cards, loyalty programs, store credits and many more.",
    site_name: "99minds",
  }}
/>
<BaseLayout3>

<section class="bg-vulcan-50 relative">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-16 lg:pt-16">
    <div class="mt-12 space-y-12">      
    <div class="flex flex-col w-full gap-2 mt-10 justify-center items-center">
        <div class="lg:px-16 lg:pt-4 lg:pb-10 text-black max-w-4xl mx-auto">
            <h2 class="text-center lg:text-3xl text-2xl p-4 font-normal leading-8 text-black">Choose your eCommerce Platform</h2>
            <div class="mx-auto lg:mt-6 grid grid-cols-1 p-2 items-center gap-x-8 gap-y-10 sm:grid-cols-3 sm:gap-x-10 lg:mx-12 lg:max-w-none lg:grid-cols-3 md:">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1' target="_blank">
                        <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopify-logo-1-w.svg" alt="Transistor" >
                        </a>
                    </button>
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://www.bigcommerce.com/apps/99minds-gift-card' target="_blank">
                        <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/bigcommerce-logo-w.svg" alt="Transistor" >
                        </a>
                    </button>
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1' target="_blank">
                            <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopifyPlus-logo-w.svg" alt="Transistor" >
                        </a>
                    </button>
            </div>
        </div>
        <div class="mx-auto  max-w-6xl">
            <h2 class="text-center text-2xl font-normal tracking-tight text-black lg:mt-0 mt-12 pt-12">Trusted by over 1,000 growing brands
            </h2>
            <div class="mx-auto pt-4 grid max-w-2xl grid-cols-1 lg:mx-0 lg:max-w-none lg:grid-cols-2">
                <div class="flex flex-col p-6">
                    <a href="https://apps.shopify.com/reviews/1252681" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r1.webp" alt="image"></a>
                </div>
                <div class="flex flex-col p-6">
                     <a href="https://apps.shopify.com/reviews/1260693" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r2.webp" alt="image"></a>
                </div>
                <div class="flex flex-col p-6">
                     <a href="https://apps.shopify.com/reviews/1256839" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r3.webp" alt="image"></a>
                </div>
                <div class="flex flex-col p-6">
                    <a href="https://www.bigcommerce.com/apps/99minds-gift-card/?page=4" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r4.webp" alt="image"></a>
                </div>
                 <div class="flex flex-col p-6">
                     <a href="https://www.bigcommerce.com/apps/99minds-gift-card/?page=7" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r5.webp" alt="image"></a>
                </div>
                 <div class="flex flex-col p-6">
                     <a href="https://www.bigcommerce.com/apps/99minds-gift-card/?page=7" target="_blank"><img class="rounded-lg shadow-xl self-start" src="/r6.webp" alt="image"></a>
                </div>  
            </div> 
        </div>
    </div>
</section>

</BaseLayout3>
