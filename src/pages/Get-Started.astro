---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import GetStarted from "../components/getStarted/getStarted";
---
<head>
    <meta name="robots" content="noindex, nofollow">
</head>
<BaseLayout3>
=

<section class="bg-vulcan-50 relative">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-16 lg:pt-16">
    <div class="mt-12 space-y-12">      
    <div class="flex flex-col w-full gap-2 mt-10">
        <div class="lg:px-16 lg:pt-4 lg:pb-10 text-black">
            <h2 class="text-center lg:text-3xl text-2xl p-4 font-normal leading-8 text-black">Choose your eCommerce Platform</h2>
            <div class="mx-auto lg:mt-6 grid max-w-lg grid-cols-1 p-2 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-3 sm:gap-x-10 lg:mx-4 lg:max-w-none lg:grid-cols-5 md:">
                <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-6 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-4">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1' target="_blank">
                        <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopify-logo-1-w.svg" alt="Transistor" >
                        </a>
                    </button>
                </div>
                <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-center lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-4">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://www.bigcommerce.com/apps/99minds-gift-card' target="_blank">
                        <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/bigcommerce-logo-w.svg" alt="Transistor" >
                        </a>
                    </button>
                </div>
                <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-center lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-4">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1' target="_blank">
                            <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopifyPlus-logo-w.svg" alt="Transistor" >
                        </a>
                    </button>
                </div>
                <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-center lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-4">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://appexchange.salesforce.com/appxListingDetail?listingId=a0N4V00000J6Jc3UAF' target="_blank">
                            <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/Salesforce-logo-w.svg" alt="Transistor" >
                        </a>
                    </button>
                </div>
                <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-center lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-4">
                    <button type="button" class="relative raise1 cursor-pointer focus:outline-none border rounded-lg bg-vulcan-900 border-gray-700 ">
                        <a href='https://wordpress.org/plugins/99minds-gift-card/' target="_blank">
                            <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/woocommerce-logo1-w.svg" alt="Transistor" >
                        </a>
                    </button>
                </div> 
            </div>
        </div>
        <div class="mx-auto  max-w-6xl">
            <h2 class="text-center text-2xl font-normal tracking-tight text-black lg:mt-0 mt-12 pt-12">Trusted by over 1,000 growing brands
            </h2>
            <div class="mx-auto pt-4 grid max-w-2xl grid-cols-1 lg:mx-0 lg:max-w-none lg:grid-cols-2">
                <div class="flex flex-col p-4">
                    <img class="rounded-lg shadow self-start" src="/r-1.png" alt="image">
                </div>
                <div class="flex flex-col p-4">
                    <img class="rounded-lg self-start" src="/r-5.png" alt="image">
                </div>
                <div class="flex flex-col p-5">
                    <img class="rounded-lg self-start" src="/r-3.png" alt="image">
                </div>
                <div class="flex flex-col p-5">
                    <img class="rounded-lg self-start" src="/r-4.png" alt="image">
                </div>
                 <div class="flex flex-col p-5">
                    <img class="rounded-lg self-start" src="/r-2.png" alt="image">
                </div>
                 <div class="flex flex-col p-5">
                    <img class="rounded-lg self-start" src="/r-6.png" alt="image">
                </div>  
            </div> 
        </div>
    </div>
</section>

</BaseLayout3>
