---
import CasestudyLayout from "../layouts/CasestudyLayout.astro";
import GetStarted from "../components/getStarted/getStarted";
---

<CasestudyLayout>
<!-- <GetStarted/> -->
<section class="relative">
<div className='relative px-8 py-12 mx-auto max-w-7xl md:px-12 lg:px-16 lg:py-24'>
<div class="mx-auto max-w-7xl px-6 lg:px-8 bg-gray-900 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="text-center text-3xl font-semibold leading-8 text-white">Choose your eCommerce Platform</h2>
      <div class="mx-auto mt-10 grid max-w-lg grid-cols-4 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-6 sm:gap-x-10 lg:mx-4 lg:max-w-none lg:grid-cols-5">
        <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5">
            <div className={`relative cursor-pointer focus:outline-none rounded-lg border hover:border-indigo-300 duration-300 group`}>
                <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1'>
                <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopify-logo-1-w.svg" alt="Transistor" >
                </a>
            </div>
        </div>
        <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5">
            <div className={`relative cursor-pointer focus:outline-none rounded-lg border hover:border-indigo-300 duration-300 group`}>
                <a href='https://www.bigcommerce.com/apps/99minds-gift-card'>
                <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/bigcommerce-logo-w.svg" alt="Transistor" >
                </a>
            </div>
        </div>
        <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5">
            <div className={`relative cursor-pointer focus:outline-none rounded-lg border hover:border-indigo-300 duration-300 group`}>
                <a href='https://apps.shopify.com/99minds-gift-card-loyalty-referral?show_store_picker=1'>
                <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/shopifyPlus-logo-w.svg" alt="Transistor" >
                </a>
            </div>
        </div>
        <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5">
            <div className={`relative cursor-pointer focus:outline-none rounded-lg border hover:border-indigo-300 duration-300 group`}>
                <a href='https://appexchange.salesforce.com/appxListingDetail?listingId=a0N4V00000J6Jc3UAF'>
                <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/Salesforce-logo-w.svg" alt="Transistor" >
                </a>
            </div>
        </div>
        <div className="mx-auto lg:mt-24 mt-10 grid max-w-lg grid-cols-1 justify-between lg:px-0 px-4 pb-4 items-center gap-x-2 gap-y-6 sm:max-w-xl sm:grid-cols-1 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5">
            <div className={`relative cursor-pointer focus:outline-none rounded-lg border hover:border-indigo-300 duration-300 group`}>
                <a href='/'>
                <img class="max-h-12 w-full object-contain p-3" src="/images/coupon-generator/woocommerce-logo1-w.svg" alt="Transistor" >
                </a>
            </div>
        </div>
        <!-- <img class="col-span-2 max-h-12 w-full object-contain lg:col-span-1" src="https://tailwindui.com/img/logos/158x48/reform-logo-white.svg" alt="Reform" width="158" height="48">
        <img class="col-span-2 max-h-12 w-full object-contain lg:col-span-1" src="https://tailwindui.com/img/logos/158x48/tuple-logo-white.svg" alt="Tuple" width="158" height="48">
        <img class="col-span-2 max-h-12 w-full object-contain sm:col-start-2 lg:col-span-1" src="https://tailwindui.com/img/logos/158x48/savvycal-logo-white.svg" alt="SavvyCal" width="158" height="48">
        <img class="col-span-2 col-start-2 max-h-12 w-full object-contain sm:col-start-auto lg:col-span-1" src="https://tailwindui.com/img/logos/158x48/statamic-logo-white.svg" alt="Statamic" width="158" height="48"> -->
      </div>
      <div>
        <h2 class="text-center text-2xl font-normal tracking-tight text-white lg:mt-0 mt-12 pt-12">Trusted by over 1,000 growing brands
        </h2>
        <div class="mx-auto grid max-w-2xl grid-cols-1 lg:mx-0 lg:max-w-none lg:grid-cols-2">
            <div class="flex flex-col p-5">
                <img class="rounded-lg shadow self-start" src="/review1.png" alt="image">
            </div>
            <div class="flex flex-col p-5">
                <img class="rounded-lg self-start" src="/review2.png" alt="image">
            </div>
            <div class="flex flex-col p-5">
                <img class="rounded-lg self-start" src="/review3.png" alt="image">
            </div>    
        </div> 
    </div>
    </div>
</div>
</section>
</CasestudyLayout>
