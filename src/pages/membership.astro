---
import BaseLayout3 from "../layouts/BaseLayout3.astro";
import { membership } from "../config/heroIndex.js";
import HeroSection from "../components/heros/HeroSection.jsx";
import ClientLogoScroller from "../components/testimonials/ClientLogoScroller.astro";
import FeatureMembership1 from "../components/features/FeatureMembership1.astro";
import FeatureMembership3 from "../components/features/FeatureMembership3.astro";
import TestimonialCarousel from "../components/testimonials/TestimonialsCarousel.jsx";
import CtaThreeU from "../components/ctas/CtaThreeU.astro";
import FeatureWalletEight from "../components/features/FeatureWalletEight.astro";
import FaqMembership from "../components/Infopages/FaqMembership.astro";
import GiftCardTab from "../components/features/GiftCardTab.astro";
import GiftCardTab1 from "../components/features/GiftCardTab1.astro";
import GiftcardHeroSection from "../components/features/GiftcardHeroSection.jsx";
import { Seo } from "../config/Seo";
import { AstroSeo } from "@astrolib/seo";
import LogoCarosel from "../components/testimonials/LogoCarousel.jsx";
import GiftCardFeatures from "../components/features/GiftCardFeatures.jsx";
import FeatureSection from "../components/features/FeatureSection.jsx";
import { membershipFeaturesConfig, membershipHowItWorksConfig } from "../config/memberRetentionConfig.js";
import FeatureWork from "../components/features/FeatureHowItWorks.jsx";
---

<BaseLayout3>
  <AstroSeo
    title="Turn One-Time Buyers into Loyal Members | Membership & Loyalty Program"
    description="Boost repeat purchases and predictable revenue with 99minds. Build memberships that drive loyalty, engage customers across channels, and grow your brand"
    canonical="https://www.99minds.io/membership"
    openGraph={{
      url: "https://www.99minds.io/membership",
      title: "Turn One-Time Buyers into Loyal Members | 99minds Membership & Loyalty Program",
      description: "Boost repeat purchases and predictable revenue with 99minds. Build memberships that drive loyalty, engage customers across channels, and grow your brand",
      images: [
        {
          url: "https://www.99minds.io/assets/membership/membership1.webp",
          alt: "99minds Membership & Loyalty Program",
          type: "image/webp",
        },
      ],
      site_name: "99minds",
    }}
    twitter={{
      url: "https://www.99minds.io/membership",
      title: "Turn One-Time Buyers into Loyal Members | 99minds Membership & Loyalty Program",
      description: "Boost repeat purchases and predictable revenue with 99minds. Build memberships that drive loyalty, engage customers across channels, and grow your brand",
      images: [
        {
          url: "https://www.99minds.io/assets/membership/membership1.webp",
          alt: "99minds Membership & Loyalty Program",
          type: "image/webp",
        },
      ],
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
  />

  <HeroSection {...membership} client:load />
  <ClientLogoScroller />
  <FeatureWork {...membershipHowItWorksConfig} />
  <FeatureSection {...membershipFeaturesConfig} />
  <TestimonialCarousel client:load />
  <FeatureWalletEight />
  <FeatureMembership3 />
  <FaqMembership />
</BaseLayout3>
