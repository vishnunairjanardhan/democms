---
import BaseLayout3 from "/src/layouts/BaseLayout3.astro";
import HeroCasestudyJaxen from "/src/components/heros/HeroCasestudyJaxen.astro";
import CasestudytestJaxen from "/src/components/testimonials/CasestudytestJaxen.astro";
import FeatureCasestudyJaxen from "/src/components/features/FeatureCasestudyJaxen.astro";
import Jaxen from "/src/components/Infopages/Jaxen.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->

<BaseLayout3>
<AstroSeo
  title="Jaxen Grey's Gift Card Promotions Boost Engagement by 20% | 99minds"
  description="Learn how Jaxen Grey used social media gift card promotions to drive 20% sales growth, boost foot traffic, and enhance customer loyalty. Discover their strategies!"
  canonical="https://www.99minds.io/case-study/jaxengrey"
  openGraph={{
    url: "https://www.99minds.io/case-study/jaxengrey",
    title: "Jaxen Grey's Gift Card Promotions Boost Engagement by 20% | 99minds",
    description: "Learn how Jaxen Grey used social media gift card promotions to drive 20% sales growth, boost foot traffic, and enhance customer loyalty. Discover their strategies!",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/jaxengrey.png",
        alt: "Jaxen Grey uses 99minds Gift Card & Loyalty Program",
        type: "image/png",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
  <HeroCasestudyJaxen />
  <CasestudytestJaxen />
  
<Jaxen />
<FeatureCasestudyJaxen />
</BaseLayout3>
