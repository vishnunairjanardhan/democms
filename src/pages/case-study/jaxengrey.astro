---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import HeroCasestudyJaxen from "/src/components/heros/HeroCasestudyJaxen.astro";
import CasestudytestJaxen from "/src/components/testimonials/CasestudytestJaxen.astro";
import FeatureCasestudyJaxen from "/src/components/features/FeatureCasestudyJaxen.astro";
import Jaxen from "/src/components/Infopages/Jaxen.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->
<AstroSeo
  title="Jaxen Grey's Case Study: Over $300k Gift Card Sales | 99minds"
  description=" Jaxen Grey's Social Media Gift card Promotions Drive Engagement and Sales"
  canonical="https://www.99minds.io/case-study/Jaxensunglasses"
  openGraph={{
    url: "https://www.99minds.io/case-study/Jaxensunglasses",
    title: "Jaxen Grey's Case Study: Over $300k Gift Card Sales | 99minds",
    description: " Jaxen Grey's Social Media Gift card Promotions Drive Engagement and Sales",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/Jaxen-CS.jpg",
        alt: "Jaxen Sunglasses uses 99minds Gift Card & Loyalty Program",
        type: "image/jpeg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroCasestudyJaxen />
  <CasestudytestJaxen />
  
<Jaxen />
<FeatureCasestudyJaxen />
</BaseLayout>
