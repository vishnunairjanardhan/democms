---
import BaseLayout3 from "/src/layouts/BaseLayout3.astro";
import HeroCasestudyBfearless from "/src/components/heros/HeroCasestudyBfearless.astro";
import CasestudytestBfearless from "/src/components/testimonials/CasestudytestBfearless.astro";
import FeatureCasestudyBfearless from "/src/components/features/FeatureCasestudyBfearless.astro";
import Bfearless from "/src/components/Infopages/Bfearless.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->

<BaseLayout3>
  <AstroSeo
    title="Bfearless At-Home Loyalty Program"
    description="Discover how Bfearless improved repeat purchases by 35% and increased AOV by 15% with a seamless online and in-store loyalty program."
    canonical="https://www.99minds.io/case-study/bfearless"
    openGraph={{
      url: "https://www.99minds.io/case-study/bfearless",
      title: "Bfearless At-Home Loyalty Program",
      description: "Discover how Bfearless improved repeat purchases by 35% and increased AOV by 15% with a seamless online and in-store loyalty program.",
      images: [
        {
          url: "https://www.99minds.io/assets/case-study/bfearless.png",
          alt: "Tassels Shoes uses 99minds Gift Card & Loyalty Program",
          type: "image/jpeg",
        }
      ],
      site_name: "99minds",
    }}
    twitter={{
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
  />
<HeroCasestudyBfearless />
<CasestudytestBfearless />
<Bfearless />
<FeatureCasestudyBfearless />
</BaseLayout3>
