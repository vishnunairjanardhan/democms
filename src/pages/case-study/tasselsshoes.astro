---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import HeroCasestudyTassels from "/src/components/heros/HeroCasestudyTassels.astro";
import CasestudytestTassels from "/src/components/testimonials/CasestudytestTassels.astro";
import FeatureCasestudyTassels from "/src/components/features/FeatureCasestudyTassels.astro";
import Tassels from "/src/components/Infopages/Tassels.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->
<AstroSeo
  title="Tassels Shoes Case Study | 99minds"
  description="TasselsShoes.com’s Omnichannel Store Credit, Loyalty, and Gift Card Integration with Klaviyo"
  canonical="https://www.99minds.io/case-study/tasselsshoes"
  openGraph={{
    url: "https://www.99minds.io/case-study/tasselsshoes",
    title: "Tassels Shoes Case Study | 99minds",
    description: "TasselsShoes.com’s Omnichannel Store Credit, Loyalty, and Gift Card Integration with Klaviyo",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/Solstice-CS.jpg",
        alt: "Tassels Shoes uses 99minds Gift Card & Loyalty Program",
        type: "image/jpeg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
<HeroCasestudyTassels />
<CasestudytestTassels />
<Tassels />
<FeatureCasestudyTassels />
</BaseLayout>
