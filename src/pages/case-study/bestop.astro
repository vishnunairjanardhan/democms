---
import BaseLayout3 from "/src/layouts/BaseLayout3.astro";
import HeroCasestudyBestop from "/src/components/heros/HeroCasestudyBestop.astro";
import Casestudytestbestop from "/src/components/testimonials/Casestudytestbestop.astro";
import Featurecasestudybestop from "/src/components/features/Featurecasestudybestop.astro";
import Infobestop from "/src/components/Infopages/Infobestop.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->

<BaseLayout3>
  <Fragment slot="head">
  <AstroSeo
    title="Bestop Boosts Conversion Rate by 15% with Gift Card Promo |  99minds"
    description="Discover how Bestop increased its conversion rate by 15% using a Facebook gift card giveaway with Heather Storm, driving engagement and sales growth"
    canonical="https://www.99minds.io/case-study/bestop"
    openGraph={{
      url: "https://www.99minds.io/case-study/bestop",
      title: " Bestop Boosts Conversion Rate by 15% with Gift Card Promo |  99minds",
      description: "Discover how Bestop increased its conversion rate by 15% using a Facebook gift card giveaway with Heather Storm, driving engagement and sales growth",
      images: [
        {
          url: "https://www.99minds.io/assets/case-study/Bestop-banner.webp",
          alt: "Bestop uses 99minds Gift Card & Loyalty Program",
          type: "image/jpeg",
        }
      ],
      site_name: "99minds",
    }}
    twitter={{
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
  />
  </Fragment>
  <HeroCasestudyBestop />
  <Casestudytestbestop />
  <Infobestop />
  <Featurecasestudybestop />
</BaseLayout3>
