---
import BaseLayout3 from "/src/layouts/BaseLayout3.astro";
import HeroCasestudySolstice from "/src/components/heros/HeroCasestudySolstice.astro";
import CasestudytestSolstice from "/src/components/testimonials/CasestudytestSolstice.astro";
import FeatureCasestudySolstice from "/src/components/features/FeatureCasestudySolstice.astro";
import Solstice from "/src/components/Infopages/Solstice.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->

<BaseLayout3>
<Fragment slot="head">
<AstroSeo
  title="Solstice Case Study: 30% Conversion Rate Increase with Omnichannel Gift Cards | 99Minds"
  description="Discover how Solstice boosted conversions by 30% and AOV by 28% with an integrated omnichannel gift card system, enhancing customer engagement and loyalty."
  canonical="https://www.99minds.io/case-study/solsticesunglasses"
  openGraph={{
    url: "https://www.99minds.io/case-study/solsticesunglasses",
    title: "Solstice Case Study: 30% Conversion Rate Increase with Omnichannel Gift Cards | 99Minds",
    description: "Discover how Solstice boosted conversions by 30% and AOV by 28% with an integrated omnichannel gift card system, enhancing customer engagement and loyalty.",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/Solstice-CS.jpg",
        alt: "Solstice Sunglasses uses 99minds Gift Card & Loyalty Program",
        type: "image/jpeg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
</Fragment>
  <HeroCasestudySolstice />
  <CasestudytestSolstice />
  
<Solstice />
<FeatureCasestudySolstice />
</BaseLayout3>
