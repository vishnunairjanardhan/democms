---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import HeroCasestudyCariloha from "/src/components/heros/HeroCasestudyCariloha.astro";
import CasestudytestCariloha from "/src/components/testimonials/CasestudytestCariloha.astro";
import FeatureCasestudyCariloha from "/src/components/features/FeatureCasestudyCariloha.astro";
import Infocariloha from "/src/components/Infopages/Infocariloha.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
--->
<AstroSeo
  title="Cariloha Case Study: Over $300k Gift Card Sales | 99minds"
  description="Cariloha’s Social Media Gift Card Promotion Drives Customer Acquisition and Engagement"
  canonical="https://www.99minds.io/case-study/cariloha"
  openGraph={{
    url: "https://www.99minds.io/case-study/cariloha",
    title: "Cariloha Case Study: Over $300k Gift Card Sales | 99minds",
    description: "Cariloha’s Social Media Gift Card Promotion Drives Customer Acquisition and Engagement",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/cariloha-banner1.webp",
        alt: "Cariloha uses 99minds Gift Card & Loyalty Program",
        type: "image/jpeg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroCasestudyCariloha />
  <CasestudytestCariloha />
  <Infocariloha />
  <FeatureCasestudyCariloha />
</BaseLayout>
