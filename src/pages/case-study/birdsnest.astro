---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import HeroCasestudyBirdsnest from "/src/components/heros/HeroCasestudyBirdsnest.astro";
import CasestudytestBirdsnest from "/src/components/testimonials/CasestudytestBirdsnest.astro";
import FeatureCasestudyBirdsnest from "/src/components/features/FeatureCasestudyBirdsnest.astro";
import Birdsnest from "/src/components/Infopages/Birdsnest.astro";
import { Seo } from "../../config/Seo";
import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Birdsnest Case Study | 99minds"
  description="Check out how Birdsnest used 99minds to create a gift card program that integrates seamlessly with their physical and online store to boost their sales and customer experience."
  canonical="https://www.99minds.io/case-study/birdsnest"
  openGraph={{
    url: "https://www.99minds.io/case-study/birdsnest",
    title: "Birdsnest Case Study | 99minds",
    description: "Check out how Birdsnest used 99minds to create a gift card program that integrates seamlessly with their physical and online store to boost their sales and customer experience.",
    images: [
      {
        url: "https://www.99minds.io/assets/case-study/Birdnest-case-study.jpg",
        alt: "Birdsnest uses 99minds Gift Card",
        type: "image/jpeg",
      }
    ],
    site_name: "99minds",
  }}
  twitter={{
    site: "@99minds_io",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroCasestudyBirdsnest />
  <CasestudytestBirdsnest />
  
<Birdsnest />
<FeatureCasestudyBirdsnest />
</BaseLayout>
