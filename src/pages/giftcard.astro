---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroGiftcard from "../components/heros/HeroGiftcard.astro";
import LogoCloudOne from "../components/testimonials/LogoCloudOne.astro";
import FeatureSixGiftcard from "../components/features/FeatureSixGiftcard.astro";
import Testimonialtry from "../components/testimonials/Testimonialtry.astro";
import CtaThree99minds from "../components/ctas/CtaThree99minds.astro";
import Integrations99minds from "../components/integrations/Integrations99minds.astro";
import GiftCardTab from "../components/features/GiftCardTab.astro";

import { AstroSeo } from "@astrolib/seo";
---

<!---
Use AstroSeo in all the pages you want different Seo than the index page
-->
<AstroSeo
  title="Complete Gift Card Solution for All Businesses | 99minds"
  description="Discover the key features of our Gift Card Platform: 100's of beautiful themed cards, brand design uploads, customization and multi-channel delivery options."
  canonical="https://www.99minds.io"
  openGraph={{
    url: "https://www.99minds.io",
    title: "Complete Gift Card Solution for All Businesses | 99minds",
    description: "Discover the key features of our Gift Card Platform: 100's of beautiful themed cards, brand design uploads, customization and multi-channel delivery options.",
    images: [
      {
        url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg",
        width: 1200,
        height: 630,
        alt: "Social open graph",
        type: "image/jpeg",
      },
      {
        url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg",
        width: 4096,
        height: 4096,
        alt: "Twitter open graph",
        type: "image/jpeg",
      },
      { url: "https://www.lexingtonthemes.com/opengraph/social-og.jpg" },
      { url: "https://www.lexingtonthemes.com/opengraph/twitter-og.jpg" },
    ],
    site_name: "99minds",
  }}
  twitter={{
    handle: "@99minds_io",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<BaseLayout>
  <HeroGiftcard />
  <LogoCloudOne />
  <FeatureSixGiftcard />
  <GiftCardTab />
  <Testimonialtry />
  <Integrations99minds />
  <CtaThree99minds />
</BaseLayout>
