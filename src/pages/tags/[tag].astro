---
import BaseLayout3 from "../../layouts/BaseLayout3.astro";
import EntriesOne from "../../components/entries/EntriesOne.astro";
import { getCollection } from "astro:content";
import { AstroSeo } from "@astrolib/seo";

export async function getStaticPaths() {
  const slugify = (text) =>
    text
      .toLowerCase()
      .trim()
      .replace(/\s+/g, "-")
      .replace(/[^\w-]+/g, "");

  const allPosts = await getCollection("posts");

  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.data.tags).flat()),
  ];

  return uniqueTags.map((tag) => {
    const slug = slugify(tag);

    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .map((post) => ({
        slug: post.slug,
        data: {
          heading: post.data.heading,
          title: post.data.title,
          description: post.data.description,
          pubDate: post.data.pubDate,
          author: post.data.author,
          image: {
            url: post.data.image?.url ?? post.data.image,
          },
        },
      }));

    return {
      params: { tag: slug },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<BaseLayout3 pageTitle={tag}>
  <AstroSeo
    title={`99minds - Blogs about ${tag}`}
    description={`Read blogs about ${tag} on 99minds`}
    canonical={`https://www.99minds.io/tags/${tag}`}
    openGraph={{
      url: `https://www.99minds.io/tags/${tag}`,
      title: `Blogs about ${tag} | 99minds`,
      description: `Discover insights and updates about ${tag} on 99minds`,
      images: [
        {
          url: "/assets/99minds-logo1.svg",
          alt: "99minds Blog",
          type: "image/svg",
        },
      ],
      site_name: "99minds",
    }}
    twitter={{
      url: `https://www.99minds.io/tags/${tag}`,
      images: [
        {
          url: "/assets/99minds-logo1.svg",
          alt: "99minds Blog",
          type: "image/svg",
        },
      ],
      site: "@99minds_io",
      cardType: "summary_large_image",
    }}
  />

  <section>
    <div class="max-w-7xl px-8 md:px-12 lg:px-16 mx-auto py-32 lg:py-18 relative">
      <p class="mt-8 text-3xl text-center font-normal tracking-tighter text-black">
        Blogs about {tag}
      </p>

      <div class="py-24">
        <ol class="grid grid-cols-1 gap-8 lg:grid-cols-3 sm:grid-cols-1" role="list">
          {posts.map((post) => (
            <EntriesOne
              url={`/blog/${post.slug}`}
              title={post.data.heading}
              description={post.data.description}
              alt={post.data.title}
              pubDate={new Date(post.data.pubDate).toISOString().slice(0, 10)}
              author={post.data.author}
              image={post.data.image?.url}
            />
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout3>